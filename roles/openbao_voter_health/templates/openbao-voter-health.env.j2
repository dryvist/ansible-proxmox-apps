## {{ ansible_managed }}
## OpenBao voter-health EnvironmentFile — 0600, root-owned.
SPLUNK_HEC_URL="{{ splunk_hec_base_url }}/services/collector/event"
SPLUNK_HEC_TOKEN="{{ openbao_voter_health_splunk_hec_token }}"
SPLUNK_INDEX="{{ openbao_voter_health_splunk_index }}"
SPLUNK_SOURCETYPE="{{ openbao_voter_health_splunk_sourcetype }}"
OPENBAO_API_PORT="{{ tofu_data.constants.service_ports.openbao_api }}"
## Optional least-privilege AppRole creds for the authenticated raft-lag read.
## Empty until a follow-up provisions the `voter-health` AppRole (see README —
## no OpenBao policy/AppRole change ships in this role).
OPENBAO_VOTER_HEALTH_ROLE_ID="{{ openbao_voter_health_role_id }}"
OPENBAO_VOTER_HEALTH_SECRET_ID="{{ openbao_voter_health_secret_id }}"
