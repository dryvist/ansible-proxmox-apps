# {{ ansible_managed }}
[Unit]
Description=Reconcile the DNS zone apex to healthy Proxmox API nodes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=TECHNITIUM_DNS_ADMIN_USER={{ technitium_dns_admin_user }}
EnvironmentFile={{ technitium_dns_apex_health_check_env_file }}
ExecStart={{ technitium_dns_apex_health_check_script }}
# The script is deliberately non-zero on "could not authenticate" and on "every
# probe failed", so a persistent fault is visible in systemd rather than silent.
StandardOutput=journal
StandardError=journal
