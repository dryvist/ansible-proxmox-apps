{{ ansible_managed | comment }}
# Rendered from the shared catalog (dashboard_catalog_services). Kept in its OWN
# file, included by glance.yml, so hand-written pages and widgets there survive
# a re-render — a generated block inside the main config would overwrite them.
#
# Every link is the clean portless HTTPS URL, so each click passes through
# Traefik and its Authelia gate.
#
# LAYOUT:
#   split-column -> audience: UI (human-facing, svc.ui) beside API/machine
#                    endpoints. Glance's own page `columns:` looks like the
#                    obvious tool for this, but its multiple columns become
#                    swipeable TABS on mobile (one hidden until tapped) —
#                    the opposite of "UI first, then API below it" on a
#                    phone. `split-column` is Glance's side-by-side widget:
#                    side by side on desktop, a single stacked column in
#                    declared order on mobile — exactly UI-then-API either
#                    way. It only places two widgets deterministically when
#                    given exactly two, so each side is exactly ONE combined
#                    widget below, never one widget per VLAN group.
#   widget group  -> the service's VLAN-derived category, as a named group
#                     within that one combined widget.
#   link          -> the service, with its one-line description beside it.
#
# A service reaches this board by having a Traefik route. There is no exclude
# list: everything fronted is shown, and `ui` only decides which side.
{% macro audience_widget(services, monitor) %}
{#- Ordered categories first, then any that the order list does not name. -#}
{% set _groups = dashboard_catalog_group_order
     + (services | map(attribute='group') | unique
        | reject('in', dashboard_catalog_group_order) | sort | list) %}
{% if monitor %}
            - type: monitor
              cache: {{ glance_monitor_interval | default('1m') }}
              sites:
{% for group in _groups %}
{% for svc in services | selectattr('group', 'equalto', group) | list %}
                - title: "{{ group }} · {{ svc.title }}"
                  url: {{ svc.url }}
{% if svc.probe_url | length > 0 %}
                  # check-url is the GUEST address: this probe is unauthenticated,
                  # and against the gated URL every service would read as down.
                  check-url: {{ svc.probe_url }}
{% endif %}
{% endfor %}
{% endfor %}
{% else %}
            - type: bookmarks
              groups:
{% for group in _groups %}
{% set _in_group = services | selectattr('group', 'equalto', group) | list %}
{% if _in_group | length > 0 %}
{#- Sections cluster together first (e.g. one Hermes agent's routes), then
   the ungrouped remainder — same ordering as before, but flattened into one
   links list: split-column only nests two widgets deterministically, so a
   per-agent sub-heading is no longer a nested group. Each Hermes route's own
   `title` (locals-hermes-routes.tf) already names the agent and surface, so
   nothing here reads as ambiguous without the extra heading. -#}
{% set _ordered = (_in_group | selectattr('section') | sort(attribute='section') | list)
     + (_in_group | rejectattr('section') | list) %}
                - title: {{ group }}
                  links:
{% for svc in _ordered %}
                    - title: {{ svc.title }}
                      url: {{ svc.url }}
{% if svc.desc | length > 0 %}
                      description: {{ svc.desc }}
{% endif %}
{% endfor %}
{% endif %}
{% endfor %}
{% endif %}
{% endmacro %}
{% set _ui = dashboard_catalog_services | selectattr('ui') | list %}
{% set _api = dashboard_catalog_services | rejectattr('ui') | list %}
- name: Services
  columns:
    - size: full
      widgets:
        - type: split-column
          widgets:
{{ audience_widget(_ui, glance_monitor_enabled | bool) }}
{%- if _api | length > 0 %}
{{ audience_widget(_api, false) }}
{%- endif %}
{% if glance_llm_profile_enabled | bool %}
        # Glance v0.8.6 custom-api. Named extra requests are `subrequests`,
        # read in the template with `.Subrequest`. Environment references are
        # substituted config-wide, headers included, from the service
        # environment. That scan also reads comments, so no comment in this
        # file may spell one out: a reference to an unset name aborts startup.
        # https://github.com/glanceapp/glance/blob/v0.8.6/docs/configuration.md#custom-api
        # Inside `range` the context is the array element (`.String`, not
        # `.JSON.String`); `$` reaches the top level. Glance hands a non-2xx
        # response with a JSON body to the template as data, so the template
        # checks `.Response.StatusCode` itself:
        # https://github.com/glanceapp/glance/blob/v0.8.6/docs/custom-api.md
        #
        # LiteLLM /health lists each deployment flat (`model`, `model_id`, ...)
        # and carries no `model_info`; the profile label lives in the
        # deployment's `model_info`, which /v2/model/info (real deployments
        # https://docs.litellm.ai/docs/proxy/health
        # https://docs.litellm.ai/docs/proxy/model_management
        - type: custom-api
          title: LLM profile
          cache: 1m
          url: "{{ glance_llm_profile_router_base_url }}/health"
          headers:
            Authorization: "Bearer ${GLANCE_LLM_PROFILE_BEARER_TOKEN}"
          subrequests:
            model_info:
              url: "{{ glance_llm_profile_router_base_url }}/v2/model/info?page=1&size=100"
              headers:
                Authorization: "Bearer ${GLANCE_LLM_PROFILE_BEARER_TOKEN}"
          template: |
            {% raw %}
            {{ $info := .Subrequest "model_info" }}
            {{ $shown := false }}
            <div class="flex flex-column gap-5">
              {{ if or (ne .Response.StatusCode 200) (ne $info.Response.StatusCode 200) }}
                <p class="color-negative">Router error: health HTTP {{ .Response.StatusCode }}, models HTTP {{ $info.Response.StatusCode }}</p>
              {{ else }}
                {{ range .JSON.Array "healthy_endpoints" }}
                  {{ $id := .String "model_id" }}
                  {{ range $info.JSON.Array "data" }}
                    {{ $profile := .String "model_info.profile" }}
                    {{ if and $id $profile (eq (.String "model_info.id") $id) }}
                      {{ $shown = true }}
                      <div class="flex justify-between">
                        <span class="size-h4 color-primary">{{ $profile }}</span>
                        <span class="size-h6 color-subtle">{{ .String "model_name" }}</span>
                      </div>
                    {{ end }}
                  {{ end }}
                {{ end }}
                {{ if not $shown }}
                  <p class="color-subtle">No healthy profile reported</p>
                {{ end }}
              {{ end }}
            </div>
            {% endraw %}
{% endif %}
