{{ ansible_managed | comment }}
# Top-level Glance config. The generated service pages live in their own
# included file so a re-render cannot clobber anything hand-written here.
#
# NOTE: `pages` must not appear in an included page file as well as here —
# upstream reports that as "cannot unmarshal !!map into []glance.page".
server:
  host: {{ glance_host }}
  port: {{ glance_port }}

branding:
  hide-footer: true

theme:
  background-color: "{{ glance_theme_background_color }}"
  primary-color: "{{ glance_theme_primary_color }}"
  positive-color: "{{ glance_theme_positive_color }}"
  negative-color: "{{ glance_theme_negative_color }}"
  contrast-multiplier: {{ glance_theme_contrast_multiplier }}

pages:
  $include: generated-services.yml
