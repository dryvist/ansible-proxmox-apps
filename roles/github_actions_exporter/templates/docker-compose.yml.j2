---
services:
  github-actions-runner-exporter:
    image: "{{ github_actions_exporter_image }}"
    container_name: "{{ github_actions_exporter_container_name }}"
    restart: unless-stopped
    ports:
      - "{{ github_actions_exporter_port }}:{{ github_actions_exporter_port }}"
    env_file:
      - "{{ github_actions_exporter_data_dir }}/exporter.env"
