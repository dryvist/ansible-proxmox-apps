{{ ansible_managed | comment }}
# Instantiated by OnFailure=ntfy-unit-failure@%n.service on any unit that opts
# in (see ntfy_unit_failure_services). %n on the OnFailure= line already
# expands to the failing unit's full name, so this template's own %i IS that
# name -- no separate argument passing needed.
[Unit]
Description=ntfy failure alert for %i
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl -fsS --max-time 8 \
    -H "Title: unit failed: %i" \
    -H "Priority: {{ ntfy_unit_failure_priority }}" \
    -H "Tags: {{ ntfy_unit_failure_tags }}" \
    -d "%i entered a failed state on %H" \
    "{{ ntfy_unit_failure_ntfy_url }}"
