{% if syslog_forwarder_limit_nofile | default(false) %}
# {{ ansible_managed }}
# imfile holds one open descriptor for every file a wildcard input matches,
# and a wildcard over files that are written once and never appended (runner
# _diag logs) accumulates them until the unit's default open-file cap stops
# rsyslogd from opening new ones. Rendered only where
# syslog_forwarder_limit_nofile is set — unset, this drop-in deploys nowhere.
[Service]
LimitNOFILE={{ syslog_forwarder_limit_nofile }}
{% endif %}
