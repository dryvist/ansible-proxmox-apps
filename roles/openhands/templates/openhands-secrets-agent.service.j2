{{ ansible_managed | comment }}
# Renders the launcher's two key files from the OpenHands KV path and keeps them
# current. The launcher unit loads those files as credentials and is ordered
# after this unit, so the files exist before the launcher starts.

[Unit]
Description=OpenBao Agent rendering OpenHands launcher keys
Before=openhands-canvas.service
# It talks to OpenBao before it can render anything, so routing must be up.
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart={{ openhands_store_bin }} agent -config={{ openhands_store_config }}
# An OpenBao outage, an expired secret_id, or a revoked AppRole all land here.
# Keep retrying: the launcher cannot start without these files.
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
