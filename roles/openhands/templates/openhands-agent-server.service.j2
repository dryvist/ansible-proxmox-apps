{{ ansible_managed | comment }}
[Unit]
Description=OpenHands agent server
{{ lookup('ansible.builtin.template', _service_common_template) }}
{% if openhands_service_enabled | bool %}
LoadCredential=openhands-router-key:{{ openhands_router_key_file }}
{% endif %}
Environment=OH_CONVERSATION_RUNTIME=docker
Environment=OH_CONVERSATION_CONTAINER_MEMORY={{ openhands_conversation_memory_limit }}
Environment=OH_CONVERSATION_CONTAINER_CPUS={{ openhands_conversation_cpus }}
Environment=OH_CONVERSATION_CONTAINER_PIDS_LIMIT={{ openhands_conversation_pids_limit }}
ExecStart=/bin/sh -ec 'test -s "$$CREDENTIALS_DIRECTORY/openhands-router-key"; export LLM_API_KEY="$$(cat "$$CREDENTIALS_DIRECTORY/openhands-router-key")"; exec {{ openhands_services_venv }}/bin/agent-server --host 127.0.0.1 --port {{ openhands_agent_server_port }}'

[Install]
WantedBy=multi-user.target
