{{ ansible_managed | comment }}
[Unit]
Description=OpenHands agent server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ openhands_user }}
Group={{ openhands_user }}
WorkingDirectory={{ openhands_state_dir }}
Environment=HOME={{ openhands_state_dir }}
Environment=PATH={{ openhands_services_venv }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
{% if openhands_service_enabled | bool %}
EnvironmentFile={{ openhands_service_env_file }}
{% endif %}
Environment=OH_CONVERSATION_RUNTIME=docker
Environment=OH_CONVERSATION_CONTAINER_MEMORY={{ openhands_conversation_memory_limit }}
Environment=OH_CONVERSATION_CONTAINER_CPUS={{ openhands_conversation_cpus }}
Environment=OH_CONVERSATION_CONTAINER_PIDS_LIMIT={{ openhands_conversation_pids_limit }}
ExecStart={{ openhands_services_venv }}/bin/agent-server --host 127.0.0.1 --port {{ openhands_agent_server_port }}
Restart=on-failure
RestartSec=5
{{ lookup('ansible.builtin.file', _service_hardening_template) }}
ReadWritePaths={{ openhands_state_dir }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
