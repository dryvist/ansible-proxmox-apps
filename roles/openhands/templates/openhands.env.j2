{{ ansible_managed | comment }}
# The agent server's session key and persistence secret; the automation
# authenticates to the same agent server with the same session key.
OH_SESSION_API_KEYS_0={{ openhands_service_secrets['session-api-key'] }}
OH_SECRET_KEY={{ openhands_service_secrets['secret-key'] }}
# Local agent-server mode: every automation run dispatches to the agent
# server on this host instead of a cloud sandbox.
AUTOMATION_AGENT_SERVER_URL=http://127.0.0.1:{{ openhands_agent_server_port }}
AUTOMATION_AGENT_SERVER_API_KEY={{ openhands_service_secrets['session-api-key'] }}
AUTOMATION_DB_URL=sqlite+aiosqlite:///{{ openhands_automation_db_path }}
AUTOMATION_WORKSPACE_BASE={{ openhands_automation_workspace_base }}
AUTOMATION_KV_SECRET={{ openhands_service_secrets['automation-kv-secret'] }}
AUTOMATION_LOCAL_API_KEY={{ openhands_service_secrets['automation-local-api-key'] }}
# The agents' LLM: the LiteLLM router's OpenAI-compatible endpoint, read via
# LLM.load_from_env by the SDK.
LLM_MODEL={{ openhands_router_model }}
LLM_BASE_URL={{ openhands_router_base_url }}
LLM_API_KEY={{ openhands_router_key }}
