{{ ansible_managed | comment }}
# OpenBao Agent for the OpenHands launcher's two keys. One per host: it holds a
# single AppRole session and renders both key files from one KV path.
#
# Each template renders with error_on_missing_key, so a missing field fails the
# render instead of writing an empty key. A render that changes a file runs its
# command: try-restart restarts the launcher only while it is running, and the
# launcher reads its keys once, at start.
exit_after_auth = false

vault {
  address = "{{ openhands_store_addr }}"
}

auto_auth {
  method "approle" {
    config = {
      role_id_file_path   = "{{ openhands_approle_dir }}/role_id"
      secret_id_file_path = "{{ openhands_approle_dir }}/secret_id"
      # Ansible re-delivers the secret_id only on a converge, so the agent must
      # not consume the file it will need again after a restart.
      remove_secret_id_file_after_reading = false
    }
  }
}

{% raw %}
template {
  contents             = "{{ with secret \"{% endraw %}{{ openhands_kv_path }}{% raw %}\" }}{{ .Data.data.openhands_backend_api_key }}{{ end }}"
{% endraw %}
  destination          = "{{ openhands_backend_key_file }}"
  perms                = "0600"
  error_on_missing_key = true
  command              = "/usr/bin/systemctl try-restart openhands-canvas.service"
}

{% raw %}
template {
  contents             = "{{ with secret \"{% endraw %}{{ openhands_kv_path }}{% raw %}\" }}{{ .Data.data.openhands_llm_router_key }}{{ end }}"
{% endraw %}
  destination          = "{{ openhands_router_key_file }}"
  perms                = "0600"
  error_on_missing_key = true
  command              = "/usr/bin/systemctl try-restart openhands-canvas.service"
}
