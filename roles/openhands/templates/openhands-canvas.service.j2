{{ ansible_managed | comment }}
[Unit]
Description=OpenHands Agent Canvas
{{ lookup('ansible.builtin.template', _service_common_template) }}
{% if openhands_service_enabled | bool %}
LoadCredential=openhands-backend-key:{{ openhands_backend_key_file }}
LoadCredential=openhands-secret-key:{{ openhands_secrets_dir }}/secret-key
LoadCredential=openhands-automation-kv-secret:{{ openhands_secrets_dir }}/automation-kv-secret
{% endif %}
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Environment=OH_CONVERSATION_RUNTIME=docker
Environment=OH_CONVERSATION_CONTAINER_MEMORY={{ openhands_conversation_memory_limit }}
Environment=OH_CONVERSATION_CONTAINER_CPUS={{ openhands_conversation_cpus }}
Environment=OH_CONVERSATION_CONTAINER_PIDS_LIMIT={{ openhands_conversation_pids_limit }}
ExecStart=/bin/sh -ec 'test -s "$$CREDENTIALS_DIRECTORY/openhands-backend-key"; test -s "$$CREDENTIALS_DIRECTORY/openhands-secret-key"; test -s "$$CREDENTIALS_DIRECTORY/openhands-automation-kv-secret"; export LOCAL_BACKEND_API_KEY="$$(cat "$$CREDENTIALS_DIRECTORY/openhands-backend-key")" OH_SECRET_KEY="$$(cat "$$CREDENTIALS_DIRECTORY/openhands-secret-key")" AUTOMATION_KV_SECRET="$$(cat "$$CREDENTIALS_DIRECTORY/openhands-automation-kv-secret")"; exec {{ openhands_node_dir }}/bin/node {{ openhands_canvas_dir }}/bin/agent-canvas --public --port {{ openhands_canvas_port }}'

[Install]
WantedBy=multi-user.target
