{{ ansible_managed | comment }}
[Unit]
Description=OpenHands automation service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ openhands_user }}
Group={{ openhands_user }}
WorkingDirectory={{ openhands_state_dir }}
Environment=HOME={{ openhands_state_dir }}
Environment=PATH={{ openhands_services_venv }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
{% if openhands_service_enabled | bool %}
EnvironmentFile={{ openhands_service_env_file }}
{% endif %}
ExecStart={{ openhands_services_venv }}/bin/uvicorn openhands.automation.app:app --host 127.0.0.1 --port {{ openhands_automation_port }}
Restart=on-failure
RestartSec=5
{{ lookup('ansible.builtin.file', _service_hardening_template) }}
ReadWritePaths={{ openhands_state_dir }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
