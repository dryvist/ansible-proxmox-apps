{{ ansible_managed | comment }}
# Homebox runtime configuration, read by systemd (EnvironmentFile) before the
# service drops privileges. Each name follows the upstream convention: the
# HBOX_ prefix, then the Go config struct path in upper snake case.
HBOX_MODE=production
HBOX_WEB_PORT={{ homebox_port }}
HBOX_WEB_MAX_UPLOAD_SIZE={{ homebox_web_max_upload_size }}
HBOX_STORAGE_CONN_STRING=file://{{ homebox_data_dir }}
HBOX_DATABASE_DRIVER={{ homebox_database_driver }}
{% if homebox_database_driver == 'postgres' %}
HBOX_DATABASE_HOST={{ homebox_db_host }}
HBOX_DATABASE_PORT={{ homebox_db_port }}
HBOX_DATABASE_USERNAME={{ homebox_db_user }}
HBOX_DATABASE_PASSWORD={{ homebox_db_password }}
HBOX_DATABASE_DATABASE={{ homebox_db_name }}
HBOX_DATABASE_SSL_MODE={{ homebox_db_ssl_mode }}
{% else %}
HBOX_DATABASE_SQLITE_PATH={{ homebox_sqlite_path }}
{% endif %}
# Behind the Traefik ingress: honour X-Forwarded-* from the proxy.
HBOX_OPTIONS_TRUST_PROXY=true
HBOX_OPTIONS_ALLOW_REGISTRATION={{ homebox_options_allow_registration | bool | ternary('true', 'false') }}
HBOX_OPTIONS_ALLOW_ANALYTICS=false
HBOX_OPTIONS_GITHUB_RELEASE_CHECK=false
