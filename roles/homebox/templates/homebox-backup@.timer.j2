{{ ansible_managed | comment }}
# Daily backup to the %i repository. The randomized delay spreads the load and
# keeps the two repositories from starting in the same second.
[Unit]
Description=Daily Homebox backup to the %i repository

[Timer]
OnCalendar={{ homebox_backup_on_calendar }}
RandomizedDelaySec={{ homebox_randomized_delay_sec }}
Persistent=true

[Install]
WantedBy=timers.target
