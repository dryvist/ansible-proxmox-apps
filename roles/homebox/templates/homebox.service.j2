{{ ansible_managed | comment }}
# Native single-binary install. Configuration comes entirely from the
# environment: the upstream loader reads HBOX_* variables, so there is no
# config file and no --config flag.
[Unit]
Description=Homebox home inventory
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ homebox_user }}
Group={{ homebox_system_group }}
WorkingDirectory={{ homebox_install_dir }}
EnvironmentFile={{ homebox_env_file }}
ExecStart={{ homebox_binary_path }}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
