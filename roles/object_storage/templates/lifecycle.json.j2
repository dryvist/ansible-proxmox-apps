{
  "Rules": [
    {
      "ID": "expire-noncurrent",
      "Status": "Enabled",
      "Filter": {"Prefix": ""},
      "NoncurrentVersionExpiration": {"NoncurrentDays": {{ item.noncurrent_expiration_days | default(object_storage_noncurrent_expiration_days) }}}{% if item.expire_delete_markers | default(false) %},
      "Expiration": {"ExpiredObjectDeleteMarker": true}{% endif %}

    }{% for _rule in item.prefix_lifecycle_rules | default([]) %},
    {
      "ID": "expire-noncurrent-{{ _rule.prefix | replace("/", "-") | trim("-") }}",
      "Status": "Enabled",
      "Filter": {"Prefix": "{{ _rule.prefix }}"},
      "NoncurrentVersionExpiration": {"NoncurrentDays": {{ _rule.noncurrent_expiration_days }}}{% if _rule.expire_delete_markers | default(false) %},
      "Expiration": {"ExpiredObjectDeleteMarker": true}{% endif %}

    }{# +% keeps the newline Ansible's trim_blocks would otherwise eat #}{% endfor +%}
  ]
}
