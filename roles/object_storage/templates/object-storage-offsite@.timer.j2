{# One instance per bucket; %i is the local bucket name. #}
[Unit]
Description=Scheduled offsite copy of object-storage bucket %i

[Timer]
OnCalendar={{ object_storage_offsite_schedule }}
# Spread the buckets so they do not all contend for the uplink at once.
RandomizedDelaySec={{ object_storage_offsite_splay }}
# Run on next boot if the scheduled time was missed while the guest was down —
# without this, a guest that is off at the scheduled hour simply skips a day.
Persistent=true
Unit={{ object_storage_offsite_unit }}@%i.service

[Install]
WantedBy=timers.target
