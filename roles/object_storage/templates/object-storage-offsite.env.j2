{# Offsite copy settings for one bucket. Rendered 0600, root-only. #}
# {{ ansible_managed }}
# Offsite copy credentials for a single bucket. rclone is configured entirely
# through env vars so no credential is ever written to an rclone config file.
RCLONE_CONFIG_SRC_TYPE=s3
RCLONE_CONFIG_SRC_PROVIDER=Other
RCLONE_CONFIG_SRC_ENDPOINT={{ object_storage_endpoint }}
RCLONE_CONFIG_SRC_REGION={{ object_storage_region }}
RCLONE_CONFIG_SRC_ACCESS_KEY_ID={{ object_storage_root_user }}
RCLONE_CONFIG_SRC_SECRET_ACCESS_KEY={{ object_storage_root_password }}
RCLONE_CONFIG_DST_TYPE=s3
RCLONE_CONFIG_DST_PROVIDER=Other
RCLONE_CONFIG_DST_ENDPOINT={{ offsite_secret[object_storage_offsite_endpoint_field] }}
{# Offsite S3 endpoints commonly encode their region in the hostname. Deriving
   it keeps one source of truth; restating it in a second field lets the two
   disagree, and a mismatch surfaces only as an opaque signature failure.
   The backreference is written `\\1`, and must stay that way. In a template
   FILE (unlike the same expression written inline in YAML, where the bare
   form is the correct one) a lone `\1` is unescaped before the regex sees it
   and arrives as a 0x01 control byte, so the region renders as garbage and
   every request fails an opaque signature check. Verified both ways; the
   test asserts it. #}
RCLONE_CONFIG_DST_REGION={{ offsite_secret[object_storage_offsite_endpoint_field]
  | regex_replace('^https?://', '')
  | regex_replace('^s3\\.([^.]+)\\..*$', '\\1') }}
RCLONE_CONFIG_DST_ACCESS_KEY_ID={{ offsite_secret[object_storage_offsite_key_id_field] }}
RCLONE_CONFIG_DST_SECRET_ACCESS_KEY={{ offsite_secret[object_storage_offsite_app_key_field] }}
OFFSITE_SRC_BUCKET={{ offsite_bucket }}
OFFSITE_DST_BUCKET={{ offsite_secret[object_storage_offsite_bucket_field] }}
{# Empty => the success ping is skipped and a missed run raises nothing. #}
OFFSITE_HEALTHCHECK_URL={{ object_storage_offsite_healthcheck_urls[offsite_bucket] | default('') }}
