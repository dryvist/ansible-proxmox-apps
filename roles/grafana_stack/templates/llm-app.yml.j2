---
apiVersion: 1

apps:
  - type: grafana-llm-app
    disabled: false
    jsonData:
      provider: openai
      openAI:
        url: "{{ grafana_stack_llm_router_url }}"
        apiPath: /v1
      models:
        default: base
        mapping:
          base: small
          large: medium
    secureJsonData:
      openAIKey: $GRAFANA_LLM_ROUTER_API_KEY
