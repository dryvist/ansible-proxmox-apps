## Managed by Ansible (grafana_stack role) — do not edit by hand.
apiVersion: 1
datasources:
  - name: VictoriaMetrics
    uid: victoriametrics
    type: prometheus
    access: proxy
    url: "http://127.0.0.1:{{ grafana_stack_vm_port }}"
    # NOT default — see the Prometheus entry below. Every dashboard that queries
    # this one pins `"uid": "victoriametrics"` explicitly (verified across all
    # five vendored claude-*.json), so none of them depends on being default.
    isDefault: {{ 'false' if (grafana_stack_prometheus_url | trim | length > 0) else 'true' }}
    editable: false
{% if grafana_stack_prometheus_url | trim | length > 0 %}
  # Infrastructure metrics (node_exporter, blackbox, traefik) — a different
  # guest and a different retention from the VictoriaMetrics default above.
  # Community dashboards imported by grafana.com ID query THIS datasource.
  - name: Prometheus
    uid: prometheus
    type: prometheus
    access: proxy
    url: "{{ grafana_stack_prometheus_url | trim }}"
    # Default on purpose. Community dashboards vary in how they name their
    # datasource: some carry a `${DS_*}` placeholder (substituted at deploy),
    # but others — Node Exporter Full among them — instead declare a
    # datasource-type template variable with an EMPTY `current`, which Grafana
    # resolves to whichever datasource is default. Left as VictoriaMetrics,
    # those dashboards import cleanly and render nothing, because the infra
    # metrics they query live here instead.
    isDefault: true
    editable: false
{% endif %}
{% if grafana_stack_litellm_prices_enabled | bool %}
  - name: LiteLLM prices
    uid: litellm-prices
    type: yesoreyeram-infinity-datasource
    access: proxy
    url: "{{ grafana_stack_litellm_prices_allowed_host }}"
    isDefault: false
    jsonData:
      allowedHosts:
        - "{{ grafana_stack_litellm_prices_allowed_host }}"
      allowDangerousHTTPMethods: false
    editable: false
{% endif %}
