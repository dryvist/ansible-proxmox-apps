## Managed by Ansible (grafana_stack role) — do not edit by hand.
## One read-only client: one bearer token, one instant-query route to
## VictoriaMetrics. Holds a bearer token: rendered 0600 with no_log by
## tasks/deploy.yml.
users:
  - bearer_token: {{ grafana_stack_vmauth_quota_token | to_json }}
    url_map:
      - src_paths:
          - "/api/v1/query"
        src_query_args:
          - 'query={{ grafana_stack_vmauth_quota_expr }}'
        url_prefix: "http://127.0.0.1:{{ grafana_stack_vm_port }}/"
