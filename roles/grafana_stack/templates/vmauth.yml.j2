## Managed by Ansible (grafana_stack role) — do not edit by hand.
## Two clients. The reader holds one bearer token and runs one instant query.
## The writer holds one bearer token and may import to one path only; its
## url_prefix adds a fixed writer label to every imported series.
## Holds bearer tokens: rendered 0600 with no_log by tasks/deploy.yml.
users:
  - bearer_token: {{ grafana_stack_vmauth_quota_token | to_json }}
    url_map:
      - src_paths:
          - "/api/v1/query"
        src_query_args:
          - 'query={{ grafana_stack_vmauth_quota_expr }}'
        url_prefix: "http://127.0.0.1:{{ grafana_stack_vm_port }}/"
  - bearer_token: {{ grafana_stack_vmauth_write_token | to_json }}
    url_map:
      - src_paths:
          - "/api/v1/import/prometheus"
        url_prefix: "http://127.0.0.1:{{ grafana_stack_vm_port }}/?extra_label=writer={{ grafana_stack_vmauth_writer_label }}"
