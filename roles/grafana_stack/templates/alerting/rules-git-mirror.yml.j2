## Managed by Ansible (grafana_stack role) — do not edit by hand.
## Grafana unified-alerting file provisioning: Git mirror sync health.
---
apiVersion: 1

groups:
{% if grafana_stack_prometheus_url | trim | length > 0 and groups.get('git_mirror_group', []) | length > 0 %}
  - orgId: 1
    name: git-mirror-sync
    folder: {{ grafana_stack_alert_folder }}
    interval: {{ grafana_stack_alert_eval_interval }}
    rules:
      - uid: git-mirror-sync-stale
        title: Git mirror sync stale
        condition: B
        data:
          - refId: A
            relativeTimeRange: {from: 300, to: 0}
            datasourceUid: prometheus
            model:
              expr: (time() - git_mirror_sync_last_success_timestamp_seconds) > bool {{ grafana_stack_alert_git_mirror_max_age_seconds }}
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [0]}
              refId: B
        for: 15m
        noDataState: Alerting
        execErrState: Error
        labels: {severity: warning}
        annotations:
          summary: "The last successful Git mirror sync was more than {{ (grafana_stack_alert_git_mirror_max_age_seconds / 3600) | round(1) }} hours ago."

      - uid: git-mirror-sync-failed
        title: Git mirror sync failed
        condition: B
        data:
          - refId: A
            relativeTimeRange: {from: 300, to: 0}
            datasourceUid: prometheus
            model:
              expr: git_mirror_sync_success == bool 0
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [0]}
              refId: B
        for: 15m
        noDataState: Alerting
        execErrState: Error
        labels: {severity: warning}
        annotations:
          summary: "The Git mirror sync has reported failure for 15 minutes."
{% endif %}
