## Managed by Ansible (grafana_stack role) — do not edit by hand.
## Grafana unified-alerting file provisioning: operator workstation load.
## The native node exporter route adds `host_role=workstation` to this metric.
---
apiVersion: 1

groups:
  - orgId: 1
    name: workstation-observability
    folder: {{ grafana_stack_alert_folder }}
    interval: {{ grafana_stack_alert_eval_interval }}
    rules:
      - uid: workstation-load5-high
        title: Operator workstation load high
        condition: B
        data:
          - refId: A
            relativeTimeRange: {from: 900, to: 0}
            datasourceUid: victoriametrics
            model:
              expr: node_load5{host_role="workstation"}
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [{{ grafana_stack_alert_workstation_load5 }}]}
              refId: B
        for: 10m
        noDataState: OK
        execErrState: Alerting
        labels: {severity: warning}
        annotations:
          summary: "Operator workstation 5-minute load exceeded {{ grafana_stack_alert_workstation_load5 }} for 10m."
