## Managed by Ansible (grafana_stack role) — do not edit by hand.
## Grafana unified-alerting file provisioning: AI router, judge, Hermes and
## zero-data-retention rules.
## https://grafana.com/docs/grafana/latest/alerting/set-up/provision-alerting-resources/file-provisioning/
##
## llm-router-down reads `up` from the "prometheus" datasource, so it renders
## only when that datasource is provisioned. The other rules read the router's
## litellm_* series from "victoriametrics", which this role always provisions.
##
## The zdr-key-non-zdr-model matchers are backtick strings: regex_escape emits `\-`,
## which a double-quoted PromQL string rejects as an invalid escape.
{% set _zdr_keys = grafana_stack_alert_zdr_only_keys | map('regex_escape') | join('|') %}
{% set _zdr_false = grafana_stack_alert_zdr_false_models | map('regex_escape') | join('|') %}
apiVersion: 1

groups:
  - orgId: 1
    name: ai-observability
    folder: {{ grafana_stack_alert_folder }}
    interval: {{ grafana_stack_alert_eval_interval }}
    rules:
{% if grafana_stack_prometheus_url | trim | length > 0 %}
      - uid: llm-router-down
        title: LLM router down
        condition: B
        data:
          - refId: A
            relativeTimeRange: {from: 300, to: 0}
            datasourceUid: prometheus
            model:
              expr: sum(up{job="llm_router"}) or on() vector(0)
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: lt, params: [1]}
              refId: B
        for: 3m
        noDataState: Alerting
        execErrState: Error
        labels: {severity: critical}
        annotations:
          summary: "No llm_router scrape target is up."

{% endif %}
      - uid: llm-judge-failing
        title: LLM judge down
        condition: B
        data:
          - refId: A
            relativeTimeRange: {from: 300, to: 0}
            datasourceUid: victoriametrics
            model:
              expr: >-
                absent_over_time(judge_process_start_time_seconds{telemetry_role="judge",process_set="judge"}[5m])
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [0.5]}
              refId: B
        for: 1m
        noDataState: OK
        execErrState: Error
        labels: {severity: warning}
        annotations:
          summary: "The judge process has not reported from Cribl Edge for 6 minutes."

      - uid: hermes-llm-failures
        title: Hermes LLM requests failing
        condition: B
        data:
          - refId: A
            relativeTimeRange: {from: 900, to: 0}
            datasourceUid: victoriametrics
            model:
              expr: >-
                sum by (api_key_alias) (increase(litellm_proxy_failed_requests_metric_total{api_key_alias=~"{{ grafana_stack_alert_hermes_key_regex }}",exception_status=~"5.."}[15m]))
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [{{ grafana_stack_alert_hermes_error_count - 1 }}]}
              refId: B
        for: 0s
        noDataState: OK
        execErrState: Error
        labels: {severity: warning}
        annotations:
          summary: "Hermes key {{ '{{' }} $labels.api_key_alias {{ '}}' }} had {{ '{{' }} $values.A.Value {{ '}}' }} server errors in 15m."

      - uid: hermes-cron-no-success
        title: Hermes cron job failing without success
        condition: B
        data:
          - refId: A
            relativeTimeRange: {from: 21600, to: 0}
            datasourceUid: victoriametrics
            model:
              expr: >-
                (
                  sum by (agent, job) (
                    increase(hermes_cron_runs_total{outcome="failed"}[6h])
                  ) > 0
                )
                unless on (agent, job)
                (
                  sum by (agent, job) (
                    label_replace(
                      increase(hermes_cron_runs_total{outcome=~"delivered|silent",job=~"[0-9a-f]{12}"}[6h])
                      * on (agent, job) group_left (job_name)
                        label_replace(
                          (max_over_time(hermes_cron_job_info[30d]) > bool 0),
                          "job", "$1", "job_id", "(.+)"
                        ),
                      "job", "$1", "job_name", "(.+)"
                    )
                    or increase(hermes_cron_runs_total{outcome=~"delivered|silent",job!~"[0-9a-f]{12}"}[6h])
                  ) > 0
                )
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [0.5]}
              refId: B
        for: 0s
        noDataState: OK
        execErrState: Error
        labels: {severity: warning}
        annotations:
          summary: >-
            Hermes cron job {{ '{{' }} $labels.job {{ '}}' }} on {{ '{{' }} $labels.agent {{ '}}' }}
            has failed without a delivered or silent run in 6 hours.
          description: >-
            {{ '{{' }} $values.A.Value {{ '}}' }} failed run(s) occurred for this agent/job pair,
            with no delivered or silent run during the same 6-hour window.

      - uid: zdr-key-non-zdr-model
        title: ZDR-only key reached a non-ZDR model
        condition: B
        data:
          - refId: A
            relativeTimeRange: {from: 600, to: 0}
            datasourceUid: victoriametrics
            model:
              expr: >-
                sum by (api_key_alias, requested_model) (
                  increase(litellm_proxy_total_requests_metric_total{
                    api_key_alias!="",
                    api_key_alias=~`{{ _zdr_keys }}`,
                    requested_model!="",
                    requested_model=~`{{ _zdr_false }}`
                  }[10m])
                )
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gt, params: [0]}
              refId: B
        for: 0s
        noDataState: OK
        execErrState: Error
        labels: {severity: critical}
        annotations:
          summary: "Key {{ '{{' }} $labels.api_key_alias {{ '}}' }} sent requests to {{ '{{' }} $labels.requested_model {{ '}}' }}, which has no zero data retention."
