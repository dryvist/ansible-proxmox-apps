## Managed by Ansible (grafana_stack role) — do not edit by hand.
## Grafana unified-alerting file provisioning: contact points.
## https://grafana.com/docs/grafana/latest/alerting/set-up/provision-alerting-resources/file-provisioning/
##
## Grafana posts its alert envelope to Cribl Stream's HEC raw endpoint.
## Stream stores the full event in Splunk and sends a compact summary through
## the existing ntfy hub for Slack and Zammad fan-out. The HEC credential is
## provisioned from a root-readable env file. File provisioning has no
## secureSettings key; Grafana moves the secret field out of settings into its
## encrypted store.
apiVersion: 1

contactPoints:
  - orgId: 1
    name: {{ grafana_stack_alert_contact_point_name }}
    receivers:
      - uid: {{ grafana_stack_alert_contact_point_name }}
        type: webhook
        settings:
          url: "{{ grafana_stack_alert_cribl_hec_url }}"
          httpMethod: POST
          authorization_scheme: Splunk
          authorization_credentials: "$GRAFANA_ALERT_CRIBL_HEC_TOKEN"
