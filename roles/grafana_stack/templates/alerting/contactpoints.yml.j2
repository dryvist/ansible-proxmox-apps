## Managed by Ansible (grafana_stack role) — do not edit by hand.
## A compact JSON message at the ntfy topic endpoint; no full alert envelope.
apiVersion: 1

contactPoints:
  - orgId: 1
    name: {{ grafana_stack_alert_contact_point_name }}
    receivers:
      - uid: {{ grafana_stack_alert_contact_point_name }}
        type: webhook
        settings:
          url: >-
            {{ grafana_stack_alert_ntfy_url }}?title=Grafana+alert&priority=default&tags=grafana
          httpMethod: POST
          customPayload:
            template: |-
              {% raw %}{{- $entity := "" -}}
              {{- $host := or .CommonLabels.host .CommonLabels.instance -}}
              {{- if $host -}}
                {{- $entity = printf "%.100s" (printf "%s/%s/%s" $host (or .CommonLabels.job "") (or .CommonLabels.stream "")) -}}
              {{- end -}}
              {{- $severity := "warning" -}}
              {{- if eq .CommonLabels.severity "info" -}}{{- $severity = "info" -}}{{- end -}}
              {{- if eq .CommonLabels.severity "critical" -}}{{- $severity = "critical" -}}{{- end -}}
              {{- $details := printf "%s/alerting/list" .ExternalURL -}}
              {{- if gt (len $details) 160 -}}{{- $details = "" -}}{{- end -}}
              {{- coll.Dict
                "source" "grafana"
                "rule" (printf "%.80s" .CommonLabels.alertname)
                "entity" $entity
                "status" .Status
                "severity" $severity
                "impact" "service"
                "summary" (printf "%.220s" (or .CommonAnnotations.summary .CommonLabels.alertname))
                "details_url" $details
                "alert_count" (len .Alerts)
                | data.ToJSON -}}{% endraw %}
