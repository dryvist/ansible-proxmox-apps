## Managed by Ansible (grafana_stack role) — do not edit by hand.
## Grafana unified-alerting file provisioning: secret-age alert rule.
## https://grafana.com/docs/grafana/latest/alerting/set-up/provision-alerting-resources/file-provisioning/
##
## Split out of rules.yml.j2 to keep that file under its token budget
## (.token-limits.yaml). Like rules.yml.j2, this rule queries the
## "prometheus" datasource, so this whole file renders with zero groups
## unless a prometheus-tagged container exists
## (grafana_stack_prometheus_url).
##
## DORMANT (see role README / PR evidence for detail): secret_age_days is a
## future node_exporter textfile-collector metric from the secret-age
## auditor, a package not yet in develop. Same noDataState: OK reasoning
## as the other rules — no metric, no alert, no silence broken.
apiVersion: 1

groups:
{% if grafana_stack_prometheus_url | trim | length > 0 %}
  - orgId: 1
    name: {{ grafana_stack_alert_folder }}
    folder: {{ grafana_stack_alert_folder }}
    interval: {{ grafana_stack_alert_eval_interval }}
    rules:
      # DORMANT — see file header. secret_age_days is a future textfile-collector
      # metric from a separate secret-age-audit package, not present in develop.
      - uid: secret-rotation-overdue
        title: Secret rotation overdue (dormant until secret-age exporter lands)
        condition: B
        data:
          - refId: A
            relativeTimeRange: {from: 300, to: 0}
            datasourceUid: prometheus
            model:
              expr: secret_age_days
              instant: true
              refId: A
          - refId: B
            relativeTimeRange: {from: 0, to: 0}
            datasourceUid: __expr__
            model:
              type: threshold
              expression: A
              conditions:
                - evaluator: {type: gte, params: [{{ grafana_stack_alert_secret_age_days }}]}
              refId: B
        for: 0m
        noDataState: OK
        execErrState: OK
        labels: {severity: warning}
        annotations:
          summary: "Secret {{ '{{' }} $labels.path {{ '}}' }} is {{ '{{' }} $values.A {{ '}}' }} days old (>= {{ grafana_stack_alert_secret_age_days }})."
{% endif %}
