## Managed by Ansible (grafana_stack role) — do not edit by hand.
## Grafana unified-alerting file provisioning: notification policy tree.
## Default route to the Cribl Stream HEC input, which fans alert events out to
## the event index and the alert webhook. Critical alerts go to the critical
## Slack contact point (critical-slack-contact-point.yml, dryvist/grafana-dashboards).
## Repeat floors per issue: critical at most every 4h, the rest once a day.
## group_by "..." makes every alert instance its own group: a shared group
## re-sends every member when one joins or resolves, bypassing repeat_interval
## (one new disk re-posted all 60+ firing disk alerts).
apiVersion: 1

policies:
  - orgId: 1
    receiver: {{ grafana_stack_alert_contact_point_name }}
    group_by: ["..."]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: {{ grafana_stack_alert_repeat_interval }}
    routes:
      - receiver: {{ grafana_stack_alert_contact_point_name }}
        object_matchers:
          - ["severity", "=", "warning"]
        repeat_interval: {{ grafana_stack_alert_warning_repeat_interval }}
      - receiver: {{ grafana_stack_alert_contact_point_name }}
        object_matchers:
          - ["severity", "=", "info"]
        repeat_interval: {{ grafana_stack_alert_warning_repeat_interval }}
      - receiver: critical-slack
        object_matchers:
          - ["severity", "=", "critical"]
        repeat_interval: {{ grafana_stack_alert_critical_repeat_interval }}
