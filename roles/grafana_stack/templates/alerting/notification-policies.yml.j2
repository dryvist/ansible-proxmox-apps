## Managed by Ansible (grafana_stack role) — do not edit by hand.
## Grafana unified-alerting file provisioning: notification policy tree.
## Single default route to ntfy — a starting point, not the full
## topic-routing scheme (per-severity/per-team routing can split this later).
apiVersion: 1

policies:
  - orgId: 1
    receiver: {{ grafana_stack_alert_contact_point_name }}
    group_by: ["alertname"]
    group_wait: 30s
    group_interval: 5m
    repeat_interval: {{ grafana_stack_alert_repeat_interval }}
