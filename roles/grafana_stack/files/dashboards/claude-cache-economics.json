    {
      "id": 11,
      "type": "table",
      "title": "Cost drivers by repo",
      "description": "Repo is resolved from the workspace layout, not the working-directory basename \u2014 a worktree lives at <repo>/main, so the basename names the worktree. Work outside the workspace folds into 'other'.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "topk(20, sum by (repo) (increase(claude_jsonl_cache_read_tokens_total[$__range])))",
          "legendFormat": "{{repo}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "repo": "Repository",
              "Value": "Cache read tokens"
            }
          }
        }
      ]
