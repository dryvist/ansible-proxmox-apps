    {
      "id": 10,
      "type": "timeseries",
      "title": "Output and thinking tokens",
      "description": "Thinking tokens are a subset of output tokens, not an addition.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
