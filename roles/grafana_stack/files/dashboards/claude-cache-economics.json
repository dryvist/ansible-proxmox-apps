      "title": "Cache reads: main session vs subagents",
      "description": "Subagent usage is recorded in separate transcript files; the parent session's records cannot be used to derive it.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
