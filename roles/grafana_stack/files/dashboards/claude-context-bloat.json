{
  "uid": "claude-context-bloat",
  "title": "Claude Code \u2014 Context Bloat",
  "description": "What fills the context window before the conversation starts, and whether trimming the skill and plugin surface is working. Sourced entirely from the transcript ETL; no exporter reports this.",
  "tags": [
    "claude-code",
    "ai-observability",
    "context"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "repo",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "query": "label_values(claude_jsonl_context_injection_bytes_total, repo)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 1,
        "query": "label_values(claude_jsonl_context_injection_bytes_total, kind)",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Injected context (range)",
      "description": "Total bytes of context injected before any conversation content \u2014 skill listings, MCP instructions, agent listings, hook output.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_context_injection_bytes_total[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Skill listings",
      "description": "The skill listing alone. Measured at ~44 KB per injection across all history \u2014 the single largest contributor, and the one `activeGroups` and the plugin tiers directly control.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_context_injection_bytes_total{kind=\"skill_listing\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Skill share of injected context",
      "description": "Drive this down by trimming the global plugin tiers and setting `activeGroups` per host. This is the before/after number for that work.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_context_injection_bytes_total{kind=\"skill_listing\"}[$__range])) / clamp_min(sum(increase(claude_jsonl_context_injection_bytes_total[$__range])), 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Avg skill listing size",
      "description": "Mean bytes per skill-listing injection. Falls when the surface is trimmed even if session count rises.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 15,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_context_injection_bytes_total{kind=\"skill_listing\"}[$__range])) / clamp_min(sum(increase(claude_jsonl_context_injections_total{kind=\"skill_listing\"}[$__range])), 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Injections",
      "description": "Count of injected-context attachments. A large count of tiny injections (hook output) is a different problem from a few enormous ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 19,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_context_injections_total[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Injected context by kind",
      "description": "Bytes per second of injected context, by source. Watch the skill_listing band shrink as the surface is trimmed.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (kind) (rate(claude_jsonl_context_injection_bytes_total[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "piechart",
      "title": "Share by kind",
      "description": "Where the window actually goes. Two shapes matter: a few very large injections, and very many small ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (kind) (increase(claude_jsonl_context_injection_bytes_total[$__range])))",
          "legendFormat": "{{kind}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "pieType": "donut"
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Injection count by kind",
      "description": "Frequency rather than volume. Hook output dominates here while contributing far less total size.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum by (kind) (rate(claude_jsonl_context_injections_total[$__rate_interval]))",
          "legendFormat": "{{kind}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Injected context per cache-read Mtok",
      "description": "Normalises bloat against how much work was actually done, so a busy period does not read as regression. Falling is good.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 14,
        "y": 14,
        "w": 10,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "sum(increase(claude_jsonl_context_injection_bytes_total[$__range])) / clamp_min(sum(increase(claude_jsonl_cache_read_tokens_total[$__range])) / 1e6, 1)",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Injected context by repo",
      "description": "Per-repo scoping (`ai-pack`) is the lever here: a repo that needs three skills should not be loading the global surface.",
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "topk(20, sum by (repo) (increase(claude_jsonl_context_injection_bytes_total[$__range])))",
          "legendFormat": "{{repo}}",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "repo": "Repository",
              "Value": "Injected bytes"
            }
          }
        }
      ]
    }
  ]
}
