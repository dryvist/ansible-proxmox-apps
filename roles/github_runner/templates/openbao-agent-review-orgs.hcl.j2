{% include "openbao-agent.hcl.j2" %}
{% for github_runner_review_pool in github_runner_active_review_orgs %}
{# A listed owner mints from its own registration set; any other pool keeps the shared path. #}
{% if github_runner_review_pool.org in github_runner_register_owners %}
{% raw %}
template {
  contents             = "ACCESS_TOKEN={{ with secret \"{% endraw %}{{ github_runner_registration_token_path_prefix }}-{{ github_runner_review_pool.org }}{% raw %}\" }}{{ .Data.token }}{{ end }}\n"
{% endraw %}
{% else %}
{% raw %}
template {
  contents             = "ACCESS_TOKEN={{ with secret \"{% endraw %}{{ github_runner_review_token_path }}{% raw %}\" \"org_name={% endraw %}{{ github_runner_review_pool.org }}{% raw %}\" }}{{ .Data.token }}{{ end }}\n"
{% endraw %}
{% endif %}
  destination          = "{{ github_runner_token_env_file | dirname }}/access-token-{{ github_runner_review_pool.org }}.env"
  perms                = "0600"
  error_on_missing_key = true
}
{% endfor %}
