{{ ansible_managed | comment }}
# One systemd instance per pooled runner: github-runner@1 .. @{{ github_runner_replicas }}.
#
# WHY NOT docker compose, WHICH THIS REPLACED:
# the compose service set EPHEMERAL=true with `restart: unless-stopped`. A
# restart policy restarts the SAME container, so its writable layer was never
# discarded -- EPHEMERAL gives a fresh REGISTRATION, not a fresh FILESYSTEM.
# Every job's checkout, tool cache and build output accumulated in one layer
# for the container's whole life. Measured before this change: 54GB, 17.8GB and
# 14.7GB in three containers on one host, which filled a 99G boot disk to 0
# bytes free and took the guest down -- sshd included. `docker system df`
# reported 99% of container space as reclaimable, which is what "nothing ever
# resets this" looks like from the outside.
#
# `docker run --rm` discards the writable layer when the container exits, and
# an ephemeral runner exits after exactly one job. That makes disk growth
# bounded by a single job rather than by uptime, with no cleanup timer to fail
# silently. systemd's Restart= supplies the next container.

[Unit]
Description=Ephemeral GitHub Actions runner %i
After=docker.service
Requires=docker.service
# A runner is worthless without the daemon; do not spin restarting if it dies.
PartOf=docker.service
# The registration token is minted by the agent, not by Ansible. Ordering alone
# is not enough -- see the ExecStartPre wait below.
After=openbao-github-runner-agent.service
Requires=openbao-github-runner-agent.service

[Service]
Type=exec
# A prior container of this name can survive an ungraceful stop (SIGKILL, host
# reset), and `docker run --name` then fails with a name conflict forever.
# `-` so a clean start is not a failure.
ExecStartPre=-/usr/bin/docker rm -f {{ github_runner_container_prefix }}-%i
# Requires= only guarantees the agent PROCESS started, not that it has
# authenticated and rendered a token yet, so on a cold boot this unit can reach
# `docker run` with the file still absent and register with an empty token.
#
# This waits on the observable condition (a non-empty token file), not on a
# guessed interval, and gives up loudly rather than starting a runner that
# cannot register. A timeout here exits 124 and fails the unit; the thing to
# look at is `systemctl status openbao-github-runner-agent`.
#
# `timeout` rather than a counting loop on purpose: systemd expands $VAR in
# command lines itself, so a shell variable would need escaping as $$VAR and
# silently becomes the empty string if that is ever forgotten. This form
# contains no dollar sign to get wrong.
ExecStartPre=/usr/bin/timeout 60 /bin/sh -c 'until [ -s {{ github_runner_token_env_file }} ]; do sleep 1; done'
# RUNNER_NAME_PREFIX below, never RUNNER_NAME. The image appends a random
# suffix to a prefix, but an explicit RUNNER_NAME is used verbatim -- and a
# FIXED name is unusable for an EPHEMERAL runner. GitHub tears down the
# registration after every job and releases the listener session a minute or
# two later, asynchronously. The replacement container starts in RestartSec and
# re-registers the same name while the outgoing session is still held, so it
# gets `A session for this runner already exists` -> Conflict, retries for
# ~2 minutes, then exits when the server garbage-collects the registration
# underneath it. systemd starts another one straight into the same race.
#
# Each cycle leaves a fresh session draining behind it, so the pool degrades
# from intermittent to permanently wedged: the runners stay "up" while never
# reaching `Listening for Jobs`, and every job targeting these labels queues
# with no runner assigned until GitHub's hard 24h ceiling cancels it.
#
# A unique name per incarnation cannot collide -- which is the image's own
# default, and what the variable was always named for.
ExecStart=/usr/bin/docker run \
    --rm \
    --name {{ github_runner_container_prefix }}-%i \
    --env-file {{ github_runner_env_file }} \
    --env-file {{ github_runner_token_env_file }} \
    --cpus {{ github_runner_cpu_limit }} \
    --memory {{ github_runner_memory_limit }} \
    --group-add {{ github_runner_docker_gid }} \
    --network {{ github_runner_network }} \
    --volume /var/run/docker.sock:/var/run/docker.sock \
    --env RUNNER_NAME_PREFIX={{ github_runner_name_prefix }}-%i \
    {{ github_runner_image }}
# `docker run` forwards the container's exit status. An ephemeral runner exits
# NON-ZERO after a completed job (observed: status=1/FAILURE immediately after
# `Job ... completed with result: Succeeded`), so `always` -- not `on-failure`
# -- is what starts the next one. The exit code carries no signal here; do not
# gate the restart on it.
Restart=always
# Only crash-loop protection. It is deliberately NOT the mechanism that avoids
# a session collision -- the unique runner name above is. Do not tune this to
# "wait out" a session; that trades throughput for a race it cannot close.
RestartSec=10s
# Stop means stop: without this, systemd's SIGTERM reaches `docker run` but the
# container can outlive it and hold the runner registration.
ExecStop=/usr/bin/docker stop --time {{ github_runner_stop_timeout }} {{ github_runner_container_prefix }}-%i
TimeoutStopSec={{ github_runner_stop_timeout + 30 }}

[Install]
WantedBy=multi-user.target
