{{ ansible_managed | comment }}
# Read by `docker run --env-file`. Mode 0600, root-owned.
#
# ACCESS_TOKEN and the e2e Splunk credentials are deliberately NOT here. The
# token is a GitHub App installation token with a fixed ~1h life, so anything
# Ansible renders into this file is expired for most container starts; the
# credentials rotate in the store. Both come from --env-files that the
# per-host OpenBao Agent keeps current -- see openbao-agent.hcl.j2.
#
# --env-file parses KEY=VALUE literally -- no quoting, no interpolation, and a
# quote character would become part of the value. Do not add quotes here.
RUNNER_SCOPE=org
ORG_NAME={{ github_runner_org }}
RUNNER_GROUP={{ github_runner_group }}
LABELS={{ github_runner_labels }}
# Where the e2e suite finds the inventory (tests/e2e/fixtures.py); the file is
# bind mounted by github-runner@.service.
TOFU_INVENTORY_PATH={{ github_runner_inventory_mount }}
# Each container serves one job, deregisters, and exits; systemd starts a fresh
# one. Combined with `docker run --rm` this is what bounds disk growth to a
# single job -- see github-runner@.service.
EPHEMERAL=true
# The runner's own auto-update races an ephemeral lifecycle: it can restart the
# process mid-registration, and the image pin is what makes the fleet's version
# reviewable. Updates arrive by moving github_runner_image.
DISABLE_AUTO_UPDATE=true
