{{ ansible_managed | comment }}
# Age-based cleanup for the runner _diag bind mounts (github-runner@.service.j2,
# tasks/main.yml). Each job writes new, already-closed log files rather than
# appending to one growing file, so there is nothing for logrotate to rotate --
# only a count of files that grows forever without this. `e` cleans matching
# paths on an existing systemd-tmpfiles-clean.timer run; it creates nothing and
# never touches a file newer than the age below.
e {{ github_runner_diag_host_dir }}/*/*.log - - - {{ github_runner_diag_retention_days }}d
