{{ ansible_managed | comment }}
# Age-based cleanup for the runner _diag bind mounts (github-runner@.service.j2,
# tasks/main.yml). Each job writes new, already-closed log files rather than
# appending to one growing file, so there is nothing for logrotate to rotate --
# only a count of files that grows forever without this. `e` acts on the
# directories its glob matches and removes the files inside them older than the
# age below, so the glob names each slot directory, not the log files. It runs
# on an existing systemd-tmpfiles-clean.timer run and creates nothing.
e {{ github_runner_diag_host_dir }}/* - - - {{ github_runner_diag_retention_days }}d
