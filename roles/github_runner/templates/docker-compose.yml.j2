---
services:
  runner:
    image: "{{ github_runner_image_name }}:{{ github_runner_image_tag }}"
    cpus: {{ github_runner_cpu_limit }}
    mem_limit: "{{ github_runner_memory_limit }}"
    environment:
      GITHUB_ORG: "{{ github_runner_org }}"
      RUNNER_GROUP: "{{ github_runner_group }}"
      BAO_ADDR: "{{ github_runner_bao_addr }}"
      BAO_ROLE_ID: "{{ github_runner_bao_role_id }}"
      BAO_SECRET_ID: "{{ github_runner_bao_secret_id }}"
      BAO_PERMISSION_SET: "{{ github_runner_bao_permission_set }}"
      BAO_GITHUB_MOUNT: "{{ github_runner_bao_github_mount }}"
{% if github_runner_sops_age_key is defined %}
      SOPS_AGE_KEY: "{{ github_runner_sops_age_key }}"
{% endif %}
      RUNNER_LABELS: "{{ github_runner_labels }}"
      RUNNER_NAME_PREFIX: "{{ github_runner_name_prefix }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    # The runner user must be able to write the bind-mounted host socket; the
    # host's docker group GID is looked up at converge time (never hardcoded —
    # runner 2.336.0's image dropped the incidental in-image GID match that
    # made this work before).
    group_add:
      - "{{ github_runner_docker_gid }}"
    restart: unless-stopped
    networks:
      - ci_runners
    # This replica count is the fleet's whole concurrency cap. See
    # inventory/group_vars/docker_vms.yml for why it is the only one.
    deploy:
      replicas: {{ github_runner_replicas }}

networks:
  ci_runners:
    name: ci_runners
    driver: bridge
    driver_opts:
      com.docker.network.bridge.enable_ip_masquerade: "true"
