# {{ ansible_managed }}
[Unit]
Description=Reclaim Docker/containerd images, containers and unused volumes
# Every replica on this host shares one dockerd (siblings on docker.sock, not
# children of the runner's cgroup — see github_runner defaults). Nothing ever
# reclaimed it between the one-time data-disk migration and now, so pulled
# test images and build cache grew without bound until the disk hit 0 bytes
# free and every Molecule scenario failed apt's signature check on a
# truncated index — not a real GPG problem. This timer is the recurring
# reclaim that migration never was.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# --all also drops unused (not just dangling) images; a currently-running
# sibling container's image is never a prune candidate regardless of age, so
# this cannot evict what another in-flight job is using. The age filter keeps
# it from evicting an image a job pulled seconds ago between prune runs.
ExecStart=/usr/bin/docker system prune --all --force --filter "until={{ github_runner_prune_min_age_hours }}h"
# `docker system prune` never touches volumes (removing one destroys data, not
# a rebuildable layer) — verified against the installed CLI (29.4.0):
# `docker volume prune` takes no `until`/age filter at all, only `--filter
# label` and `-a`. Its safety is instead structural: a volume attached to any
# existing container, running or not, is never a candidate, with or without
# `-a`. Durable state on this host lives in NAMED volumes attached to
# long-running platform services, so it is never in the unreferenced set this
# targets — that property, not the flags below, is what makes an automated
# volume reclaim on a shared host defensible. Deliberately without `-a`:
# scoped to anonymous volumes only (one per Molecule test run, confirmed the
# majority contributor on this host), never a named one temporarily detached
# from a service mid-restart.
ExecStartPost=/usr/bin/docker volume prune --force
