# {{ ansible_managed }}
[Unit]
Description=Build the Molecule base image every scenario on this host runs on
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# --pull picks up a re-published upstream base; --no-cache makes every build a
# fresh image with a fresh creation time, which is what keeps the tag younger
# than github-runner-docker-prune's age filter. The build's own apt traffic
# goes through the estate cache like a job's would.
ExecStart=/usr/bin/docker build --pull --no-cache \
  --build-arg APT_PROXY_URL={{ github_runner_apt_proxy_url }} \
  --tag {{ github_runner_molecule_image }} \
  {{ github_runner_molecule_image_dir }}
