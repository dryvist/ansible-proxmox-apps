{{ ansible_managed | comment }}
#
# Read by systemd (EnvironmentFile) for one slot; github-runner@.service.j2
# expands RUNNER_HOST_MOUNTS as separate words in that slot's `docker run`.
# A review slot runs model agents, so it mounts nothing from the host: no
# Docker socket, and its _diag and tool cache stay in the container layer that
# `--rm` discards after the job. The slot rule matches LABELS in runner.env.j2.
{% set _slot = github_runner_slot | string %}
{% if github_runner_slot | int <= github_runner_review_slots | int %}
RUNNER_HOST_MOUNTS=
{% else %}
RUNNER_HOST_MOUNTS=--volume {{ (github_runner_unit_diag_dir | default(github_runner_diag_host_dir ~ '/%i')) | replace('%i', _slot) }}:/actions-runner/_diag --volume {{ (github_runner_unit_tool_cache_dir | default(github_runner_tool_cache_host_dir ~ '/%i')) | replace('%i', _slot) }}:{{ github_runner_tool_cache_mount }} --group-add {{ github_runner_docker_gid }} --volume /var/run/docker.sock:/var/run/docker.sock
{% endif %}
