#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Keystone SPOF liveness watchdog. Rendered by the service_deadman role and run
# on a systemd timer (every {{ service_deadman_interval }}). For each keystone
# service on this host it runs a functional probe and:
#   - healthy  -> reports success to its Gatus external endpoint and its
#                 Uptime Kuma push monitor, and pings its healthchecks check
#   - breached -> logs, pushes an ntfy alert, reports failure to Gatus and
#                 Kuma, and pings the healthchecks /fail endpoint
#
# A missed run (validator crash / host down) also pages, because both monitors
# expect a report every cycle. An unconfigured receiver skips only that
# receiver; the journal + ntfy alert still fire.
set -uo pipefail

NTFY_URL="{{ service_deadman_ntfy_url }}"
GATUS_URL="{{ service_deadman_gatus_url }}"
GATUS_TOKEN="{{ service_deadman_gatus_token }}"
KUMA_URL="{{ service_deadman_kuma_url }}"
HC_URL="{{ service_deadman_hc_url }}"
HC_PING_KEY="{{ service_deadman_hc_ping_key }}"
HOST="$(hostname)"
rc=0

# Report to the Gatus external endpoint deadman_<name>; no-op without a token.
# success is "true" or "false"; the error text is ignored by Gatus on success.
gatus_report() {
  local name="$1" success="$2" msg="$3"
  [[ -n "${GATUS_TOKEN}" ]] || return 0
  curl -fsS --max-time 8 -X POST -H "Authorization: Bearer ${GATUS_TOKEN}" \
    -G --data-urlencode "success=${success}" --data-urlencode "error=${msg}" \
    "${GATUS_URL}/api/v1/endpoints/deadman_${name}/external" >/dev/null 2>&1 || true
}

# Report to the Uptime Kuma push monitor for <name>; the push token is derived
# from the shared token and the name the same way status_stack renders it.
kuma_report() {
  local name="$1" status="$2" msg="$3" token
  [[ -n "${GATUS_TOKEN}" ]] || return 0
  token="$(printf '%s:%s' "${GATUS_TOKEN}" "${name}" | sha256sum | cut -c1-20)"
  curl -fsS --max-time 8 -G --data-urlencode "status=${status}" --data-urlencode "msg=${msg}" \
    "${KUMA_URL}/api/push/${token}" >/dev/null 2>&1 || true
}

# Ping the healthchecks check named <name> (created on first contact); no-op
# until the healthchecks receiver is configured. suffix is "" or "/fail".
hc_ping() {
  local name="$1" suffix="$2" msg="$3"
  [[ -n "${HC_URL}" && -n "${HC_PING_KEY}" ]] || return 0
  curl -fsS --max-time 8 -d "${msg}" \
    "${HC_URL}/ping/${HC_PING_KEY}/${name}${suffix}?create=1" >/dev/null 2>&1 || true
}

# Healthy: signal every deadman OK so a stalled validator is also caught.
mark_ok() {
  local name="$1"
  logger -t service-deadman "OK: ${name} healthy on ${HOST}"
  gatus_report "${name}" true ""
  kuma_report "${name}" up OK
  hc_ping "${name}" "" "OK"
}

# Breached: log, alert ntfy, signal every deadman's failure path.
mark_fail() {
  local name="$1"
  local msg="KEYSTONE DOWN: ${name} failed its liveness probe on ${HOST}"
  rc=1
  logger -t service-deadman "${msg}"
  if [[ -n "${NTFY_URL}" ]]; then
    curl -fsS --max-time 8 -H "Title: keystone deadman: ${name}" \
      -H "Priority: urgent" -H "Tags: rotating_light" \
      -d "${msg}" "${NTFY_URL}" >/dev/null 2>&1 || true
  fi
  gatus_report "${name}" false "${msg}"
  kuma_report "${name}" down "${msg}"
  hc_ping "${name}" "/fail" "${msg}"
}

{% for check in service_deadman_checks %}
# --- {{ check.name }} ---
if {{ check.probe_command }}; then
  mark_ok "{{ check.name }}"
else
  mark_fail "{{ check.name }}"
fi
{% endfor %}

exit "${rc}"
