{{ ansible_managed | comment }}
# Weekly integrity check of the %i repository.
[Unit]
Description=Weekly restic check of the {{ restic_backup_name }} %i repository

[Timer]
OnCalendar={{ restic_backup_check_on_calendar }}
RandomizedDelaySec={{ restic_backup_check_randomized_delay_sec }}
Persistent=true

[Install]
WantedBy=timers.target
