{{ ansible_managed | comment }}
# Weekly integrity check of the %i repository. Reads the same environment file as
# the backup unit, so it checks the repository the backup writes.
[Unit]
Description=Weekly restic check of the {{ restic_backup_name }} %i repository
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile={{ restic_backup_config_dir }}/backup-%i.env
# restic needs a cache directory and a unit has no $HOME, so give it a systemd-managed one.
CacheDirectory=restic
Environment=RESTIC_CACHE_DIR=%C/restic
ExecStart=/usr/bin/restic check
