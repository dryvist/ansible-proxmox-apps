{{ ansible_managed | comment }}
# Daily backup to the %i repository. The randomized delay spreads the load and
# keeps the repositories from starting in the same second.
[Unit]
Description=Daily {{ restic_backup_name }} backup to the %i repository

[Timer]
OnCalendar={{ restic_backup_backup_on_calendar }}
RandomizedDelaySec={{ restic_backup_randomized_delay_sec }}
Persistent=true

[Install]
WantedBy=timers.target
