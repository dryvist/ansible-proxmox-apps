{{ ansible_managed | comment }}
# restic target for one repository. Root-only: it carries the repository's key
# pair. systemd reads it before each unit runs.
RESTIC_REPOSITORY=s3:{{ item.endpoint if (item.endpoint is match('https?://')) else ('https://' ~ item.endpoint) }}/{{ item.bucket }}
RESTIC_PASSWORD_FILE={{ restic_backup_password_file }}
AWS_ACCESS_KEY_ID={{ item.access_key_id }}
AWS_SECRET_ACCESS_KEY={{ item.secret_access_key }}
AWS_DEFAULT_REGION={{ item.region }}
