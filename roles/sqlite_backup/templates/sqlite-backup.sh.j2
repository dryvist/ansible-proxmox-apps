#!/usr/bin/env bash
# {{ ansible_managed }}
#
# Online-consistent SQLite backups. For each configured directory, every
# matching database is copied with SQLite's own `.backup` command into a
# subdirectory of that same directory, then backups older than the retention
# window are pruned.
#
# `.backup` (not `cp`): it takes the database's own read lock and folds the WAL
# in, so the output is transactionally complete. Copying the file directly while
# the app is running can silently omit committed transactions.
#
# NOT `set -e` on the per-database loop: one unreadable database must not stop
# the others from being backed up. Any failure is recorded and the script exits
# non-zero at the end so the timer and the healthcheck both see it.
set -uo pipefail

RETENTION_DAYS="{{ sqlite_backup_retention_days }}"
SUBDIR="{{ sqlite_backup_subdir }}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
HC="{{ sqlite_backup_healthcheck_url }}"
FAILED=0

log() { logger -t sqlite-backup "$*"; echo "sqlite-backup: $*"; }

ping_hc() { [ -n "$HC" ] && curl -fsS -m 10 --retry 3 -o /dev/null "$1" >/dev/null 2>&1 || true; }
on_exit() {
  rc=$?
  if [ "$rc" -eq 0 ]; then ping_hc "$HC"; else ping_hc "$HC/fail"; fi
  exit "$rc"
}
trap on_exit EXIT

backup_one() {
  src="$1"
  dest_dir="$2"
  base="$(basename "$src")"
  dest="${dest_dir}/${base}-${STAMP}"

  # Write to a temp name and rename on success, so an interrupted run never
  # leaves a truncated file that looks like a usable backup.
  if sqlite3 "$src" ".backup '${dest}.partial'" 2>/dev/null; then
    # Prove the copy is a readable database before promoting it. A .backup that
    # exits 0 having produced an unopenable file is the failure this catches.
    if sqlite3 "${dest}.partial" "PRAGMA quick_check;" >/dev/null 2>&1; then
      mv -f "${dest}.partial" "$dest"
      log "backed up ${src}"
      return 0
    fi
    log "INTEGRITY CHECK FAILED for ${src} — discarding"
  else
    log "BACKUP FAILED for ${src}"
  fi
  rm -f "${dest}.partial"
  return 1
}

{% for dir in sqlite_backup_dirs %}
DIR="{{ dir }}"
DEST="${DIR}/${SUBDIR}"
if [ -d "$DIR" ]; then
  mkdir -p "$DEST"
  found=0
  while IFS= read -r db; do
    found=1
    backup_one "$db" "$DEST" || FAILED=1
  done < <(find "$DIR" -maxdepth {{ sqlite_backup_max_depth }} \
             -name "$SUBDIR" -prune -o \
             -type f \( {% for p in sqlite_backup_patterns %}{% if not loop.first %} -o {% endif %}-name "{{ p }}"{% endfor %} \) -print 2>/dev/null)
  # A configured directory that yields nothing is a misconfiguration, not a
  # clean run: it is exactly how a backup job reports success while protecting
  # nothing at all.
  if [ "$found" -eq 0 ]; then
    log "NO DATABASES MATCHED in ${DIR}"
    FAILED=1
  fi
  find "$DEST" -maxdepth 1 -type f -mtime "+${RETENTION_DAYS}" -delete
else
  log "MISSING DIRECTORY ${DIR}"
  FAILED=1
fi

{% endfor %}
exit "$FAILED"
