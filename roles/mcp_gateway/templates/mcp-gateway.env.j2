{{ ansible_managed | comment }}
# mcp-context-forge config. Full reference:
# https://ibm.github.io/mcp-context-forge/deployment/env-vars/
HOST=0.0.0.0
PORT={{ mcp_gateway_port }}
DATABASE_URL=sqlite:///{{ mcp_gateway_db_path }}
BASIC_AUTH_USER={{ mcp_gateway_admin_user }}
BASIC_AUTH_PASSWORD={{ mcp_gateway_admin_password }}
JWT_SECRET_KEY={{ mcp_gateway_jwt_secret }}
AUTH_ENCRYPTION_SECRET={{ mcp_gateway_encryption_secret }}
{% for server in mcp_gateway_upstream_servers %}
# {{ server.name }} upstream — API key sourced from {{ server.api_key_env }}
# (doppler-injected from OpenBao secrets-external/, never written here).
{{ server.name | upper }}_API_KEY={{ lookup('env', server.api_key_env) }}
{% endfor %}
