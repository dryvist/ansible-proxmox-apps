{{ ansible_managed | comment }}
# OpenBao voter-health sweep — one-shot, timer-driven. Rendered by the openbao
# role. Leader-gating happens inside the script, so this unit is identical on
# every node.

[Unit]
Description=OpenBao voter-health sweep (leader-gated, one-shot, read-only)
Documentation=https://github.com/JacobPEvans/ansible-proxmox-apps
After=openbao.service
Wants=openbao.service

[Service]
Type=oneshot
User={{ openbao_user }}
Group={{ openbao_group }}
EnvironmentFile={{ openbao_voter_health_env_file }}
ExecStart={{ openbao_voter_health_script_path }}
NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
