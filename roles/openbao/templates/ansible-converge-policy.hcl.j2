{{ ansible_managed | comment }}
# OpenBao policy for the ansible-converge AppRole — config-management pulls
# (was "ansible"). ENUMERATED exact paths only: there is deliberately NO
# platform/* or apps/* wildcard, and no access to the infra kernel
# (secret/infra/*). The exact-path MCP publication grants below are the only
# write exceptions.
#
# THE LIST BELOW IS THE CONSUMER INVENTORY. Every entry is a KV path that a
# converge actually reads with THIS AppRole's token, and each names the reading
# call site. A path with no named consumer does not belong here; a new consumer
# adds its path here and nowhere else. The per-resource-domain reads
# (observability / local-cloud / monitoring / media / apps / local-llm) do NOT
# use this identity — roles/openbao_secrets logs each domain in with its own
# least-privilege AppRole, so those subtrees are intentionally absent.
#
#   platform/object-storage
#     The shared `inventory_resolve` role (dryvist/homelab-contracts, pinned in
#     each repo's requirements.yml) reads these object-storage credentials to
#     fetch the tofu-published inventory artifact from RustFS. Call sites:
#       ansible-proxmox        playbooks/load_tofu.yml
#       ansible-proxmox-apps   inventory/load_tofu.yml
#       ansible-proxmox-ai     inventory/load_tofu.yml
#       ansible-splunk         inventory/load_tofu.yml
#
#   platform/windows-vdi/win11-admin
#     inventory/load_tofu.yml resolves the local Administrator password for the
#     Windows guests, which are published with ansible_connection=winrm and are
#     unreachable without it. The same credential is what roles/windows_baseline
#     authenticates with. READ ONLY: the credential is minted elsewhere and a
#     converge must never rewrite it.
#
#   platform/defaults
#     Estate-wide defaults, one KV object with a key per default:
#     admin_username / admin_password today, more later (limits, ports,
#     retention). It is a namespace rather than one password path because a
#     second default would otherwise need a second grant and a second lookup.
#     roles/windows_baseline reads admin_password to set the local
#     Administrator credential on VDI guests, so a human can type it at an RDP
#     or console prompt where copy/paste is unavailable. Sub-paths
#     (platform/defaults/<domain>) are NOT granted by wildcard — each one is a
#     deliberate addition to the list below.
#
#   apps/nas
#     roles/nas_storage resolves the managed Samba accounts of a node that
#     declares an SMB share. Each account is selected by ROLE rather than by
#     name and reads two fields, <secret_prefix>_username and
#     <secret_prefix>_password -- a login name is half a credential and is not
#     rotatable once published, so it lives here and not in the desired state.
#     Call sites:
#       ansible-proxmox        roles/nas_storage/tasks/main.yml
#       ansible-proxmox        playbooks/validate-nas.yml
#     READ ONLY: the credential is provisioned out of band, and a converge
#     must never rewrite the account it authenticates as.
#
#   apps/nautobot is NOT listed here. It is granted once, below, by the
#   credential-publication loop — which is a superset of the read it used to
#   carry. Two stanzas for one path is ambiguous at policy-parse time, so the
#   path must appear exactly once in this file.

{% for kv_path in ['platform/object-storage', 'platform/windows-vdi/win11-admin', 'platform/defaults', 'apps/nas'] %}
path "{{ openbao_kv_mount }}/data/{{ kv_path }}" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/{{ kv_path }}" {
  capabilities = ["read", "list"]
}

{% endfor %}
# Transitional exact-path exception: ansible-splunk's converge publishes the
# shared Splunk MCP connection (SPLUNK_MCP_URL + the minted SPLUNK_MCP_TOKEN)
# here. Narrow create/update/read on the SINGLE secret — deliberately NOT a
# wildcard and NOT blanket secret/ai/* write (that stays with ai-orchestrator).
# `read` is required: the publisher does a read-modify-write to preserve sibling
# fields. This follows the same exact-path scoping pattern as hermes-write.
path "{{ openbao_kv_mount }}/data/ai/mcp/splunk" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/splunk" {
  capabilities = ["read"]
}

# KV v2 soft-delete recovery uses a separate update endpoint. Keep this grant
# pinned to the same single secret; no other ai/* path can be undeleted.
path "{{ openbao_kv_mount }}/undelete/ai/mcp/splunk" {
  capabilities = ["update"]
}

# Transitional exact-path exception (Vikunja MCP): the converge publishes the
# minted Vikunja MCP connection here. Same narrow create/update/read on the
# SINGLE secret as the splunk grant above — deliberately NOT a wildcard.
path "{{ openbao_kv_mount }}/data/ai/mcp/vikunja" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/vikunja" {
  capabilities = ["read"]
}

# Transitional exact-path exception (Zammad MCP): the converge publishes the
# minted Zammad MCP connection here. Same narrow create/update/read on the
# SINGLE secret as the splunk grant above — deliberately NOT a wildcard.
path "{{ openbao_kv_mount }}/data/ai/mcp/zammad" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/zammad" {
  capabilities = ["read"]
}

# Transitional exact-path exception (Nautobot MCP): the converge publishes the
# minted Nautobot MCP connection here. Same narrow create/update/read on the
# SINGLE secret as the splunk grant above — deliberately NOT a wildcard.
path "{{ openbao_kv_mount }}/data/ai/mcp/nautobot" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/ai/mcp/nautobot" {
  capabilities = ["read"]
}

# Transitional exact-path exception (Splunk frozen-archive B2 credential): the
# ansible-splunk converge reads the Backblaze B2 credential for the frozen
# archive on the external-SaaS mount. Narrow read on the SINGLE secret —
# deliberately NOT a wildcard. The mount below is the external-SaaS KV v2
# mount and is intentionally a literal path, not the openbao_kv_mount
# variable — that variable names the internal mount, not this one.
path "secrets-external/data/platform/backblaze-splunk" {
  capabilities = ["read"]
}

path "secrets-external/metadata/platform/backblaze-splunk" {
  capabilities = ["read"]
}

# --- Guest-generated credential publication -----------------------------------
# Several roles mint a credential create-if-absent and keep the ONLY copy in a
# guest-local file, so losing the guest loses the secret. For some of these the
# loss is not merely a password reset — an application encryption key can make
# previously stored credentials permanently undecryptable, and a rotated
# framework SECRET_KEY invalidates every session.
#
# roles/openbao_secrets/tasks/publish.yml writes those back here. Grants follow
# the exact-path pattern used above — ENUMERATED, one app per entry, deliberately
# NOT a secret/data/apps/* wildcard, so a converge can never rewrite an app
# credential it does not own. `read` is required for the read-modify-write that
# preserves sibling fields. No `delete`: publishing must never destroy a secret.
{% for app in openbao_credential_publish_apps %}
path "{{ openbao_kv_mount }}/data/apps/{{ app }}" {
  capabilities = ["create", "update", "read"]
}

path "{{ openbao_kv_mount }}/metadata/apps/{{ app }}" {
  capabilities = ["read"]
}

{% endfor %}
