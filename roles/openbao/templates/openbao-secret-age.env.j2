{{ ansible_managed | comment }}
# OpenBao secret-age auditor credentials — the least-privilege
# `secret-age-audit` AppRole (read-only metadata access). 0600, root:openbao.
# Consumed by the openbao-secret-age.service systemd unit via
# EnvironmentFile; never inlined into the script or the unit (keeps it out of
# `systemctl show` and `ps`).
OPENBAO_APPROLE_SECRET_AGE_AUDIT_ROLE_ID={{ openbao_secret_age_role_id }}
OPENBAO_APPROLE_SECRET_AGE_AUDIT_SECRET_ID={{ openbao_secret_age_secret_id }}
