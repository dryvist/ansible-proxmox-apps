{{ ansible_managed | comment }}
# OpenBao policy for the `offbox-sync` AppRole — the workstation's one-way
# off-box replication job (nix-darwin `programs.offboxSync`). Least-privilege
# reader for EXACTLY the SFTP target document it injects into rclone at each
# run via openbao-run: host, user, key file path, remote root, and known-hosts
# file path. Nothing else.
path "{{ openbao_kv_mount }}/data/apps/offbox-sync" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/apps/offbox-sync" {
  capabilities = ["read", "list"]
}
