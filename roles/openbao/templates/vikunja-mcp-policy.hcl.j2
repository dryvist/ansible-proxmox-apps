{{ ansible_managed | comment }}
# OpenBao policy for the `vikunja-mcp` AppRole — the workstation Vikunja MCP
# launch (openbao-run). Least-privilege reader for EXACTLY the MCP connection
# the vikunja role publishes (token + API URL). Nothing else in the ai subtree.
path "{{ openbao_kv_mount }}/data/ai/mcp/vikunja" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/ai/mcp/vikunja" {
  capabilities = ["read", "list"]
}
