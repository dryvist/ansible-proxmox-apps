#!/usr/bin/env bash
# {{ ansible_managed }}
#
# OpenBao secret-age auditor. Rendered by the openbao role and run on a
# systemd timer (every {{ openbao_secret_age_interval }}). Deployed on every
# openbao node, but only the ACTIVE node measures — standby nodes exit 0 as a
# no-op, so exactly one report and one set of alerts is produced per cycle
# regardless of who holds leadership (same leader-gate as
# openbao-snapshot.sh.j2).
#
# Measures how long every stored secret and every AppRole secret-id has gone
# without rotation, against two thresholds (days):
#   target = {{ openbao_secret_age_target_days }}  -> "due"     (digest only)
#   max    = {{ openbao_secret_age_max_days }}      -> "overdue" (paged now)
#
# Authenticates with the least-privilege `secret-age-audit` AppRole (metadata
# read only — it cannot read secret DATA, only the KV v2 metadata envelope and
# AppRole accessor lookups). Because of that, per-FIELD age is only knowable
# for fields the rotator already stamped: a KV v2 custom_metadata key named
# `rotated_<FIELD>` records that field's own last-rotation time. A path with
# no such stamps at all reports its PATH-level age via `updated_time` instead
# — a fallback that OVERSTATES freshness for any field not touched by the
# write that set updated_time (e.g. a merge-preserving write to a sibling
# field bumps updated_time for the whole secret without rotating this one).
#
# A path tagged custom_metadata.rotation=exempt (encryption/signing material
# a rotation would destroy, see openbao_rotation_exempt) or =engine
# (ephemeral/engine-minted, no stored value to age) is skipped entirely.
#
# NOT `set -e`: every failure is handled explicitly so it ALERTS (ntfy +
# healthchecks) instead of aborting silently.
#
# journald marker (logger -t openbao-secret-age), for Splunk alert rules:
#   success: "audit OK: N ok, N due, N overdue"
#   failure: "OpenBao secret-age audit FAILED on <host>: <reason>"
#   no-op:   "not the active node — nothing to do"
set -uo pipefail

BAO_ADDR="{{ openbao_api_addr }}"
TARGET_DAYS={{ openbao_secret_age_target_days }}
MAX_DAYS={{ openbao_secret_age_max_days }}
REPORT_PATH="{{ openbao_secret_age_report_path }}"
NTFY_URL="{{ openbao_secret_age_ntfy_url }}"
HC_URL="{{ openbao_secret_age_healthcheck_url }}"
# Every KV v2 mount except the config mount (variables, not secrets — out of
# scope for a secret-rotation audit). Derived from openbao_kv_mounts, the
# same list init.yml enables, rather than a second hand-maintained copy.
KV_MOUNTS="{{ openbao_kv_mounts | map(attribute='path')
              | reject('eq', openbao_config_mount) | join(' ') }}"
# The ONLY `bao` stderr text that means "this path does not exist" (see
# openbao_absent_stderr_marker, 01-kv-hierarchy-and-rbac.yml) — anything else
# (403, unreachable, malformed) says nothing about whether the path exists.
ABSENT_MARKER="{{ openbao_absent_stderr_marker }}"
HOST="$(hostname)"
DRY_RUN=0
[ "${1:-}" = "--dry-run" ] && DRY_RUN=1
# Denied reads and list failures below a mount ROOT are counted here rather
# than silently skipped — a wrong/missing policy must FAIL the run (urgent
# alert), never report "0 ok, 0 due, 0 overdue" and ping healthchecks green.
# A denied read is indistinguishable from an empty tree from inside a single
# `bao` call; only counting every non-root failure and failing on any of them
# tells the two apart.
ERRORS=0

log() { logger -t openbao-secret-age "$*"; echo "openbao-secret-age: $*"; }

# Ping a healthchecks endpoint if one is configured; no-op otherwise. $1 is the
# suffix: "" for the OK ping, "/fail" to signal a breach.
hc_ping() {
  [ -n "${HC_URL}" ] || return 0
  [ "${DRY_RUN}" = "1" ] && return 0
  curl -fsS --max-time 8 "${HC_URL}$1" >/dev/null 2>&1 || true
}

# Send one ntfy message. $1=priority $2=tags $3=title $4=body. Non-fatal on
# failure (an unreachable ntfy endpoint must never abort the audit or the
# report write), but LOGGED — unlike hc_ping, ntfy has no missed-ping deadman
# backstop, so a silently dropped page here would otherwise vanish with
# nothing in the journal/Splunk audit-log sourcetype to show it was attempted.
ntfy_send() {
  [ -n "${NTFY_URL}" ] || return 0
  [ "${DRY_RUN}" = "1" ] && return 0
  curl -fsS --max-time 8 -H "Title: $3" -H "Priority: $1" -H "Tags: $2" \
    -d "$4" "${NTFY_URL}" >/dev/null 2>&1 \
    || log "WARNING: ntfy page failed: $3"
}

# Alert + signal the deadman failure endpoint, then exit non-zero.
fail() {
  local msg="OpenBao secret-age audit FAILED on ${HOST}: $*"
  log "${msg}"
  ntfy_send urgent rotating_light "openbao secret-age" "${msg}"
  hc_ping /fail
  exit 1
}

# Same up-front dependency check as openbao-snapshot.sh.j2, for the same
# reason: a missing binary must surface as itself, not as whatever the first
# command using it happened to be doing.
# requires: curl jq date
require_binaries() {
  local missing=""
  command -v bao >/dev/null 2>&1 || missing="bao"
  for _bin in $(sed -n 's/^# requires: //p' "$0"); do
    command -v "${_bin}" >/dev/null 2>&1 || missing="${missing} ${_bin}"
  done
  [ -z "${missing# }" ] || fail "required binary not installed:${missing# }"
}
require_binaries

export BAO_ADDR

# 1. Leader-gate. /sys/leader is unauthenticated; is_self=true only on the
#    active node. A standby is a clean no-op so peers never double-page.
#    A curl failure is NOT a standby — collapsing it into the no-op would let
#    a cluster-wide audit miss look healthy.
leader_json="$(mktemp)"
if ! curl -fsS --max-time 8 -o "${leader_json}" "${BAO_ADDR}/v1/sys/leader"; then
  rm -f "${leader_json}"
  fail "local sys/leader unreachable (not a standby no-op)"
fi
if ! jq -e '.is_self == true' "${leader_json}" >/dev/null 2>&1; then
  rm -f "${leader_json}"
  log "not the active node — nothing to do"
  exit 0
fi
rm -f "${leader_json}"

# 2. Authenticate with the least-privilege secret-age-audit AppRole.
token="$(bao write -field=token auth/approle/login \
  role_id="${OPENBAO_APPROLE_SECRET_AGE_AUDIT_ROLE_ID}" \
  secret_id="${OPENBAO_APPROLE_SECRET_AGE_AUDIT_SECRET_ID}" 2>/dev/null)" \
  || fail "secret-age-audit AppRole login failed"
[ -n "${token}" ] || fail "secret-age-audit AppRole login returned an empty token"
export BAO_TOKEN="${token}"

now_epoch="$(date -u +%s)"
items_json="$(mktemp)"
echo "[]" >"${items_json}"

# age_days_from_ts <iso8601-utc> -> integer days, or empty on parse failure.
age_days_from_ts() {
  local ts="$1" epoch
  epoch="$(date -u -d "${ts}" +%s 2>/dev/null)" || return 1
  echo $(((now_epoch - epoch) / 86400))
}

# status_for_age <days> -> ok | due | overdue
status_for_age() {
  local d="$1"
  if [ "${d}" -ge "${MAX_DAYS}" ]; then
    echo overdue
  elif [ "${d}" -ge "${TARGET_DAYS}" ]; then
    echo due
  else
    echo ok
  fi
}

# append_item <json-object> — accumulate one report row.
append_item() {
  local tmp
  tmp="$(mktemp)"
  jq --argjson item "$1" '. + [$item]' "${items_json}" >"${tmp}" && mv "${tmp}" "${items_json}"
}

# process_kv_leaf <mount> <path> — read one KV v2 secret's metadata and
# append one item per rotated_<FIELD> stamp, or one path-level fallback item
# when no per-field stamp exists.
process_kv_leaf() {
  local mount="$1" path="$2" meta_json rc
  meta_json="$(bao kv metadata get -format=json "${mount}/${path}" 2>/dev/null)"
  rc=$?
  if [ "${rc}" -ne 0 ]; then
    log "metadata read failed for ${mount}/${path} — counted as an error, not skipped"
    ERRORS=$((ERRORS + 1))
    return
  fi

  local rotation_tag
  rotation_tag="$(echo "${meta_json}" | jq -r '.data.custom_metadata.rotation // empty')"
  case "${rotation_tag}" in
  exempt | engine)
    return
    ;;
  esac

  local updated_time field_keys
  updated_time="$(echo "${meta_json}" | jq -r '.data.updated_time')"
  field_keys="$(echo "${meta_json}" | jq -r \
    '.data.custom_metadata // {} | keys[] | select(startswith("rotated_"))')"

  if [ -z "${field_keys}" ]; then
    local age
    age="$(age_days_from_ts "${updated_time}")" || {
      # Never log the value: custom_metadata is operator-writable free text,
      # and this AppRole's whole design is "never sees a value" — only the
      # key/path identify the failure.
      log "unparseable updated_time for ${mount}/${path} — counted as an error, not skipped"
      ERRORS=$((ERRORS + 1))
      return
    }
    append_item "$(jq -n --arg mount "${mount}" --arg path "${path}" \
      --argjson age "${age}" --arg status "$(status_for_age "${age}")" \
      '{kind:"kv", mount:$mount, path:$path, field:null, age_days:$age, source:"updated_time", status:$status}')"
    return
  fi

  while IFS= read -r key; do
    [ -n "${key}" ] || continue
    local field ts age
    field="${key#rotated_}"
    ts="$(echo "${meta_json}" | jq -r --arg k "${key}" '.data.custom_metadata[$k]')"
    age="$(age_days_from_ts "${ts}")" || {
      # Never log the value — see the comment on the updated_time case above.
      log "unparseable ${key} for ${mount}/${path} — counted as an error, not skipped"
      ERRORS=$((ERRORS + 1))
      continue
    }
    append_item "$(jq -n --arg mount "${mount}" --arg path "${path}" --arg field "${field}" \
      --argjson age "${age}" --arg status "$(status_for_age "${age}")" \
      '{kind:"kv", mount:$mount, path:$path, field:$field, age_days:$age, source:"rotated_field", status:$status}')"
  done <<<"${field_keys}"
}

# walk_kv <mount> <path> — recurse through a KV v2 metadata tree. path may be
# empty for the mount root; a trailing "/" from `bao kv list` marks a
# directory to recurse into, anything else is a leaf secret.
#
# `bao kv list` exits non-zero both for a genuinely ABSENT/empty directory
# and for a policy DENIAL — the ABSENT_MARKER stderr text is the only thing
# that tells them apart (see the var doc above). The mount ROOT (path=="")
# is a call every legitimate run of this AppRole must be able to make: ANY
# failure there — absent or denied — means the mount or the policy is wrong,
# so it FAILS the whole audit rather than reporting an empty, healthy-looking
# tree. Below the root, a genuinely absent subdirectory is fine (nothing to
# audit there yet); a DENIAL is counted into ERRORS rather than an immediate
# fail — the run still fails overall once every mount has been walked.
walk_kv() {
  local mount="$1" path="$2" list_json rc entries err
  err="$(mktemp)"
  list_json="$(bao kv list -format=json "${mount}/${path}" 2>"${err}")"
  rc=$?
  if [ "${rc}" -ne 0 ]; then
    if [ -z "${path}" ]; then
      rm -f "${err}"
      fail "kv list failed at mount root ${mount}/ — refusing to report an empty tree as healthy"
    fi
    if ! grep -qF "${ABSENT_MARKER}" "${err}"; then
      log "kv list DENIED for ${mount}/${path} (not absent) — counted as an error, not skipped"
      ERRORS=$((ERRORS + 1))
    fi
    rm -f "${err}"
    return 0
  fi
  rm -f "${err}"
  entries="$(echo "${list_json}" | jq -r '.[]')"
  while IFS= read -r entry; do
    [ -n "${entry}" ] || continue
    if [[ "${entry}" == */ ]]; then
      walk_kv "${mount}" "${path}${entry}"
    else
      process_kv_leaf "${mount}" "${path}${entry}"
    fi
  done <<<"${entries}"
}

for mount in ${KV_MOUNTS}; do
  walk_kv "${mount}" ""
done

# 3. Every AppRole's secret-id population, by accessor (never the secret_id
#    itself — the accessor is the non-secret handle the lookup API takes).
#    `auth/approle/role` is this call's equivalent of a KV mount root: every
#    legitimate run of this AppRole must be able to list it, so ANY failure
#    here FAILS the whole audit rather than reporting "no AppRoles" as
#    healthy. Below that, a per-role secret-id listing or accessor lookup
#    failure is counted into ERRORS (absent is fine and silent, same
#    ABSENT_MARKER discriminator as the KV walk; denied or malformed is not).
role_err="$(mktemp)"
role_list="$(bao list -format=json auth/approle/role 2>"${role_err}")"
role_rc=$?
if [ "${role_rc}" -ne 0 ]; then
  role_err_text="$(cat "${role_err}")"
  rm -f "${role_err}"
  fail "auth/approle/role list failed: ${role_err_text}"
fi
rm -f "${role_err}"

while IFS= read -r role; do
  [ -n "${role}" ] || continue
  accessor_err="$(mktemp)"
  accessor_list="$(bao list -format=json "auth/approle/role/${role}/secret-id" 2>"${accessor_err}")"
  accessor_rc=$?
  if [ "${accessor_rc}" -ne 0 ]; then
    grep -qF "${ABSENT_MARKER}" "${accessor_err}" || {
      log "secret-id list DENIED for role ${role} (not absent) — counted as an error, not skipped"
      ERRORS=$((ERRORS + 1))
    }
    rm -f "${accessor_err}"
    continue
  fi
  rm -f "${accessor_err}"
  while IFS= read -r accessor; do
    [ -n "${accessor}" ] || continue
    lookup_json="$(bao write -format=json "auth/approle/role/${role}/secret-id-accessor/lookup" \
      secret_id_accessor="${accessor}" 2>/dev/null)"
    if [ -z "${lookup_json}" ]; then
      log "secret-id-accessor lookup failed for role ${role} accessor ${accessor:0:8} — counted as an error"
      ERRORS=$((ERRORS + 1))
      continue
    fi
    creation_time="$(echo "${lookup_json}" | jq -r '.data.creation_time')"
    age="$(age_days_from_ts "${creation_time}")" || {
      # Never log the value — see the comment on the updated_time case above.
      log "unparseable creation_time for role ${role} accessor ${accessor:0:8} — counted as an error, not skipped"
      ERRORS=$((ERRORS + 1))
      continue
    }
    append_item "$(jq -n --arg role "${role}" --arg accessor "${accessor:0:8}" \
      --argjson age "${age}" --arg status "$(status_for_age "${age}")" \
      '{kind:"approle", mount:"auth/approle", path:$role, field:$accessor, age_days:$age, source:"secret_id_creation_time", status:$status}')"
  done < <(echo "${accessor_list}" | jq -r '.[]')
done < <(echo "${role_list}" | jq -r '.[]')

# 4. Assemble the report (errors is a top-level count of denied — never
#    absent — reads/lists below a mount or AppRole root, per the discipline
#    above: a denial must be visible, never collapsed into a quiet "0
#    overdue").
report_json="$(jq -n --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  --argjson target_days "${TARGET_DAYS}" --argjson max_days "${MAX_DAYS}" \
  --argjson errors "${ERRORS}" \
  --slurpfile items "${items_json}" \
  '{generated_at: $generated_at, target_days: $target_days, max_days: $max_days,
    errors: $errors, items: $items[0],
    counts: ($items[0] | group_by(.status) | map({(.[0].status): length}) | add // {})}')"
rm -f "${items_json}"

if [ "${DRY_RUN}" = "1" ]; then
  echo "${report_json}"
  [ "${ERRORS}" -eq 0 ] || fail "${ERRORS} denied read(s)/list(s) during the audit — see the printed report"
  exit 0
fi

# Write the report — it is the diagnostic evidence for the ERRORS>0 failure
# below, not something to hide. NOTE: this line is never reached for a
# denial at a mount/AppRole ROOT (walk_kv / the auth/approle/role list) —
# those call fail() directly and exit before report assembly, so that
# specific failure mode pages with no JSON report to consult, only the
# ntfy/log text naming the mount. Atomic temp+mv (never a half-written file
# for a concurrent reader, e.g. rsyslog's imfile tail, to observe). The temp
# file is created by the same user/group the systemd unit runs this script
# as (User=/Group={{ openbao_group }}), and REPORT_PATH's parent
# (openbao_audit_log_dir, 0750 openbao:{{ openbao_group }}) is traversable
# by that group — so it lands group-readable with no extra chgrp needed.
report_tmp="$(mktemp "${REPORT_PATH}.XXXXXX")"
echo "${report_json}" >"${report_tmp}"
chmod 0640 "${report_tmp}"
mv -f "${report_tmp}" "${REPORT_PATH}"

# 5. FALSE-GREEN GUARD: a denied read is indistinguishable from an empty tree
# from inside a single `bao` call — a wrong/missing policy must never look
# like a clean "0 overdue" audit. Fail loud (urgent ntfy + hc /fail) instead.
if [ "${ERRORS}" -gt 0 ]; then
  fail "${ERRORS} denied read(s)/list(s) during the audit — see ${REPORT_PATH}"
fi

# 6. Notify. ONE urgent digest for every overdue item (never per-item — with
#    ~25 Doppler-issued AppRole secret-ids and 90-day KV paths already past
#    max_days on day one, per-item paging would open dozens of pages daily),
#    plus one default-priority digest for due. Both cap at 40 lines with a
#    "+N more" tail, and use a STABLE title so the downstream Zammad
#    correlation (topic|title) appends to one ticket instead of opening a new
#    one every cycle. Per-item detail already lives in the JSON/Splunk report.
#    Never includes a secret value — this AppRole cannot read one.
overdue_count="$(echo "${report_json}" | jq '[.items[] | select(.status=="overdue")] | length')"
due_count="$(echo "${report_json}" | jq '[.items[] | select(.status=="due")] | length')"

# digest_for_status <status> -> up to 40 "mount/path[#field] (Nd)" lines,
# newest-overdue-first is not required — report order is stable enough.
digest_for_status() {
  echo "${report_json}" | jq -r --arg status "$1" '
    [.items[] | select(.status==$status)] as $sel
    | ($sel | length) as $n
    | ($sel[:40] | map(.mount + "/" + .path + (if .field then "#" + .field else "" end) + " (" + (.age_days|tostring) + "d)")) as $lines
    | ($lines | join("\n")) + (if $n > 40 then "\n+\($n - 40) more" else "" end)'
}

if [ "${overdue_count}" -gt 0 ]; then
  ntfy_send urgent "rotating_light,key" "secrets overdue: ${overdue_count} item(s)" \
    "$(digest_for_status overdue)"
fi

if [ "${due_count}" -gt 0 ]; then
  ntfy_send default key "secret rotation due: ${due_count} item(s)" \
    "$(digest_for_status due)"
fi

log "audit OK: $(echo "${report_json}" | jq '[.items[] | select(.status=="ok")] | length') ok, ${due_count} due, ${overdue_count} overdue"
hc_ping ""
exit 0
