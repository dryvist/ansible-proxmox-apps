{{ ansible_managed | comment }}
# OpenBao policy for the apps AppRole — the shared-Postgres application tier
# (openbao_secrets domain "apps"). Read-only, generated from
# openbao_apps_read_apps (the union of the generated and promoted seeding maps)
# so the policy stays in lockstep with the seeded apps and never subsumes sibling
# domains that also live under apps/ (e.g. apps/media belongs to the media AppRole).

{% for app in openbao_apps_read_apps %}
path "{{ openbao_kv_mount }}/data/apps/{{ app }}" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/apps/{{ app }}" {
  capabilities = ["read", "list"]
}
{% endfor %}
# Exact-path exception (UniFi controller connection): the openbao_secrets
# "apps" domain also fetches secret/infrastructure/unifi (unpoller,
# unifi_metrics) — see roles/openbao_secrets/defaults/main/01-domains.yml.
# Read-only, single path, deliberately NOT an infrastructure/* wildcard: the
# apps AppRole must never gain read on the rest of the infrastructure/*
# subtree just to reach this one controller URL.
path "{{ openbao_kv_mount }}/data/infrastructure/unifi" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/infrastructure/unifi" {
  capabilities = ["read"]
}
