{{ ansible_managed | comment }}
# OpenBao policy for the approle-secret-id-rotate AppRole — INERT (no
# standing secret_id; see the AppRole row in
# defaults/main/07e-rotation-approles.yml), same human-gated shape as
# ai-rotate/apps-rotate: an operator wraps a single-use secret_id, this
# identity's own login unwraps it, and the resulting token lives exactly one
# rotation run (playbooks/openbao-rotate-approles.yml).
#
# Narrower than approle-issuer on purpose: approle-issuer may MINT a
# secret-id for every issuable role in the cluster, but holds neither the
# destroy capability nor the env-document write below — minting a fresh
# credential and retiring the old one, for the openbao_secrets domain roles
# ONLY, is a separate, smaller power from "can hand out a working credential
# for anything". Scoped to openbao_secrets_domain_approle_names by name, not
# a wildcard, so this identity cannot touch any other AppRole in the
# cluster.
{% for approle_name in openbao_secrets_domain_approle_names %}
path "auth/approle/role/{{ approle_name }}/role-id" {
  capabilities = ["read"]
}
path "auth/approle/role/{{ approle_name }}/secret-id" {
  capabilities = ["create", "update"]
}
path "auth/approle/role/{{ approle_name }}/secret-id/lookup" {
  capabilities = ["update"]
}
path "auth/approle/role/{{ approle_name }}/secret-id-accessor/destroy" {
  capabilities = ["update"]
}
{% endfor %}

# The one KV document holding these domains' OPENBAO_APPROLE_<NAME>_{ROLE,
# SECRET}_ID pairs (see roles/openbao_secrets/README.md "Inputs (env)").
# read+update, CAS write only (the rotation playbook always reads the
# current version and writes back with `options.cas` pinned to it) -- no
# `create`, so this identity can never seed the document into existence,
# only rotate an entry that is already there.
path "{{ openbao_kv_mount }}/data/platform/ansible/env" {
  capabilities = ["read", "update"]
}

path "{{ openbao_kv_mount }}/metadata/platform/ansible/env" {
  capabilities = ["read"]
}

# approle-secret-id-rotate-scheduled rotates its OWN secret_id last, each
# run, using this same policy's already-authenticated token, through the
# exact same tasks/openbao_rotate_one_domain.yml steps as a domain -- so it
# needs the same four grants, scoped to exactly its own role name, nothing
# wider. Its source-address CIDR binding is the control on a leaked pair,
# not this grant.
path "auth/approle/role/{{ openbao_approle_secret_id_rotate_scheduled_approle_name }}/role-id" {
  capabilities = ["read"]
}
path "auth/approle/role/{{ openbao_approle_secret_id_rotate_scheduled_approle_name }}/secret-id" {
  capabilities = ["create", "update"]
}
path "auth/approle/role/{{ openbao_approle_secret_id_rotate_scheduled_approle_name }}/secret-id/lookup" {
  capabilities = ["update"]
}
path "auth/approle/role/{{ openbao_approle_secret_id_rotate_scheduled_approle_name }}/secret-id-accessor/destroy" {
  capabilities = ["update"]
}
