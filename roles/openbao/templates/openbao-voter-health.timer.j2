{{ ansible_managed | comment }}
# Fire the OpenBao voter-health sweep every {{ openbao_voter_health_interval }}.
# Rendered by the openbao role.

[Unit]
Description=Sample OpenBao Raft-voter health every {{ openbao_voter_health_interval }}
Documentation=https://github.com/JacobPEvans/ansible-proxmox-apps

[Timer]
OnBootSec=120s
OnUnitActiveSec={{ openbao_voter_health_interval }}
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
