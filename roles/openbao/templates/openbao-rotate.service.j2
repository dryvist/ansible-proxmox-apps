{{ ansible_managed | comment }}
# {{ rotator.name }} credential rotation — one-shot, timer-driven. Rendered
# by the openbao role from the openbao_rotators table. No leader-gate: each
# mint (templates/rotators/{{ rotator.mint }}.sh.j2) is responsible for its
# own concurrency story (CAS write-back, adopt-or-fail on conflict).

[Unit]
Description=Rotate the {{ rotator.name }} credential
Documentation=https://github.com/JacobPEvans/ansible-proxmox-apps
After=openbao.service
Wants=openbao.service

[Service]
Type=oneshot
User={{ openbao_user }}
Group={{ openbao_group }}
# {{ rotator.approle }} AppRole role_id/secret_id (0600, root:openbao).
EnvironmentFile={{ openbao_config_dir }}/openbao-rotate-{{ rotator.name }}.env
ExecStart=/usr/local/bin/openbao-rotate-{{ rotator.name }}.sh
NoNewPrivileges=yes
