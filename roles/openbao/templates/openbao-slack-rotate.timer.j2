{{ ansible_managed | comment }}
# Check the Slack app-config token every {{ openbao_slack_rotate_interval }}
# and rotate it if it's within {{ openbao_slack_rotate_safety_margin }}s of
# expiry. Rendered by the openbao role.

[Unit]
Description=Check/rotate the Slack app-configuration token every {{ openbao_slack_rotate_interval }}
Documentation=https://github.com/JacobPEvans/ansible-proxmox-apps

[Timer]
# Start a few minutes after boot (let OpenBao come up first), then on a fixed
# cadence with jitter so a fleet of nodes doesn't fire in lockstep.
# Persistent=true runs a missed check promptly after downtime rather than
# waiting a full period, so a guest that was down still rotates promptly.
OnBootSec=300s
OnUnitActiveSec={{ openbao_slack_rotate_interval }}
RandomizedDelaySec=30m
AccuracySec=1m
Persistent=true

[Install]
WantedBy=timers.target
