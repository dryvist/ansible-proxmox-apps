{{ ansible_managed | comment }}
# Issuer policy: mint a secret_id for the inert unattended admin AppRole (15m,
# single use, bounds enforced by the role), read that role's role_id, and
# rotate the issuer identity's OWN secret_id: mint a replacement, then destroy
# the old one by value. Nothing else.
path "auth/approle/role/{{ openbao_github_admin_unattended_approle_name }}/secret-id" {
  capabilities = ["update"]
}

path "auth/approle/role/{{ openbao_github_admin_unattended_approle_name }}/role-id" {
  capabilities = ["read"]
}

path "auth/approle/role/{{ openbao_admin_issuer_approle_name }}/secret-id" {
  capabilities = ["update"]
}

path "auth/approle/role/{{ openbao_admin_issuer_approle_name }}/secret-id/destroy" {
  capabilities = ["update"]
}
