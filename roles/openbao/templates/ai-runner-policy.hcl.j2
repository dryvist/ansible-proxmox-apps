{{ ansible_managed | comment }}
# OpenBao policy for the `ai-runner` AppRole — the headless AI job-runner
# guest's dedicated, least-privilege reader (WS7A; consumed by the ai_runner
# role's openbao_secrets `ai-runner` domain in ansible-proxmox-ai). Read-only
# on exactly the dispatch credential plus two external provider-key leaves.
# All three are third-party secrets with no OpenBao secrets engine, so KV is
# the correct tier (.claude/rules/openbao-plugins-first.md). Exact paths only —
# no ai/* glob — so this credential can never widen to the rest of ai/*.
# The consumer reads known keys with vault_kv2_get and never enumerates, so no
# metadata list is granted (same rationale as ai-public).
path "{{ openbao_kv_mount }}/data/ai/vikunja" {
  capabilities = ["read"]
}
path "{{ openbao_kv_mount }}/metadata/ai/vikunja" {
  capabilities = ["read"]
}
{% for provider in ['anthropic', 'openai'] %}
path "{{ openbao_ai_api_key_mount }}/data/{{ openbao_ai_api_key_path_prefix }}/{{ provider }}" {
  capabilities = ["read"]
}
path "{{ openbao_ai_api_key_mount }}/metadata/{{ openbao_ai_api_key_path_prefix }}/{{ provider }}" {
  capabilities = ["read"]
}
{% endfor %}
