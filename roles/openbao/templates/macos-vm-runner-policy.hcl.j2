{{ ansible_managed | comment }}
# macos-vm-runner — the macOS VM runner host's standing identity. Mints ONLY
# the runner-tier permission sets, the same set the Linux runner identity
# mints (see github-runner-policy.hcl.j2 for the set scope and the `read`
# rationale). It carries no KV bucket and no other mount: the only other grant
# is token lookup-self, so the agent can introspect its own token.
{% for permission_set in openbao_github_permission_sets | selectattr('tier', 'equalto', 'runner') %}
path "{{ permission_set.mount }}/token/{{ permission_set.name }}" {
  capabilities = ["read", "create", "update"]
}

{% endfor %}
path "auth/token/lookup-self" {
  capabilities = ["read"]
}
