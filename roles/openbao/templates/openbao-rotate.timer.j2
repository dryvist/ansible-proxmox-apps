{{ ansible_managed | comment }}
# Check/rotate the {{ rotator.name }} credential every {{ rotator.interval }}.
# Rendered by the openbao role from the openbao_rotators table.

[Unit]
Description=Check/rotate the {{ rotator.name }} credential every {{ rotator.interval }}
Documentation=https://github.com/JacobPEvans/ansible-proxmox-apps

[Timer]
# Start a few minutes after boot (let OpenBao come up first), then on a fixed
# cadence with jitter so a fleet of nodes doesn't fire in lockstep.
# Persistent=true runs a missed check promptly after downtime rather than
# waiting a full period, so a guest that was down still rotates promptly.
OnBootSec=300s
OnUnitActiveSec={{ rotator.interval }}
RandomizedDelaySec=30m
AccuracySec=1m
Persistent=true

[Install]
WantedBy=timers.target
