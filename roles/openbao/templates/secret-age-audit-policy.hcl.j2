{{ ansible_managed | comment }}
# OpenBao policy for the secret-age-audit AppRole — a read-only sibling
# auditor that ages every KV secret and every AppRole secret_id. It reads
# freshness signals (custom_metadata.rotated_<field>, updated_time, secret_id
# accessor creation/expiration times) and NEVER a secret VALUE: there is no
# `data/` capability anywhere in this policy, on either KV mount.

path "{{ openbao_kv_mount }}/metadata/*" {
  capabilities = ["read", "list"]
}

path "secrets-external/metadata/*" {
  capabilities = ["read", "list"]
}

# Redundant with the globs above (a root LIST arrives as `<mount>/metadata/`
# with a trailing slash, which the `metadata/*` prefix rule already matches
# via ACL longest-prefix — not "does not match" as an earlier version of
# this comment claimed), kept explicit for readability rather than relying
# on that prefix behavior to cover the no-trailing-segment case too.
path "{{ openbao_kv_mount }}/metadata" {
  capabilities = ["list"]
}

path "secrets-external/metadata" {
  capabilities = ["list"]
}

# AppRole secret_id aging: list every role name first (`bao list
# auth/approle/role`, the enumeration root — without this the identity has
# no way to discover which roles exist and ages zero of them), then list the
# accessors under each one (their creation_time/expiration_time carry the
# age), and look one up by accessor. No `role-id` read — this identity ages
# credentials, it does not need the role_id half to do that.
path "auth/approle/role" {
  capabilities = ["list"]
}

path "auth/approle/role/+/secret-id" {
  capabilities = ["list"]
}

path "auth/approle/role/+/secret-id-accessor/lookup" {
  capabilities = ["update"]
}
