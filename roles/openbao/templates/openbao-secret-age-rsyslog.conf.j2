{{ ansible_managed | comment }}
# Ship the OpenBao secret-age report to Splunk:
#   {{ openbao_secret_age_report_path }}
#   -> {{ openbao_audit_syslog_host }}:{{ openbao_audit_syslog_port }} (tcp)
#   -> HAProxy -> Cribl Stream (ai_stamp) -> Splunk.
#
# A DEDICATED ruleset, same reasoning as the audit-log ruleset this mirrors:
# it keeps report lines OFF the default ruleset so they never also hit the
# syslog_forwarder catch-all and double-ship into the os index. The tag below
# (openbao-secret-age, distinct from openbao-audit) is what Splunk uses to
# route this to its own sourcetype rather than the audit one.
#
# The report is a single-line JSON document rewritten whole each run (atomic
# mktemp+mv, not appended in place) — each run produces a NEW inode at the
# same path. No `Mode=` is set below, same as the audit-log ruleset, so this
# runs in rsyslog's default `inotify` mode: it watches the DIRECTORY ENTRY,
# not the inode, and follows a rename-over transparently. `reopenOnTruncate`
# is kept because it is harmless and correct for the unrelated case of an
# in-place size decrease (e.g. a `copytruncate` logrotate policy landing on
# this path by mistake) — it is NOT what makes the mktemp+mv replacement
# work; the inotify directory watch is. Confirm empirically in staging (kill
# and replace the file, verify the next line ships) rather than trusting
# this comment alone.
#
# The imfile module load below is guarded: rsyslog rejects loading the same
# module twice, and the audit-log ruleset's drop-in (20-openbao-audit.conf,
# sorted before this file's 21-openbao-secret-age.conf) already loads it
# whenever ../audit.yml actually runs. Mirror its own include condition
# exactly (main/configure_and_bootstrap.yml) rather than just
# openbao_audit_enabled: audit.yml is ALSO skipped under Docker (no
# systemd/live API there, e.g. every Molecule scenario), so
# openbao_audit_enabled alone reads true while the audit drop-in never
# renders. Load it here only when that other drop-in won't have.
{% if not (openbao_audit_enabled | bool and (ansible_virtualization_type | default('') != 'docker')) %}
module(load="imfile")
{% endif %}

ruleset(name="openbao_secret_age") {
  action(type="omfwd"
         target="{{ openbao_audit_syslog_host }}"
         port="{{ openbao_audit_syslog_port }}"
         protocol="tcp"
         queue.type="LinkedList"
         queue.filename="openbao_secret_age_fwd"
         queue.maxDiskSpace="{{ openbao_audit_queue_max_disk_space }}"
         queue.saveOnShutdown="on"
         action.resumeRetryCount="-1"
         action.resumeInterval="1"
         RebindInterval="{{ openbao_audit_rebind_interval }}")
  stop
}

input(type="imfile"
      File="{{ openbao_secret_age_report_path }}"
      Tag="openbao-secret-age:"
      Severity="info"
      Facility="local6"
      reopenOnTruncate="on"
      Ruleset="openbao_secret_age")
