{{ ansible_managed | comment }}
# openbao-reconcile — the identity an unattended converge uses to keep this
# cluster's declared RBAC in step with the repository.
#
# It is NOT an admin tier and must never become one. The grants below are a
# wildcard across sys/policies/acl/* and auth/approle/role/*, with an exact-path
# `deny` stanza rendered for every excluded name. OpenBao's ACL evaluator picks
# the most-specific matching path when several rules could match a request; an
# exact path is more specific than a suffix glob regardless of write order, and
# `deny` always wins over any other capability set on the path it names
# (openbao.org/docs/concepts/policies: "most-specific match", and "[deny]
# always takes precedence regardless of any other defined capabilities").
# The exclusions are rendered from ONE variable, openbao_reconcile_excluded_policies
# — never a second hand-kept list — so the deny set can't drift from the set
# 08-rbac-policies.yml/10-approles.yml already treat as unmanaged.
#
# Three exclusions are what make this safe, and all are load-bearing:
#
#   1. The break-glass tiers are excluded. This identity cannot create or
#      rewrite them, so it can never mint itself break-glass.
#   2. Its OWN policy is excluded. It cannot widen its own grant.
#   3. The approle-issuer policy is excluded, and this identity holds NO
#      secret-id endpoint of its own. Minting a credential for another
#      identity is a separate power on a separate credential
#      (approle-issuer-policy.hcl.j2); a leaked reconcile secret_id
#      reconciles declarations, it does not manufacture credentials.
#
# The consequence: a newly declared, non-excluded policy or AppRole name is
# reachable the moment it is declared — no break-glass run needed to widen
# this identity's own grant first. Adding a name to the EXCLUDED set still
# needs a human-run edit here (a deny stanza rendered from a variable this
# identity cannot write, since its own policy is one of the excluded names),
# which is exactly the decision that should stay gated.
#
# If this identity is revoked, provisioning skips cleanly rather than failing;
# the cluster keeps serving, it just stops reconciling until someone restores it.

{% set breakglass = openbao_reconcile_excluded_policies | default([]) %}

# --- Policies: wildcard, with the excluded set denied by exact path ------
path "sys/policies/acl/*" {
  capabilities = ["create", "read", "update"]
}
{% for policy_name in breakglass %}
path "sys/policies/acl/{{ policy_name }}" {
  capabilities = ["deny"]
}
{% endfor %}
# Listing is read-only and makes drift visible without granting a write.
path "sys/policies/acl" {
  capabilities = ["list"]
}

# --- AppRoles: wildcard, with the excluded set denied by exact path ------
# Roles carrying manage_secret_id: false are the inert, human-gated tiers.
# They are covered by the same deny set as the policies above — the AppRole
# half of openbao_reconcile_excluded_policies — so there is still exactly one
# list to keep in step, not a marker plus a list.
path "auth/approle/role/*" {
  capabilities = ["create", "read", "update"]
}
path "auth/approle/role/*/role-id" {
  capabilities = ["read"]
}
path "auth/approle/role/*/policies" {
  capabilities = ["create", "update"]
}
{% for approle_name in breakglass %}
path "auth/approle/role/{{ approle_name }}" {
  capabilities = ["deny"]
}
path "auth/approle/role/{{ approle_name }}/role-id" {
  capabilities = ["deny"]
}
path "auth/approle/role/{{ approle_name }}/policies" {
  capabilities = ["deny"]
}
{% endfor %}
# Listing names only (no role definitions, no credentials) is how the converge
# notices an AppRole that exists in the store but was never declared — see
# 10d-approle-undeclared-live.yml. Read-only, same reasoning as the policy
# list line.
path "auth/approle/role" {
  capabilities = ["list"]
}

# --- SSH signing roles, by name ------------------------------------------
# Without these the identity cannot perform the SSH-role reconcile, which is
# one of the jobs it exists to do — and the omission would only surface as a
# 403 partway through a converge nobody was watching. Enumerated by name for
# the same reason as everything else here: `{{ openbao_ssh_mount }}/roles/*`
# would let it invent a role with any principal it liked, including one the
# host CA trusts for root.
{% for ssh_role in openbao_ssh_roles %}
path "{{ openbao_ssh_mount }}/roles/{{ ssh_role.name }}" {
  capabilities = ["create", "read", "update"]
}
{% endfor %}

# --- Mounts, by name -----------------------------------------------------
# Read-only on the mount table: the converge needs to see what exists to be
# add-if-missing. Creating or tuning a mount needs sudo, which is break-glass.
path "sys/mounts" {
  capabilities = ["read", "list"]
}
path "sys/auth" {
  capabilities = ["read", "list"]
}

# --- Engine content the converge seeds -----------------------------------
{% for mount in openbao_kv_mounts | default([]) %}
path "{{ mount.path | default(mount) }}/*" {
  capabilities = ["create", "read", "update", "list"]
}
# The rotation-exempt marker (tasks/tag_rotation_exempt.yml) is a metadata
# PATCH. This longer prefix REPLACES the wildcard's list for metadata/, so it
# re-states read+list and deliberately drops create/update: nothing here PUTs
# metadata, and a full metadata write carries the version-destroy knobs.
# `allowed_parameters` confines the PATCH body to `custom_metadata` for the
# same reason the rotator policies do (see apps-rotate-policy.hcl.j2).
path "{{ mount.path | default(mount) }}/metadata/*" {
  capabilities       = ["read", "list", "patch"]
  allowed_parameters = { "custom_metadata" = [] }
}
{% endfor %}
# Permission sets are named objects on the GitHub engine, not the raw token
# endpoint — minting a token is a consumer's job, never the reconciler's.
path "{{ openbao_github_mount }}/permissionset/*" {
  capabilities = ["create", "read", "update", "list"]
}
