{{ ansible_managed | comment }}
# {{ rotator.name }} rotation credentials — the least-privilege
# `{{ rotator.approle }}` AppRole. 0600, root:openbao. Consumed by the
# openbao-rotate-{{ rotator.name }}.service systemd unit via EnvironmentFile;
# never inlined into the script or the unit (keeps it out of `systemctl show`
# and `ps`).
OPENBAO_APPROLE_{{ rotator.approle | upper | replace('-', '_') }}_ROLE_ID={{ rotator.role_id }}
OPENBAO_APPROLE_{{ rotator.approle | upper | replace('-', '_') }}_SECRET_ID={{ rotator.secret_id }}
