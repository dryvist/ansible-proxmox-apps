# Terrakube workspace policy for {{ item.workspace.name }}. The matching JWT role binds
# the exact organization/workspace subject before this policy can be issued.
path "auth/token/lookup-self" {
  capabilities = ["read"]
}

path "auth/token/renew-self" {
  capabilities = ["update"]
}

path "auth/token/revoke-self" {
  capabilities = ["update"]
}
{% for path in item.workspace.kv_read | default([]) %}

path "{{ openbao_kv_mount }}/data/{{ path }}" {
  capabilities = ["read"]
}
{% endfor %}
{% for path in item.workspace.kv_read_external | default([]) %}

# Dual-mount during the secrets-external migration — secrets-external is a
# literal mount name here, not openbao_kv_mount (that var is internal-only).
path "secrets-external/data/{{ path }}" {
  capabilities = ["read"]
}
{% endfor %}
{% for path in item.workspace.kv_write | default([]) %}

path "{{ openbao_kv_mount }}/data/{{ path }}" {
  capabilities = ["create", "read", "update"]
}
{% endfor %}
{% for path in item.workspace.api_update | default([]) %}

path "{{ path }}" {
  capabilities = ["read", "update"]
}
{% endfor %}
{% for permission_set in item.workspace.github_mint | default([]) %}

# Ephemeral GitHub App installation token, minted per run. Same capability
# shape as the github-mint base policy. A workspace that lists a set here does
# NOT also get a stored token: minting is the alternative to holding one, so a
# `github_mint` entry should arrive in the same change that removes the
# workspace's kv_read of a static GitHub credential, never alongside it.
path "{{ openbao_github_mount }}/token/{{ permission_set }}" {
  capabilities = ["create", "update"]
}
{% endfor %}
