{{ ansible_managed | comment }}
# {{ item.name }} — a WRITE realm limited to its own repository allowlist.
#
# A realm identity cannot mint outside its allowlist. The general write
# identity can reach these repositories when its App installation includes
# them. Separate App installations provide isolation from that identity.
#
# Realm constraints:
#
#   * required_parameters makes an unconstrained (full-installation) request
#     impossible.
#   * allowed_parameters pins installation_id and repositories to exact string
#     literals. NEVER a glob — the ACL cannot element-match list-valued
#     parameters, so the wrapper sends a comma-capable STRING, and a prefix
#     glob would let "<allowed>,<not-allowed>" ride through the plugin's comma
#     split. Listing any key denies every unlisted one, so org_name and
#     repository_ids are denied by construction.
#   * `permissions` is allowed with any value: GitHub only narrows a token
#     below the App's grant, so a map can reduce a token and never widen it.
path "{{ openbao_github_everyday_mount }}/token" {
  capabilities = ["create", "update"]
  required_parameters = ["installation_id", "repositories"]
  allowed_parameters = {
    "installation_id" = [
      "{{ openbao_github_everyday_dryvist_installation_id }}",
      "{{ openbao_github_everyday_personal_installation_id }}"
    ]
    "repositories" = [
{% for repo in item.repos %}
      "{{ repo }}"{{ "," if not loop.last }}
{% endfor %}
    ]
    "permissions" = []
  }
}

# The write-lease lock subtree is shared with github-write rather than split
# per realm. A lease is mutual-exclusion bookkeeping, not a privilege: the
# minting boundary is the pinned `repositories` parameter above. Splitting the
# subtree would let a realm holder and a github-write holder each believe they
# hold the same repository's lease.
path "{{ openbao_kv_mount }}/data/locks/github-write/*" {
  capabilities = ["create", "read", "update", "delete"]
}

path "{{ openbao_kv_mount }}/metadata/locks/github-write/*" {
  capabilities = ["create", "read", "update", "list", "delete"]
}
