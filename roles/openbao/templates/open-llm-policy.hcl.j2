{{ ansible_managed | comment }}
# OpenBao policy for the open-llm AppRole — the untrusted-tier dispatcher.
# Exactly two grants:
#
#   * read its own bucket, secret/apps/open-llm (exact path, no wildcard);
#   * mint GitHub tokens from the raw {{ openbao_github_agents_mount }}/token
#     endpoint, pinned to the one installation of that mount's App. The App's
#     installation repository list is the repository scope and its permission
#     grant is the ceiling; GitHub refuses a token naming a repository outside
#     the installation. Listing allowed_parameters denies every unlisted key,
#     so org_name and repository_ids (alternate installation and repository
#     selectors) are refused. Every other GitHub mount is unreachable.
#
# No KV write, no other secret path, no other mount. With no installation ID
# configured the mint grant does not render.

path "{{ openbao_kv_mount }}/data/apps/open-llm" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/apps/open-llm" {
  capabilities = ["read"]
}
{% if openbao_github_agents_installation_id | length > 0 %}

path "{{ openbao_github_agents_mount }}/token" {
  # The plugin's token path has no existence check, so a mint routes as
  # create; github-write-policy.hcl.j2 records the same requirement.
  capabilities = ["create", "update"]
  required_parameters = ["installation_id", "repositories"]
  allowed_parameters = {
    "installation_id" = ["{{ openbao_github_agents_installation_id }}"]
    "repositories" = []
    "permissions" = []
  }
}
{% endif %}
