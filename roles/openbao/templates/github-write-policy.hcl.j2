{{ ansible_managed | comment }}
# github-write — installation-scoped WRITE minting, parameter-pinned. This is the
# ONE policy allowed to touch the raw {{ openbao_github_everyday_mount }}/token endpoint,
# and the parameter pinning is the entire privilege boundary:
#
#   * required_parameters forces every request to name an installation AND a
#     repositories value. The selector may cover any installed repositories,
#     including multiple repositories or the full installation.
#   * allowed_parameters restricts installation_id to the two known
#     installations. GitHub's App installation selects the repositories.
#     Listing any key denies all unlisted parameters, so org_name and
#     repository_ids are denied by construction.
#   * `permissions` is allowed with any value. GitHub only narrows an
#     installation token's permissions below the App's grant, so a map can
#     reduce a token and never widen it; the App grant stays the ceiling. The
#     credential helper sends a fixed minimal map on every write mint.
#
# The write-lease lock subtree implements claim-before-work (see
# session-coordination): the wrapper CAS-acquires
# secret/locks/github-write/<installation_id>/<repo> before minting, so two
# agents cannot hold the same repo. KV-v2 delete_version_after is the deadman.
path "{{ openbao_github_everyday_mount }}/token" {
  # "create" is required, not belt-and-suspenders: the plugin's token paths
  # have no existence check, so POST routes as CreateOperation — an
  # update-only grant returns "permission denied" on every mint (verified
  # live 2026-07-18; sys/capabilities-self still reports the path as usable,
  # which makes the omission invisible until a real mint is attempted).
  capabilities = ["create", "update"]
  required_parameters = ["installation_id", "repositories"]
  allowed_parameters = {
    # String forms only: the JSON-number form matches neither a quoted nor an
    # unquoted policy value, so listing numbers is dead weight that reads as
    # a live grant.
    "installation_id" = [
      "{{ openbao_github_everyday_dryvist_installation_id }}",
      "{{ openbao_github_everyday_personal_installation_id }}"
    ]
    "repositories" = []
    "permissions" = []
  }
}

# Write-lease lock records (claim/extend/release + metadata for
# delete_version_after and CAS versioning). Scoped to the github-write lock
# subtree only — no other KV path.
path "{{ openbao_kv_mount }}/data/locks/github-write/*" {
  capabilities = ["create", "read", "update", "delete"]
}

path "{{ openbao_kv_mount }}/metadata/locks/github-write/*" {
  capabilities = ["create", "read", "update", "list", "delete"]
}
