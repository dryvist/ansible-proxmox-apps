{{ ansible_managed | comment }}
# OpenBao policy for the semaphore AppRole — the DELTA over ansible-converge,
# not a replacement for it. The semaphore AppRole attaches both: every path a
# converge already reads comes from ansible-converge-policy.hcl.j2, and this
# file adds only what a Semaphore-driven run needs on top. Splitting it this
# way keeps one consumer inventory rather than two copies that drift.
#
# Why a separate identity at all, when the same playbooks run from a laptop
# under ansible-converge: the two callers are not equally trusted. A Semaphore
# run is unattended, triggered by anyone who can reach the web UI or its API,
# and its bootstrap credential sits in a database on the platform VM. A laptop
# run is a human at a terminal holding secret-zero. Giving them one identity
# means the unattended path silently inherits every grant the interactive one
# ever gains.
#
# ENUMERATED exact paths only — no platform/* or apps/* wildcard, matching the
# ansible-converge convention. Each entry names the call site that reads it; a
# path with no named consumer does not belong here.
#
#   platform/splunk/main
#     ansible-splunk's converge reads the Splunk and Splunkbase credentials it
#     used to receive as ambient environment variables from a laptop secrets
#     manager. Read-only: these are provisioned out of band and a converge must
#     never rewrite the account it authenticates as. Call sites:
#       ansible-splunk  playbooks/site.yml                       (SPLUNK_PASSWORD,
#                                                                 SPLUNK_HEC_TOKEN,
#                                                                 HEC_NAMESPACE)
#       ansible-splunk  playbooks/tasks/sync-splunkbase/preflight.yml
#                                                                (SPLUNKBASE_USERNAME,
#                                                                 SPLUNKBASE_PASSWORD)
#
#   apps/splunkbase-mirror
#     The bucket-scoped read-write object-storage key the Splunkbase mirror
#     writes add-ons with. Deliberately NOT platform/object-storage/main: that
#     path holds the object store's ROOT credentials, which authorize every
#     bucket. One bucket per workload, one key pair per bucket — an unattended
#     mirror job has no business holding root. Call site:
#       ansible-splunk  playbooks/sync-splunkbase.yml            (s3_env)

path "{{ openbao_kv_mount }}/data/platform/splunk/main" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/platform/splunk/main" {
  capabilities = ["read", "list"]
}

path "{{ openbao_kv_mount }}/data/apps/splunkbase-mirror" {
  capabilities = ["read"]
}

path "{{ openbao_kv_mount }}/metadata/apps/splunkbase-mirror" {
  capabilities = ["read", "list"]
}
