{{ ansible_managed | comment }}
# Slack app-config rotation credentials — the least-privilege `slack-admin`
# AppRole (read+update on exactly secrets-external/data/platform/slack-admin).
# 0600, root:openbao. Consumed by the openbao-slack-rotate.service systemd
# unit via EnvironmentFile; never inlined into the script or the unit (keeps
# it out of `systemctl show` and `ps`). Named identically to the env vars the
# macOS on-demand wrapper (nix-darwin openbao-slack-creds) reads, so a single
# Doppler-held pair serves both consumers.
OPENBAO_APPROLE_SLACK_ADMIN_ROLE_ID={{ openbao_slack_rotate_role_id }}
OPENBAO_APPROLE_SLACK_ADMIN_SECRET_ID={{ openbao_slack_rotate_secret_id }}
