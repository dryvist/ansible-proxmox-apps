{{ ansible_managed | comment }}
[Unit]
Description=Reconcile pull requests across configured owners
After=network-online.target openbao-pr-reconcile-agent.service
Wants=network-online.target
Requires=openbao-pr-reconcile-agent.service

[Service]
Type=oneshot
User={{ pr_reconcile_user }}
Group={{ pr_reconcile_group }}
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=true
ReadWritePaths={{ pr_reconcile_runtime_dir }} {{ pr_reconcile_metrics_dir }}
EnvironmentFile={{ pr_reconcile_fence_env_file }}
Environment=BAO_ADDR={{ pr_reconcile_bao_addr }}
Environment=BAO_TOKEN_FILE={{ pr_reconcile_bao_token_file }}
Environment=PR_RECONCILE_OWNERS={{ pr_reconcile_owners | map(attribute='owner') | join(',') }}
Environment=PR_RECONCILE_TOKEN_DIR={{ pr_reconcile_runtime_dir }}
Environment=PR_RECONCILE_METRICS_FILE={{ pr_reconcile_metrics_file }}
ExecStartPre={{ pr_reconcile_mint_bin }}
ExecStart={{ pr_reconcile_tick_bin }}
ExecStopPost=/usr/bin/find {{ pr_reconcile_runtime_dir }} -mindepth 1 -maxdepth 1 -type f -not -name {{ pr_reconcile_bao_token_file | basename }} -delete
TimeoutStartSec=15m
