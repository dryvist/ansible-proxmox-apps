{{ ansible_managed | comment }}
[Unit]
Description=OpenBao Agent for pull-request reconcile token minting
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User={{ pr_reconcile_user }}
Group={{ pr_reconcile_group }}
RuntimeDirectory=pr-reconcile
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ProtectHome=true
ReadWritePaths={{ pr_reconcile_runtime_dir }}
ExecStart={{ pr_reconcile_bao_bin }} agent -config={{ pr_reconcile_config_dir }}/openbao-agent.hcl
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
