---
# Rendered by roles/unifi_insights_docker. Holds secrets: mode 0600.
services:
  unifi-insights:
    image: {{ unifi_insights_docker_image }}
    container_name: unifi-insights
    restart: {{ unifi_insights_docker_restart_policy }}
    environment:
      POSTGRES_PASSWORD: {{ unifi_insights_docker_postgres_password | to_json }}
      SECRET_KEY: {{ unifi_insights_docker_secret_key | to_json }}
      TZ: {{ unifi_insights_docker_tz | to_json }}
      LOG_LEVEL: {{ unifi_insights_docker_log_level | to_json }}
      AUTH_ENABLED: {{ unifi_insights_docker_auth_enabled | to_json }}
{% if unifi_insights_docker_unifi_api_key | length > 0 %}
      UNIFI_HOST: {{ unifi_insights_docker_unifi_host | to_json }}
      UNIFI_SITE: {{ unifi_insights_docker_unifi_site | to_json }}
      UNIFI_VERIFY_SSL: {{ unifi_insights_docker_unifi_verify_ssl | to_json }}
      UNIFI_API_KEY: {{ unifi_insights_docker_unifi_api_key | to_json }}
{% endif %}
    ports:
      - "{{ unifi_insights_docker_web_port }}:{{ unifi_insights_docker_web_container_port }}"
      - "{{ unifi_insights_docker_syslog_port }}:{{ unifi_insights_docker_syslog_container_port }}/udp"
    volumes:
      - pgdata:/var/lib/postgresql/data
      - ./maxmind:/app/maxmind

volumes:
  pgdata:
