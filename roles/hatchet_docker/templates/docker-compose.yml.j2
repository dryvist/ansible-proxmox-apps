---
# Hatchet Lite control plane. PostgreSQL supplies durable state and the
# message queue; RabbitMQ is not required for this low-volume deployment.
services:
  hatchet:
    image: {{ hatchet_docker_image }}
    container_name: "{{ hatchet_docker_container_name }}"
    environment:
      DATABASE_POSTGRES_HOST: "{{ hatchet_docker_db_host }}"
      DATABASE_POSTGRES_PORT: "{{ hatchet_docker_db_port }}"
      DATABASE_POSTGRES_USERNAME: "{{ hatchet_docker_db_user }}"
      DATABASE_POSTGRES_PASSWORD: {{ (hatchet_docker_db_password | replace('$', '$$')) | to_json }}
      DATABASE_POSTGRES_DB_NAME: "{{ hatchet_docker_db_name }}"
      DATABASE_POSTGRES_SSL_MODE: "{{ hatchet_docker_db_ssl_mode }}"
      SERVER_MSGQUEUE_KIND: postgres
      SERVER_MSGQUEUE_PUBSUB_KIND: postgres
      SERVER_AUTH_COOKIE_SECRETS: {{ (hatchet_docker_server_auth_cookie_secrets | replace('$', '$$')) | to_json }}
      SERVER_AUTH_COOKIE_DOMAIN: "{{ hatchet_docker_fqdn }}"
      SERVER_AUTH_COOKIE_INSECURE: "false"
      SERVER_AUTH_SET_EMAIL_VERIFIED: "true"
      SERVER_ENCRYPTION_MASTER_KEYSET: {{ (hatchet_docker_server_encryption_master_keyset | replace('$', '$$')) | to_json }}
      SERVER_ENCRYPTION_JWT_PRIVATE_KEYSET: {{ (hatchet_docker_server_encryption_jwt_private_keyset | replace('$', '$$')) | to_json }}
      SERVER_ENCRYPTION_JWT_PUBLIC_KEYSET: {{ (hatchet_docker_server_encryption_jwt_public_keyset | replace('$', '$$')) | to_json }}
      SERVER_URL: "{{ hatchet_docker_server_url }}"
      SERVER_ALLOW_SIGNUP: "false"
      SERVER_GRPC_BIND_ADDRESS: "0.0.0.0"
      SERVER_GRPC_PORT: "{{ hatchet_docker_grpc_container_port }}"
      # Traefik terminates worker TLS and forwards gRPC over h2c to this port.
      SERVER_GRPC_INSECURE: "true"
      SERVER_GRPC_BROADCAST_ADDRESS: "{{ hatchet_docker_engine_broadcast_address }}"
      ADMIN_EMAIL: "{{ hatchet_docker_admin_email }}"
      ADMIN_PASSWORD: {{ (hatchet_docker_admin_password | replace('$', '$$')) | to_json }}
      ADMIN_NAME: "{{ hatchet_docker_admin_name }}"
    ports:
      - "{{ hatchet_docker_web_port }}:{{ hatchet_docker_web_container_port }}"
      - "{{ hatchet_docker_grpc_port }}:{{ hatchet_docker_grpc_container_port }}"
    restart: {{ hatchet_docker_restart_policy }}
