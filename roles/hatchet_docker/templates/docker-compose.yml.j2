---
# Each Docker AI guest runs the dashboard and a full engine replica. PostgreSQL
# supplies shared workflow state and the Postgres-backed message queue.
x-hatchet-environment: &hatchet-environment
  DATABASE_POSTGRES_HOST: "{{ hatchet_docker_db_host }}"
  DATABASE_POSTGRES_PORT: "{{ hatchet_docker_db_port }}"
  DATABASE_POSTGRES_USERNAME: "{{ hatchet_docker_db_user }}"
  DATABASE_POSTGRES_PASSWORD: {{ (hatchet_docker_db_password | replace('$', '$$')) | to_json }}
  DATABASE_POSTGRES_DB_NAME: "{{ hatchet_docker_db_name }}"
  DATABASE_POSTGRES_SSL_MODE: "{{ hatchet_docker_db_ssl_mode }}"
  SERVER_MSGQUEUE_KIND: postgres
  SERVER_MSGQUEUE_PUBSUB_KIND: postgres
  SERVER_AUTH_COOKIE_SECRETS: {{ (hatchet_docker_server_auth_cookie_secrets | replace('$', '$$')) | to_json }}
  SERVER_AUTH_COOKIE_DOMAIN: "{{ hatchet_docker_fqdn }}"
  SERVER_AUTH_COOKIE_INSECURE: "false"
  SERVER_AUTH_SET_EMAIL_VERIFIED: "true"
  SERVER_ENCRYPTION_MASTER_KEYSET: {{ (hatchet_docker_server_encryption_master_keyset | replace('$', '$$')) | to_json }}
  SERVER_ENCRYPTION_JWT_PRIVATE_KEYSET: {{
    (hatchet_docker_server_encryption_jwt_private_keyset
     | replace('$', '$$')) | to_json }}
  SERVER_ENCRYPTION_JWT_PUBLIC_KEYSET: {{
    (hatchet_docker_server_encryption_jwt_public_keyset
     | replace('$', '$$')) | to_json }}
  SERVER_URL: "{{ hatchet_docker_server_url }}"
  SERVER_ALLOW_SIGNUP: "false"
  SERVER_GRPC_BIND_ADDRESS: "0.0.0.0"
  SERVER_GRPC_PORT: "{{ hatchet_docker_grpc_container_port }}"
  SERVER_GRPC_INSECURE: "true"
  SERVER_GRPC_BROADCAST_ADDRESS: "{{ hatchet_docker_engine_broadcast_address }}"
  SERVER_INTERNAL_CLIENT_INTERNAL_GRPC_BROADCAST_ADDRESS: "localhost:{{ hatchet_docker_grpc_container_port }}"
  SERVER_PORT: "{{ hatchet_docker_api_container_port }}"
  ADMIN_EMAIL: "{{ hatchet_docker_admin_email }}"
  ADMIN_PASSWORD: {{ (hatchet_docker_admin_password | replace('$', '$$')) | to_json }}
  ADMIN_NAME: "{{ hatchet_docker_admin_name }}"

services:
  hatchet-dashboard:
    image: {{ hatchet_docker_dashboard_image }}
    environment:
      <<: *hatchet-environment
      SERVER_INTERNAL_CLIENT_INTERNAL_GRPC_BROADCAST_ADDRESS: "hatchet-engine:{{ hatchet_docker_grpc_container_port }}"
    ports:
      - "{{ hatchet_docker_web_port }}:{{ hatchet_docker_ui_container_port }}"
    restart: {{ hatchet_docker_restart_policy }}
    depends_on:
      hatchet-engine:
        condition: service_healthy
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          wget -q -O /dev/null
          http://localhost:{{ hatchet_docker_api_container_port }}/api/ready || exit 1
      interval: 2s
      timeout: 5s
      retries: 5
      start_period: 5s

  hatchet-engine:
    image: {{ hatchet_docker_engine_image }}
    environment:
      <<: *hatchet-environment
      SERVER_SERVICES: all
    ports:
      - "{{ hatchet_docker_grpc_port }}:{{ hatchet_docker_grpc_container_port }}"
      - "{{ hatchet_docker_health_port }}:{{ hatchet_docker_health_container_port }}"
    restart: {{ hatchet_docker_restart_policy }}
    healthcheck:
      test:
        - CMD-SHELL
        - >-
          wget -q -O /dev/null
          http://localhost:{{ hatchet_docker_health_container_port }}/ready || exit 1
      interval: 2s
      timeout: 5s
      retries: 5
      start_period: 5s
{% if hatchet_docker_worker_enabled | default(false) | bool -%}
  hatchet-worker:
    image: {{ hatchet_docker_worker_image }}
    depends_on:
      hatchet-engine:
        condition: service_healthy
    environment:
      HATCHET_CLIENT_TOKEN: {{ (bao_apps_secrets.hatchet_worker_token
        | default(undef('hatchet_worker_token missing from bao_apps_secrets'), true)
        | mandatory('hatchet_worker_token is required when the Hatchet worker is enabled')
        | replace('$', '$$')) | to_json }}
      HATCHET_CLIENT_HOST_PORT: "{{ hatchet_docker_engine_broadcast_address }}"
      GPU_FILL_WORKER_CONFIG: /tmp/gpu-fill-worker.json
{% for worker_platform in hatchet_docker_worker_platforms %}
{% if worker_platform.auth_env | default(none) is not none %}
      {{ worker_platform.auth_env }}: {{ (bao_apps_secrets[worker_platform.auth_secret_key]
        | default(undef(worker_platform.auth_secret_key ~ ' missing from bao_apps_secrets'), true)
        | mandatory(worker_platform.auth_secret_key ~ ' is required for the Hatchet worker platform')
        | replace('$', '$$')) | to_json }}
{% endif %}
{% endfor %}
{% if hatchet_docker_eval_enabled | bool %}
      LANGFUSE_PUBLIC_KEY: {{ (bao_apps_secrets.hatchet_eval_langfuse_public_key
        | default(undef('hatchet_eval_langfuse_public_key missing from bao_apps_secrets'), true)
        | mandatory('hatchet_eval_langfuse_public_key is required when evals are enabled')
        | replace('$', '$$')) | to_json }}
      LANGFUSE_SECRET_KEY: {{ (bao_apps_secrets.hatchet_eval_langfuse_secret_key
        | default(undef('hatchet_eval_langfuse_secret_key missing from bao_apps_secrets'), true)
        | mandatory('hatchet_eval_langfuse_secret_key is required when evals are enabled')
        | replace('$', '$$')) | to_json }}
      LANGFUSE_HOST: "{{ hatchet_docker_eval_langfuse_host }}"
      LITELLM_BASE_URL: "{{ hatchet_docker_eval_litellm_base_url }}"
      LITELLM_API_KEY: {{ (bao_apps_secrets.hatchet_eval_litellm_api_key
        | default(undef('hatchet_eval_litellm_api_key missing from bao_apps_secrets'), true)
        | mandatory('hatchet_eval_litellm_api_key is required when evals are enabled')
        | replace('$', '$$')) | to_json }}
      AI_PROMPTS_DIR: "{{ hatchet_docker_eval_prompts_dir }}"
      SOURCE_COMMIT: "{{ hatchet_docker_eval_prompts_ref }}"
{% endif %}
    volumes:
      - "{{ hatchet_docker_data_dir }}/gpu_fill_worker:/app/gpu_fill_worker:ro"
      - "{{ hatchet_docker_data_dir }}/gpu_fill_worker_config.json:/tmp/gpu-fill-worker.json:ro"
{% if hatchet_docker_eval_enabled | bool %}
      - "{{ hatchet_docker_data_dir }}/ai-llm-prompts:{{ hatchet_docker_eval_prompts_dir }}:ro"
{% endif %}
    working_dir: /app/gpu_fill_worker
    # No Python SDK container pattern exists in this repo; install the pinned
    # SDK on startup, without retaining pip's download cache.
    command:
      - sh
      - -c
      - >-
        python -m pip install --no-cache-dir
        "hatchet-sdk=={{ hatchet_docker_worker_sdk_version }}"{% if hatchet_docker_eval_enabled | bool %}
        "langfuse=={{ hatchet_docker_eval_langfuse_version }}"
        "pyyaml=={{ hatchet_docker_eval_pyyaml_version }}"{% endif %} &&
        python /app/gpu_fill_worker/worker.py
    restart: {{ hatchet_docker_restart_policy }}
{% endif -%}
