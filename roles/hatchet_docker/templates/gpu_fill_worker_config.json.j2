{
  "roles": {{ hatchet_docker_worker_roles | to_json }},
  "platforms": {
{% for worker_platform in hatchet_docker_worker_platforms %}
    {{ worker_platform.name | to_json }}: {
{% if worker_platform.kind | default('') == 'chat' %}
      "kind": "chat",
      "base_url": {{ worker_platform.base_url | to_json }},
      "model": {{ worker_platform.model | to_json }},
      "max_tokens": {{ worker_platform.max_tokens | to_json }},
      "auth_env": {{ worker_platform.auth_env | to_json }},
      "timeout_s": {{ worker_platform.timeout_s | to_json }}
{% else %}
      "run_url": {{ worker_platform.run_url | to_json }},
      "auth_env": {{ (worker_platform.auth_env | default(none)) | to_json }},
      "timeout_s": {{ worker_platform.timeout_s | to_json }}
{% endif %}
    }{% if not loop.last %},{% endif %}
{% endfor %}
  }{% if hatchet_docker_worker_latency_guard_enabled | bool %},
  "latency_guard": {
    "prometheus_url": {{ hatchet_docker_worker_latency_guard_prometheus_url | to_json }},
    "query": {{ hatchet_docker_worker_latency_guard_query | to_json }},
    "max_ratio": {{ hatchet_docker_worker_latency_guard_max_ratio | to_json }}
  }{% endif %}
{% if hatchet_docker_worker_fill_enabled | default(false) | bool %},
  "fill": {
    "cron": {{ hatchet_docker_worker_fill_cron | to_json }},
    "corpus_dir": {{ hatchet_docker_worker_fill_corpus_dir | to_json }},
    "output_dir": {{ hatchet_docker_worker_fill_output_dir | to_json }},
    "roles": {{ hatchet_docker_worker_fill_roles | to_json }}
  }
{% endif %}
{% if hatchet_docker_eval_enabled | bool %},
  "evals": {
    "cron": {{ hatchet_docker_eval_cron | to_json }},
    "judges_sync_cron": {{ hatchet_docker_eval_judges_sync_cron | to_json }},
    "prompts_dir": {{ hatchet_docker_eval_prompts_dir | to_json }},
    "roles": {{ hatchet_docker_eval_roles | to_json }}
  }
{% endif %}
}
