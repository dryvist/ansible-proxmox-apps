{% if cribl_stream_otel_drop_span_names | length > 0 or cribl_stream_otel_drop_span_prefixes | length > 0 %}
  # Shared by every trace leg. Single-quoted YAML scalar: to_json emits double
  # quotes, which would end a double-quoted scalar early and render invalid YAML.
  - id: drop
    filter: '{{ cribl_stream_otel_drop_span_names | to_json }}.includes(name) || {{ cribl_stream_otel_drop_span_prefixes | to_json }}.some(p => String(name).startsWith(p))'
    disabled: false
    conf: {}
{% endif %}
