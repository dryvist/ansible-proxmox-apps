{% if cribl_stream_otel_drop_span_names | length > 0 or cribl_stream_otel_drop_span_prefixes | length > 0 %}
  # Shared by every trace leg. Single-quoted YAML scalar: to_json emits double
  # quotes, which would end a double-quoted scalar early and render invalid YAML.
  # Cribl expressions refuse declarations, arrow-function parameters included,
  # so each prefix is its own startsWith test.
  - id: drop
    filter: '{{ cribl_stream_otel_drop_span_names | to_json }}.includes(name){% for _prefix in cribl_stream_otel_drop_span_prefixes %} || String(name).startsWith({{ _prefix | to_json }}){% endfor %}'
    disabled: false
    conf: {}
{% endif %}
