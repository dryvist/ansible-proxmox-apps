# Keep only Grafana alert envelopes on the ntfy notification leg.
# The parallel Splunk leg on in_splunk_hec preserves the full HEC event.
output: default
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "sourcetype !== 'grafana:alert'"
    disabled: false
    conf: {}
