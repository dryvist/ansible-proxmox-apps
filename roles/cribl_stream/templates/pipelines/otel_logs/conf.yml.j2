# Splunk-metadata stamp for OTLP log records on the open_telemetry input.
# Generated by Ansible - do not edit manually
#
# Agent CLIs export per-request events (api_request, tool_result, ...) as
# OTLP logs alongside their spans. This leg keeps log records only and stamps
# them for the ai_usage index; spans stay on the otel_stamp leg. Every eval is
# conditional (`index || ...`): a producer that DID set index/sourcetype passes
# through untouched.
output: default
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "!__otlp || __otlp.type !== 'logs'"
    disabled: false
    conf: {}
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "index || 'ai_usage'"
        - name: sourcetype
          value: "sourcetype || 'otel:log'"
        - name: source
          value: "source || 'claude-code-otel'"
