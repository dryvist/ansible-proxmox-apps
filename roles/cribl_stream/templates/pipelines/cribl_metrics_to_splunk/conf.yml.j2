---
# Route Cribl's native platform metrics to the existing Splunk metrics index.
# Generated by Ansible.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "'host_metrics'"
        - name: sourcetype
          value: "sourcetype || 'cribl:metrics'"
