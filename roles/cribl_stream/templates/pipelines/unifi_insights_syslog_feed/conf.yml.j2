# UniFi gateway syslog -> UniFi Insights (syslog output unifi_insights_syslog).
# Generated by Ansible.
#
# Connection pipeline on the forwarded S2S stream (see inputs.yml.j2). The
# stream carries every sourcetype the Edge stamps. The leading native Drop
# keeps only the UniFi gateway syslog (sourcetype ubiquiti:*) and discards the
# rest, so the UniFi Insights VM receives nothing else. No other function runs,
# so kept events pass through unchanged. The raw-event, metric and HEC paths
# are separate connections and are not touched.
output: unifi_insights_syslog
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "!/^ubiquiti:/.test(sourcetype || '')"
    disabled: false
