---
# OTLP trace pipeline for the in_otel -> phoenix_otlp connection
# Generated by Ansible - do not edit manually
#
# Arize Phoenix leg. Phoenix reads the OTel GenAI / OpenInference attributes
# exactly as the producers emit them, so this is the Langfuse pipeline
# (otel_traces) MINUS the langfuse.*-prefixed identity, usage and trace-name
# rewrites — those keys mean nothing to Phoenix and would only bloat spans.
# What stays is everything that protects the destination or the data:
#   1. drop non-trace signals   (destination ingests traces only)
#   2. drop non-LLM plumbing    (keeps the trace viewer readable)
#   3. trim noise               (always-empty attrs, multi-KB stack traces)
#   4. redact credentials       (before content capture is ever enabled)
#
# Every list this template loops over is the SAME data the Langfuse leg reads
# from defaults/main.yml — one list, two legs, no second copy to drift.

output: phoenix_otlp
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  # 1. Traces only — anything else errors at the destination, retries, and
  # backs the persistent queue up until real spans stop flowing.
  - id: drop
    filter: "!__otlp || __otlp.type !== 'traces'"
    disabled: false
    conf: {}
{% if cribl_stream_otel_drop_span_names | length > 0 %}

  # 2. Non-LLM plumbing, dropped from both trace destinations.
  # Single-quoted YAML scalar: to_json emits double quotes, which would end a
  # double-quoted scalar early and render invalid YAML.
  - id: drop
    filter: '{{ cribl_stream_otel_drop_span_names | to_json }}.includes(name)'
    disabled: false
    conf: {}
{% endif %}

  # Consumer identity and bounded category tags are span-only enrichment.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: "attributes['session.id']"
          value: "attributes['session.id'] || attributes['litellm.metadata.session_id'] || undefined"
        - name: "attributes['user.id']"
          value: "attributes['user.id'] || attributes['litellm.metadata.trace_user_id'] || undefined"
        - name: "attributes['tag.tags']"
          value: "[...new Set([].concat(attributes['tag.tags'] || [], attributes['litellm.metadata.runner'], attributes['litellm.metadata.purpose']).filter(Boolean))]"

  # 3. Noise removal.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      remove:
{% for attr in (cribl_stream_otel_noise_attributes + cribl_stream_otel_drop_attributes) %}
        - "attributes['{{ attr }}']"
{% endfor %}

  # OpenInference metadata is JSON text. Existing valid fields survive; invalid
  # source metadata is marked explicitly, without copying its raw contents.
  - id: code
    filter: "true"
    disabled: false
    conf:
      code: >-
        var a = __e.attributes || {}, m = {};
        if (a.metadata) { try { m = typeof a.metadata === 'string' ?
        JSON.parse(a.metadata) : a.metadata;
        if (!m || typeof m !== 'object' || Array.isArray(m)) { throw new Error('metadata-object'); }
        } catch (err) { m = {}; a['litellm.metadata.invalid_json'] = true; } }
        var fields = {{ cribl_stream_otel_metadata_passthrough | to_json }};
        for (var k in fields) { var v = a[fields[k]];
        if (v !== undefined && v !== null) { m[k] = v; } }
        a.metadata = JSON.stringify(m);
        for (var k in a) { if (a[k] === undefined || a[k] === null) { delete a[k]; } }

  # 4. Credential redaction - see defaults/main.yml for the schema trap.
  - id: mask
    filter: "true"
    disabled: false
    conf:
      rules:
{% for rule in cribl_stream_secret_redaction_rules %}
        - matchRegex: '{{ rule.matchRegex }}'
          replaceExpr: "{{ rule.replaceExpr }}"
{% endfor %}
      fields:
{% for field in cribl_stream_otel_redaction_fields %}
        - '{{ field }}'
{% endfor %}
