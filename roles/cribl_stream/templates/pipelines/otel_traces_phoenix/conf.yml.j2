---
# OTLP trace pipeline for the in_otel -> phoenix_otlp connection
# Generated by Ansible - do not edit manually
#
# Arize Phoenix leg. Phoenix reads the OTel GenAI / OpenInference attributes
# exactly as the producers emit them, so this is the Langfuse pipeline
# (otel_traces) MINUS the langfuse.*-prefixed identity, usage and trace-name
# rewrites — those keys mean nothing to Phoenix and would only bloat spans.
# What stays is everything that protects the destination or the data:
#   1. drop non-trace signals   (destination ingests traces only)
#   2. drop non-LLM plumbing    (keeps the trace viewer readable)
#   3. trim noise               (always-empty attrs, multi-KB stack traces)
#   4. redact credentials       (before content capture is ever enabled)
#
# Every list this template loops over is the SAME data the Langfuse leg reads
# from defaults/main.yml — one list, two legs, no second copy to drift.

output: phoenix_otlp
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  # 1. Traces only — anything else errors at the destination, retries, and
  # backs the persistent queue up until real spans stop flowing.
  - id: drop
    filter: "!__otlp || __otlp.type !== 'traces'"
    disabled: false
    conf: {}
{% if cribl_stream_otel_drop_span_names | length > 0 %}

  # 2. Non-LLM plumbing, dropped from this leg only (Splunk keeps it).
  # Single-quoted YAML scalar: to_json emits double quotes, which would end a
  # double-quoted scalar early and render invalid YAML.
  - id: drop
    filter: '{{ cribl_stream_otel_drop_span_names | to_json }}.includes(name)'
    disabled: false
    conf: {}
{% endif %}

  # 3. Noise removal.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      remove:
{% for attr in (cribl_stream_otel_noise_attributes + cribl_stream_otel_drop_attributes) %}
        - "attributes['{{ attr }}']"
{% endfor %}

  # 4. Credential redaction - see defaults/main.yml for the schema trap.
  - id: mask
    filter: "true"
    disabled: false
    conf:
      rules:
{% for rule in cribl_stream_otel_redaction_rules %}
        - matchRegex: '{{ rule.matchRegex }}'
          replaceExpr: "{{ rule.replaceExpr }}"
{% endfor %}
      fields:
{% for field in cribl_stream_otel_redaction_fields %}
        - '{{ field }}'
{% endfor %}
