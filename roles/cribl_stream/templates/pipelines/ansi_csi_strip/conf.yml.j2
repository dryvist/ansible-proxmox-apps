---
# Shared source pre-processing: remove ANSI CSI sequences before each input's
# connection pipeline or any destination is selected.
# Generated by Ansible - do not edit manually.
output: default
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: mask
    filter: "true"
    disabled: false
    conf:
      rules:
        - matchRegex: '/{{ cribl_stream_ansi_csi_pattern }}/g'
          replaceExpr: "''"
      fields:
        - _raw
        - "*"
      depth: 5
