---
# Original LLM spans become native metrics on an independent input connection.
# Trace stores retain their existing pipelines, sampling, and identity handling.
output: victoriametrics_rw
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  # Tagged root spans reach the run count even when they have no GenAI fields.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: agent_tag_present
          value: >-
            (__e.attributes && typeof __e.attributes.agent === 'string' &&
            __e.attributes.agent.trim().length > 0) ||
            (__e.attributes && typeof __e.attributes['litellm.metadata.agent'] === 'string' &&
            __e.attributes['litellm.metadata.agent'].trim().length > 0) ||
            (typeof __e.agent === 'string' && __e.agent.trim().length > 0)
        - name: is_root_span
          value: >-
            !!(__e.__otlp && __e.__otlp.type === 'traces' &&
            !(__e.parentSpanId || __e.parent_span_id))
  - id: drop
    filter: "!__e.__otlp || __e.__otlp.type !== 'traces'"
    disabled: false
    conf: {}
  - id: drop
    filter: >-
      !/(^|,)gen_ai\./.test(Object.keys(__e.attributes || {}).join(',')) &&
      !(agent_tag_present === true && is_root_span === true)
    disabled: false
    conf: {}
  # Flat names avoid treating dotted GenAI attribute names as object paths.
{{ lookup('ansible.builtin.template', cribl_stream_role_dir ~ '/templates/pipelines/agent_tags.yml.j2') }}
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: service_name
          value: "attributes['service.name']"
{% for tag in cribl_stream_otel_run_tags %}
        - name: {{ tag }}
          value: "attributes['{{ tag }}']"
{% endfor %}
        - name: system
          value: "attributes['gen_ai.system']"
        - name: status
          value: >-
            [2, 'ERROR', 'STATUS_CODE_ERROR'].includes((__e.status || {}).code) ? 'error' :
            [1, 'OK', 'STATUS_CODE_OK'].includes((__e.status || {}).code) ? 'ok' : 'unset'
        - name: input_tokens
          value: >-
            /^\d+$/.test(String(attributes['gen_ai.usage.input_tokens']))
            ? Number(attributes['gen_ai.usage.input_tokens']) : undefined
        - name: output_tokens
          value: >-
            /^\d+$/.test(String(attributes['gen_ai.usage.output_tokens']))
            ? Number(attributes['gen_ai.usage.output_tokens']) : undefined
        # Subtract integer nanoseconds before converting to avoid epoch rounding.
        - name: duration_seconds
          value: >-
            /^\d+$/.test(String(__e.start_time_unix_nano ?? __e.startTimeUnixNano)) &&
            /^\d+$/.test(String(__e.end_time_unix_nano ?? __e.endTimeUnixNano))
            ? Number(BigInt(__e.end_time_unix_nano ?? __e.endTimeUnixNano) -
            BigInt(__e.start_time_unix_nano ?? __e.startTimeUnixNano)) / 1e9 : undefined
  - id: aggregation
    filter: >-
      __e.__otlp && __e.__otlp.type === 'traces' &&
      /(^|,)gen_ai\./.test(Object.keys(__e.attributes || {}).join(','))
    disabled: false
    conf:
      # Preserve grouped fields as metric dimensions. Passthrough feeds source
      # spans to the run counter; the final drop keeps spans out of the output.
      passthrough: true
      preserveGroupBys: true
      metricsMode: true
      cumulative: false
      flushOnInputClose: false
      timeWindow: 10s
      groupbys:
        - service_name
{% for tag in cribl_stream_otel_run_tags %}
        - {{ tag }}
{% endfor %}
        - system
        - status
      aggregations:
        - "count().as(llm_span_calls)"
        - "count().where(status === 'error').as(llm_span_errors)"
        - "sum(input_tokens).where(Number.isFinite(input_tokens)).as(llm_span_input_tokens)"
        - "sum(output_tokens).where(Number.isFinite(output_tokens)).as(llm_span_output_tokens)"
        - >-
          histogram(duration_seconds, [0.05,0.1,0.25,0.5,1,2.5,5,10,30,60,120])
          .where(Number.isFinite(duration_seconds) && duration_seconds >= 0).as(llm_span_duration_seconds)
  # Count one run from each root span that carried an explicit agent tag.
  - id: aggregation
    filter: >-
      __e.__otlp && __e.__otlp.type === 'traces' &&
      agent_tag_present === true && is_root_span === true
    disabled: false
    conf:
      passthrough: false
      preserveGroupBys: true
      metricsMode: true
      cumulative: false
      flushOnInputClose: false
      timeWindow: 10s
      groupbys:
        - agent
        - tier
        - status
      aggregations:
        - "count().as(agent_runs)"
  # Discard the original spans after both aggregations have consumed them.
  - id: drop
    filter: "__e.__otlp && __e.__otlp.type === 'traces'"
    disabled: false
    conf: {}
