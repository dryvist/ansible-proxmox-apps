---
# NetFlow/IPFIX -> unifi_vlan_bytes_total{vlan,direction} and
# unifi_wan_bytes_total{direction}. Generated by Ansible.
#
# CAVEAT (verified against live Splunk index=netflow, 2026-09-25): what
# currently arrives on in_ipfix is a low-volume (~11 events/24h) trickle of
# NetFlow v5 records (inputInt/outputInt always 0), not the v10/IPFIX export
# the UDW desired state declares (tofu-unifi gateway-telemetry.tf). No
# interface/VLAN-bearing field has been observed live, so vlan_id below
# resolves to '0' ("Default"/unmapped) for every real event today. The
# pipeline is written against Cribl's documented netflow/IPFIX field names
# (docs.cribl.io/stream/sources-netflow/) so it is correct the day real
# per-VLAN flow export is enabled; it cannot be verified end-to-end until
# then.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        # inputSnmp/outputSnmp (IPFIX) or inputInt/outputInt (NetFlow v5) carry
        # the ingress/egress interface index. UniFi does not publish an
        # interface-index-to-VLAN map, so this pipeline treats the interface
        # index itself as the VLAN id — correct once the gateway's IPFIX
        # export tags per-VLAN sub-interfaces by VLAN id, the common UDW/EdgeOS
        # convention (brN, N = VLAN id).
        - name: vlan_id
          value: >-
            String(inputSnmp || inputInt || outputSnmp || outputInt || 0)
        - name: direction
          value: >-
            (direction === 1 || (outputSnmp || outputInt || 0) > 0) ? 'egress' : 'ingress'
        - name: flow_bytes
          value: >-
            Number(inBytes || outBytes || octets || 0)
        - name: is_wan
          # The WAN network carries no cidr_key VLAN id in the published list
          # (it is the uplink, not a tagged LAN VLAN) — treat interface index
          # 0 (the default/no-VLAN-tag path NetFlow v5 reports today) as WAN
          # until real per-VLAN export supplies a non-zero index.
          value: "vlan_id === '0'"
  - id: lookup
    filter: "true"
    disabled: false
    conf:
      file: unifi_vlan_map.csv
      matchFields:
        - eventField: vlan_id
          lookupField: vlan_id
      outputFields:
        - lookupField: network_name
          eventField: vlan
      ignoreCase: false
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: vlan
          value: "vlan || vlan_id"
  - id: aggregation
    # Single aggregation, grouped by is_wan too, so each bucket stays either
    # pure-VLAN or pure-WAN and the two publish_metrics below (filtered on
    # that same field) never mix a WAN sample into a VLAN counter or back.
    filter: "true"
    disabled: false
    conf:
      aggregates:
        - "sum(flow_bytes).as(flow_bytes_total)"
      groupByFields:
        - vlan
        - direction
        - is_wan
      timeWindow: 30s
      lagTolerance: 10s
      idleBucketTimeLimit: 10s
  - id: publish_metrics
    filter: "!is_wan"
    disabled: false
    conf:
      metrics:
        - field: flow_bytes_total
          metricName: "'unifi_vlan_bytes_total'"
          type: counter
      dimensions:
        - vlan
        - direction
  - id: publish_metrics
    filter: "is_wan"
    disabled: false
    conf:
      metrics:
        - field: flow_bytes_total
          metricName: "'unifi_wan_bytes_total'"
          type: counter
      dimensions:
        - direction
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "'unifi_metrics'"
        - name: sourcetype
          value: "'unifi:netflow:metrics'"
