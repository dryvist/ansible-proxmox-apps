---
# Preserve extracted OTLP metric names and dimensions while assigning the
# existing Splunk LLM metric index. Generated by Ansible.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "!__otlp || __otlp.type !== 'metrics'"
    disabled: false
    conf: {}
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "index || 'llm_metrics'"
        - name: sourcetype
          value: "sourcetype || 'otel:metrics'"
