---
# Credential masking, the post-processing pipeline of every splunk_hec output
# (cribl_stream_splunk_hec_post_processing_pipeline). Post-processing runs
# after any connection pipeline, so no input reaches Splunk around it.
# Generated by Ansible - do not edit manually.
#
# Rules: cribl_stream_secret_redaction_rules, the same list the trace legs use.
output: default
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  # Keep span events on trace-capable destinations, including spans that reach
  # Splunk through a connection other than the OpenTelemetry input.
  - id: drop
    filter: "sourcetype === 'otel:span' || !!(__otlp && __otlp.type === 'traces')"
    disabled: false
    conf: {}
  - id: mask
    filter: "true"
    disabled: false
    conf:
      rules:
{% for rule in cribl_stream_secret_redaction_rules %}
        - matchRegex: '{{ rule.matchRegex }}'
          replaceExpr: "{{ rule.replaceExpr }}"
{% endfor %}
      # Every field, not only _raw: structured events (OTLP spans and log
      # records) reach Splunk with no _raw at all.
      fields:
        - _raw
        - "*"
      depth: 5
