# Splunk-metadata stamp for OTLP trace spans on the open_telemetry input.
# Generated by Ansible.
#
# Claude Code (and any other OTLP producer pointed at the clean ingress URL)
# exports spans that carry no Splunk index/sourcetype. This pipeline stamps
# them so the shared splunk_hec token defaults (index=main, sourcetype=httpevent)
# never apply. Every eval is conditional (`index || ...`): a producer that DID
# set index/sourcetype passes through untouched.
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "index || 'otel_traces'"
        - name: sourcetype
          value: "sourcetype || 'otel:span'"
        - name: source
          value: "source || 'claude-code-otel'"
