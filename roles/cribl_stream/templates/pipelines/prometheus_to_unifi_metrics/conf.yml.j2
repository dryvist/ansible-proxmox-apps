---
# unpoller Prometheus scrape → Splunk unifi_metrics pipeline
# Generated by Ansible.
#
# The prometheus SCRAPER source (in_unpoller) emits one event per sample with
# fields __name__, _value, _time, and one field per label — same convention
# as prometheus_to_netmon (see that pipeline's comment for the _value
# gotcha). unpoller's own labels are site_name/name/source (device metrics)
# or subsystem/site_name/source (site metrics), never job/instance, so host
# derivation differs from prometheus_to_netmon.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        # Same NaN/null/string coercion as prometheus_to_netmon — a bad
        # metric value throws in the eval sandbox and silently drops the
        # pipeline's whole output.
        - name: _value
          value: "Number.isFinite(Number(_value)) ? Number(_value) : -1"
        - name: index
          value: "'unifi_metrics'"
        - name: sourcetype
          value: "'prometheus:metrics'"
        # unpoller device metrics carry `name` (the device's own name); site
        # metrics carry no device name, only `site_name`. Fall back to
        # site_name, then source (the unpoller instance name), never a bare
        # empty host.
        - name: host
          value: "name || site_name || source || 'unpoller'"
