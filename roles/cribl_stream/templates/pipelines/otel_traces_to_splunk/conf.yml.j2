---
# Splunk trace leg for in_otel. The final HEC post-processor applies the
# allowlist in addition to credential masking before this event leaves Stream.
# Generated by Ansible.
{% if (cribl_stream_hec_namespace | default('')) | length > 0 %}
output: splunk_hec_otel_traces
{% else %}
output: splunk_hec
{% endif %}
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "!__otlp || __otlp.type !== 'traces'"
    disabled: false
    conf: {}
{% if cribl_stream_otel_drop_span_names | length > 0 or cribl_stream_otel_drop_span_prefixes | length > 0 %}
  # Same plumbing drop as the Langfuse and Phoenix legs. Single-quoted scalar:
  # to_json emits double quotes, which would end a double-quoted scalar early.
  - id: drop
    filter: '{{ cribl_stream_otel_drop_span_names | to_json }}.includes(name) || {{ cribl_stream_otel_drop_span_prefixes | to_json }}.some(p => String(name).startsWith(p))'
    disabled: false
    conf: {}
{% endif %}
{{ lookup('ansible.builtin.template', cribl_stream_role_dir ~ '/templates/pipelines/agent_tags.yml.j2') }}
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "'otel_traces'"
        - name: sourcetype
          value: "'otel:span'"
        - name: host
          value: "(attributes && attributes['service.name']) || 'otel'"
