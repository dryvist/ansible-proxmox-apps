---
# Splunk trace leg for in_otel. The final HEC post-processor applies the
# allowlist in addition to credential masking before this event leaves Stream.
# Generated by Ansible.
{% if (cribl_stream_hec_namespace | default('')) | length > 0 %}
output: splunk_hec_otel_traces
{% else %}
output: splunk_hec
{% endif %}
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "!__otlp || __otlp.type !== 'traces'"
    disabled: false
    conf: {}
  # Same plumbing drop as the Langfuse and Phoenix legs.
{{ lookup('ansible.builtin.template', cribl_stream_role_dir ~ '/templates/pipelines/plumbing_drop.yml.j2') }}
  # Keep one whole trace in 10 for Splunk, by trace id. No Splunk search reads
  # spans beyond the index-gap check; Langfuse and Phoenix keep their own legs.
  - id: drop
    filter: "/^[0-9a-f]{32}$/i.test(String(__e.trace_id != null ? __e.trace_id : __e.traceId)) && parseInt(String(__e.trace_id != null ? __e.trace_id : __e.traceId).slice(-8), 16) % 10 !== 0"
    disabled: false
    conf: {}
{{ lookup('ansible.builtin.template', cribl_stream_role_dir ~ '/templates/pipelines/agent_tags.yml.j2') }}
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "'otel_traces'"
        - name: sourcetype
          value: "'otel:span'"
        - name: host
          value: "(attributes && attributes['service.name']) || 'otel'"
