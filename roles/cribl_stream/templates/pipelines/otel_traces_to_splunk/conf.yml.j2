---
# Splunk trace leg for in_otel. The final HEC post-processor applies the
# allowlist in addition to credential masking before this event leaves Stream.
# Generated by Ansible.
{% if (cribl_stream_hec_namespace | default('')) | length > 0 %}
output: splunk_hec_otel_traces
{% else %}
output: splunk_hec
{% endif %}
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "!__otlp || __otlp.type !== 'traces'"
    disabled: false
    conf: {}
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "'otel_traces'"
        - name: sourcetype
          value: "'otel:span'"
        - name: host
          value: "(attributes && attributes['service.name']) || 'otel'"
