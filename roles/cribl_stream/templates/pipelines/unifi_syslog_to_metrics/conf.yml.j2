---
# UniFi firewall syslog -> unifi_vlan_fw_events_total{vlan,action,direction}
# Generated by Ansible.
#
# Native Aggregations + Publish Metrics functions, per current Cribl docs:
#   https://docs.cribl.io/stream/aggregations-function/
#   https://docs.cribl.io/stream/publish-metrics-function/
#
# LIVE today: UDW -> HAProxy syslog VIP :1514/UDP -> Cribl Edge (stamps
# index=firewall, sourcetype=ubiquiti:firewall) -> S2S -> this Stream node's
# in_cribl_s2s (tcpjson), same forwarded stream force_splunk_meta already
# runs on. This pipeline is the SECOND connection on that input (see
# inputs.yml.j2) — it does not touch the raw-event path. The leading Drop
# keeps it to firewall events only; every other sourcetype the S2S link
# carries (AI logs, host metrics, ...) passes through untouched.
#
# Real UDW kernel firewall-policy log line (Splunk index=firewall,
# sourcetype=ubiquiti:firewall, 2026-09-25):
#   <13>Sep 25 23:18:25 UDW UDW [LOCAL_CUSTOM1-A-2147483647] DESCR="..."
#     IN= OUT=br10 MAC= SRC=... DST=... PROTO=UDP SPT=5353 DPT=5353 ...
#   <13>Sep 25 23:18:07 UDW UDW [WAN_LOCAL-D-2147483647] DESCR="..."
#     IN=eth15 OUT= MAC=... SRC=... DST=... PROTO=TCP ...
# The rule tag `[<rule>-A-<id>]`/`[<rule>-D-<id>]` carries the verdict; the
# VLAN interface (whichever of IN=/OUT= is populated) is `brN` for a
# VLAN-tagged network. WAN traffic carries no brN token (ethN instead) and
# is labelled 'wan' rather than folded into vlan_id '0' (which would
# misread as the untagged Default LAN in the lookup).
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "sourcetype !== 'ubiquiti:firewall'"
    disabled: false
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: action
          value: >-
            /-A-/.test(_raw) ? 'accept' : /-D-/.test(_raw) ? 'deny' : 'unknown'
        - name: vlan_id
          value: >-
            (function(){var m=/\bbr(\d+)\b/.exec(_raw); return m ? m[1] : 'wan';})()
        - name: direction
          value: >-
            (function(){var i=/\bIN=(\S*)/.exec(_raw), o=/\bOUT=(\S*)/.exec(_raw);
            return (i && i[1]) ? 'ingress' : (o && o[1]) ? 'egress' : 'unknown';})()
  - id: lookup
    filter: "true"
    disabled: false
    conf:
      file: unifi_vlan_map.csv
      matchFields:
        - eventField: vlan_id
          lookupField: vlan_id
      outputFields:
        - lookupField: network_name
          eventField: vlan
      ignoreCase: false
  - id: eval
    # Lookup miss (vlan id not in the published network list, or the 'wan'
    # sentinel above) must not silently vanish from the metric — carry the
    # raw id/sentinel through as the label instead of dropping the group.
    filter: "true"
    disabled: false
    conf:
      add:
        - name: vlan
          value: "vlan || vlan_id"
  - id: aggregation
    filter: "true"
    disabled: false
    conf:
      aggregates:
        - "count().as(count)"
      groupByFields:
        - vlan
        - action
        - direction
      timeWindow: 5s
      lagTolerance: 10s
      idleBucketTimeLimit: 10s
  - id: publish_metrics
    filter: "true"
    disabled: false
    conf:
      metrics:
        - field: count
          metricName: "'unifi_vlan_fw_events_total'"
          type: counter
      dimensions:
        - vlan
        - action
        - direction
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "'unifi_metrics'"
        - name: sourcetype
          value: "'unifi:firewall:metrics'"
