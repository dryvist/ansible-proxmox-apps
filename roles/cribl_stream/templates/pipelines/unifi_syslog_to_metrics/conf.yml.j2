---
# UniFi firewall syslog -> unifi_firewall_action_total{vlan,action}
# Generated by Ansible.
#
# NOT YET LIVE: this input has no traffic today. The UDW gateway's remote
# syslog export (gateway-telemetry.tf udw_telemetry_desired_state.syslog,
# tofu-unifi) is an INFORMATIONAL record only — the provider-supported
# unifi_setting.syslog resource that would actually turn it on is commented
# out pending an `import` + THE LAW snapshot. This pipeline is ready to
# receive events the day that lands; until then it aggregates zero events.
#
# UniFi kernel firewall-policy log lines carry the rule action in the message
# tag as "-A-" (accept) or "-D-" (drop/deny) and the VLAN as the ingress
# bridge interface "brN" (N = VLAN id; untagged/Default is br0). Both are
# read straight off _raw with a regex — UniFi does not emit these as
# structured fields over syslog.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: action
          value: >-
            /-A-/.test(_raw) ? 'accept' : /-D-/.test(_raw) ? 'deny' : 'unknown'
        - name: vlan_id
          value: >-
            (function(){var m=/\bbr(\d+)\b/.exec(_raw); return m ? m[1] : '0';})()
  - id: lookup
    filter: "true"
    disabled: false
    conf:
      file: unifi_vlan_map.csv
      matchFields:
        - eventField: vlan_id
          lookupField: vlan_id
      outputFields:
        - lookupField: network_name
          eventField: vlan
      ignoreCase: false
  - id: eval
    # Lookup miss (vlan id not in the published network list) must not
    # silently vanish from the metric — carry the raw id through as the
    # label instead of dropping the group.
    filter: "true"
    disabled: false
    conf:
      add:
        - name: vlan
          value: "vlan || vlan_id"
  - id: aggregation
    filter: "true"
    disabled: false
    conf:
      aggregates:
        - "count().as(count)"
      groupByFields:
        - vlan
        - action
      timeWindow: 30s
      lagTolerance: 10s
      idleBucketTimeLimit: 10s
  - id: publish_metrics
    filter: "true"
    disabled: false
    conf:
      metrics:
        - field: count
          metricName: "'unifi_firewall_action_total'"
          type: counter
      dimensions:
        - vlan
        - action
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "'unifi_metrics'"
        - name: sourcetype
          value: "'unifi:firewall:metrics'"
