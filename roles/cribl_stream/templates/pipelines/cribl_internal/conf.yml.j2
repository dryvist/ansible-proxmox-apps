---
# Splunk-metadata stamp for Cribl's own built-in internal source
# (CriblLogs + CriblMetrics). Generated by Ansible.
#
# Shared by both inputs — __inputId is the only thing that differs between a
# CriblLogs and a CriblMetrics event, so sourcetype is picked from it the same
# way ai_stamp picks a sourcetype per in_ai_* input. Every eval is conditional
# (`index || ...`): a builtin field the source already set passes through
# untouched.
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "index || 'cribl_internal'"
        - name: sourcetype
          value: >-
            sourcetype || (__inputId.includes('CriblMetrics')
            ? 'cribl:metrics' : 'cribl:log')
