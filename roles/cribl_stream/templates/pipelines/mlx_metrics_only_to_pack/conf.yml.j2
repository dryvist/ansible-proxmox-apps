# Generated by Ansible.
# Keeps only mlx:metrics events on the S2S input's MLX pack leg to the Splunk HEC output, then hands them to the pack.
# Splunk keeps one 10 s Edge poll in six (one per minute): its only reader is the serving-host memory alert, which
# averages the window. The victoriametrics_rw connection chains the pack directly and keeps every poll.
functions:
  - id: drop
    filter: "sourcetype !== 'mlx:metrics' || Math.floor(_time / 10) % 6 !== 0"
    disabled: false
    conf: {}
  - id: chain
    filter: "true"
    disabled: false
    conf:
      processor: "pack:cc-stream-apple-mlx-metrics"
