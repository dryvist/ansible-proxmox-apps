---
# pve-r540 (iDRAC9) Redfish Thermal/Power -> hardware metrics pipeline.
# Generated by Ansible.
#
# Each collector run emits ONE event per polled Redfish document (Thermal,
# Power). The Code function below fans each document's sensor array
# (Temperatures[]/Fans[]/PowerSupplies[]) into one metric event per sensor,
# then Publish Metrics converts each into a Cribl-internal metric
# (__criblMetrics) so it serializes correctly to both the Splunk metrics
# index (host_metrics, via the generic HEC endpoint) and the VictoriaMetrics
# remote_write destination.
#
# NOTE: validate this pipeline's function ids/schema against the live Cribl
# Stream UI after deploy (Redfish field names in particular) — this could not
# be checked against a running Cribl instance from the authoring session.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: code
    filter: "true"
    disabled: false
    conf:
      code: |
        (() => {
          const events = [];
          const host = "{{ inventory_hostname }}";
          if (Array.isArray(__e.Temperatures)) {
            for (const t of __e.Temperatures) {
              if (t.ReadingCelsius === null || t.ReadingCelsius === undefined) continue;
              events.push({
                __name__: 'hw_temp_celsius',
                _value: Number(t.ReadingCelsius),
                host,
                sensor: t.Name || t.MemberId || 'unknown',
              });
            }
          }
          if (Array.isArray(__e.Fans)) {
            for (const f of __e.Fans) {
              const rpm = f.Reading !== undefined ? f.Reading : f.ReadingRPM;
              if (rpm === null || rpm === undefined) continue;
              events.push({
                __name__: 'hw_fan_rpm',
                _value: Number(rpm),
                host,
                fan: f.Name || f.MemberId || 'unknown',
              });
            }
          }
          if (Array.isArray(__e.PowerSupplies)) {
            for (const p of __e.PowerSupplies) {
              const psu = p.Name || p.MemberId || 'unknown';
              if (p.PowerOutputWatts !== null && p.PowerOutputWatts !== undefined) {
                events.push({
                  __name__: 'hw_psu_watts',
                  _value: Number(p.PowerOutputWatts),
                  host,
                  psu,
                });
              }
              const health = (p.Status && p.Status.Health) || 'Unknown';
              events.push({
                __name__: 'hw_psu_status',
                _value: health === 'OK' ? 1 : 0,
                host,
                psu,
                health,
              });
            }
          }
          return events.length ? events : null;
        })()
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "'host_metrics'"
        - name: sourcetype
          value: "'idrac:redfish:metrics'"
  - id: publish_metrics
    filter: "true"
    disabled: false
    conf:
      metricNameField: __name__
      valueField: _value
      dimensions: "*"
