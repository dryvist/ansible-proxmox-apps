  # Shared native Eval enrichment for every OTEL signal destination.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: attributes
          value: >-
            __e.attributes && typeof __e.attributes === 'object' && !Array.isArray(__e.attributes)
            ? __e.attributes : {}
{% for tag, fallback in cribl_stream_otel_agent_tag_defaults.items() %}
        - name: "attributes['{{ tag }}']"
          value: >-
            attributes['{{ tag }}'] ?? attributes['litellm.metadata.{{ tag }}'] ??
            __e['{{ tag }}'] ??
{% if tag == 'model' %}
            attributes['gen_ai.request.model'] ?? attributes['llm.model_name'] ??
{% endif %}
            {{ fallback | to_json }}
{% endfor %}
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
{% for tag, fallback in cribl_stream_otel_agent_tag_defaults.items() %}
        - name: "attributes['{{ tag }}']"
{% if tag == 'tier' %}
          value: "[0, 1, 2, '0', '1', '2'].includes(attributes.tier) ? Number(attributes.tier) : 2"
{% else %}
          value: >-
            typeof attributes['{{ tag }}'] === 'string' && attributes['{{ tag }}'].length > 0
            ? attributes['{{ tag }}'] : {{ fallback | to_json }}
{% endif %}
{% endfor %}
