---
# HAProxy queue-depth/5xx metrics from the Mac Edge's in_queue_metrics
# (edge_prometheus, stamped sourcetype=mlx:metrics by the Edge-local
# llm_metrics pipeline) -> true Splunk metric-index events + VictoriaMetrics.
# Generated by Ansible.
#
# Arrives on in_cribl_s2s (Edge's "cribl_stream" TCP JSON output -> this
# node's S2S listener, the same shared input force_splunk_meta already runs
# on). TCP JSON is a generic JSON transport -- not Cribl TCP, which a
# standalone Edge refuses -- so Cribl's internal metric flag does not
# survive the hop even though the underlying fields do: stamping a metric
# Splunk index directly at Edge over this same path was tried and failed
# with invalid_index for exactly that reason (nix-darwin#1824). Publish
# Metrics below re-establishes the metric flag before splunk_hec/
# victoriametrics_rw serialize it, same technique as bmc_hw_metrics.
#
# Verified against a real standalone Edge 4.19.0 + a throwaway
# edge_prometheus target (loopback, deleted after): in_queue_metrics'
# events carry _metric/_value/<labels as plain fields>, same convention
# in_pve_metrics already uses (pve_metrics_normalize). Most in_system_metrics
# events still carry each metric name as a literal field (e.g.
# node_memory_used_percent=57.5) without _metric/_value/__name__, so they
# fall through untouched to the event-only path (index=llm). The optional
# judge Process Set adds _metric/_value for process_start_time_seconds in the
# Mac Edge pipeline; that signal passes the leading Drop and reaches Publish
# Metrics with its name and dimensions intact.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "sourcetype !== 'mlx:metrics' || _metric === undefined"
    disabled: false
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        # Same NaN/null/string coercion as prometheus_to_netmon /
        # prometheus_to_unifi_metrics -- a bad metric value throws in the
        # eval sandbox and silently drops the pipeline's whole output.
        - name: _value
          value: "Number.isFinite(Number(_value)) ? Number(_value) : -1"
        - name: index
          value: "'llm_metrics'"
  - id: publish_metrics
    filter: "true"
    disabled: false
    conf:
      metricNameField: _metric
      valueField: _value
      dimensions: "*"
