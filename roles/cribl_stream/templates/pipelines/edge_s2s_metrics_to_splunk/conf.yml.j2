---
# Restore native metric metadata and route Edge host/GPU metrics to Splunk.
# Generated by Ansible.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: index
          value: "'host_metrics'"
        - name: sourcetype
          value: "sourcetype || 'edge:metrics'"
        - name: _value
          value: >-
            _metric !== undefined
            ? (Number.isFinite(Number(_value)) ? Number(_value) : -1)
            : _value
  - id: publish_metrics
    filter: "_metric !== undefined"
    disabled: false
    conf:
      metricNameField: _metric
      valueField: _value
      dimensions: "*"
  - id: publish_metrics
    filter: "true"
    disabled: false
    conf:
      fields:
        - inFieldName: "node_*"
          metricType: gauge
        - inFieldName: "gpu_*"
          metricType: gauge
      dimensions:
        - "*"
