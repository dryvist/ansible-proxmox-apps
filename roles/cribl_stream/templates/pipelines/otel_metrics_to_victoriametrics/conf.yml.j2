---
# Keep only extracted OTLP metrics; the destination writes them to the
# VictoriaMetrics OTLP endpoint with their original names and dimensions.
# Generated by Ansible.
output: victoriametrics_otlp
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: drop
    filter: "!__otlp || __otlp.type !== 'metrics'"
    disabled: false
    conf: {}
