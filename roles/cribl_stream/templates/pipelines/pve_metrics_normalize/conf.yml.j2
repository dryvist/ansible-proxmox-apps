---
# PVE native metrics (Graphite wire protocol, via in_pve_metrics) ->
# pve_node_<key>, pve_qemu_<key>, pve_lxc_<key>, pve_storage_<key>{node,
# storage,vmid}. Generated by Ansible.
#
# Path hierarchy (pve-manager PVE/Status/Graphite.pm):
#   <root>.nodes.<node>.<key...>
#   <root>.qemu.<vmid>.<key...>
#   <root>.lxc.<vmid>.<key...>
#   <root>.storages.<node>.<storage>.<key...>
# <root> defaults to "proxmox" (tofu-proxmox's proxmox_metrics_server
# resource leaves graphite_path unset). <key...> is itself dot-separated
# (e.g. memory.used, swap.used, nics.net0.netin) — every segment after the
# id must be kept, or distinct keys collide onto the same metric name.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: __parts
          value: "(_metric || '').split('.')"
        - name: __object
          value: "__parts[1]"
        - name: node
          value: >-
            (__object === 'nodes' || __object === 'storages') ? __parts[2] : undefined
        - name: vmid
          value: >-
            (__object === 'qemu' || __object === 'lxc') ? __parts[2] : undefined
        - name: storage
          value: "__object === 'storages' ? __parts[3] : undefined"
        - name: __key
          value: >-
            (__object === 'storages' ? __parts.slice(4) : __parts.slice(3)).join('_')
        - name: _metric
          value: >-
            (__object === 'nodes' ? 'pve_node_' : __object === 'qemu' ? 'pve_qemu_' :
             __object === 'lxc' ? 'pve_lxc_' : __object === 'storages' ? 'pve_storage_' :
             'pve_' + __object + '_') + __key
        - name: index
          value: "'host_metrics'"
        - name: sourcetype
          value: "'pve:metrics'"
      remove:
        - __parts
        - __object
        - __key
