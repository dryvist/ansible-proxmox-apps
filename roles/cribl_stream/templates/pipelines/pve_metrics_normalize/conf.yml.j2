---
# PVE native metrics (Graphite wire protocol, via in_pve_metrics) ->
# pve_node_<key>, pve_qemu_<key>, pve_lxc_<key>, pve_storage_<key>{node,
# storage,vmid}. Generated by Ansible.
#
# Path hierarchy is PVE's own Graphite plugin (pve-manager
# PVE/Status/Graphite.pm, update_node_status/update_qemu_status/
# update_lxc_status/update_storage_status -> assemble()):
#   <root>.nodes.<node>.<key>
#   <root>.qemu.<vmid>.<key>
#   <root>.lxc.<vmid>.<key>
#   <root>.storages.<node>.<storage>.<key>
# <root> defaults to "proxmox" (PVE default; tofu-proxmox's
# proxmox_metrics_server resource leaves graphite_path unset). A SHARED
# storage is reported once per node that has it configured (pvestatd
# collects per node), so <node> is always present in the storages path —
# dedup by (storage) alone if a single series per shared storage is wanted
# downstream.
#
# Cribl's Metrics source normalizes every wire-format event into _metric/
# _value/_time (docs.cribl.io/stream/sources-metrics/); for plain Graphite
# lines (no StatsD Extended dimension tags) the full dotted path is the
# _metric value, dimension-free.
output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: __parts
          value: "(_metric || '').split('.')"
        - name: __object
          value: "__parts[1]"
        - name: __key
          value: "__parts[__parts.length - 1]"
        - name: node
          value: >-
            (__object === 'nodes' || __object === 'storages') ? __parts[2] : undefined
        - name: vmid
          value: >-
            (__object === 'qemu' || __object === 'lxc') ? __parts[2] : undefined
        - name: storage
          value: "__object === 'storages' ? __parts[3] : undefined"
        - name: _metric
          value: >-
            (__object === 'nodes' ? 'pve_node_' : __object === 'qemu' ? 'pve_qemu_' :
             __object === 'lxc' ? 'pve_lxc_' : __object === 'storages' ? 'pve_storage_' :
             'pve_' + __object + '_') + __key
        - name: index
          value: "'host_metrics'"
        - name: sourcetype
          value: "'pve:metrics'"
      remove:
        - __parts
        - __object
        - __key
