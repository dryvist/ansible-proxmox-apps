---
# OTLP trace pipeline for the in_otel -> langfuse_otlp connection
# Generated by Ansible - do not edit manually
#
# This leg feeds the LLM-observability backend ONLY. The parallel Splunk leg
# (otel_stamp) is deliberately untouched: everything dropped or trimmed here is
# still retained there, so latency, failure and pipeline-diagnostic evidence
# survives even when a span is not useful in an LLM trace viewer.
#
# Every list this template loops over lives in defaults/main.yml. Adding a span
# name, a noisy attribute or a redaction pattern is a data change there, never
# an edit here.
#
# Order matters:
#   1. drop non-trace signals   (destination ingests traces only)
#   2. drop non-LLM plumbing    (keeps the trace viewer readable)
#   3. normalize identity       (backend reads langfuse.*-prefixed attributes)
#   4. normalize usage/metadata (emitters disagree on attribute names)
#   5. guarantee a trace name   (a third of spans arrive unnamed)
#   6. trim noise               (always-empty attrs, multi-KB stack traces)
#   7. redact credentials       (before content capture is ever enabled)
#   8. drop valueless attrs     (backend worker throws on a value-less attr)

output: langfuse_otlp
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  # 1. The fabric's OTLP producers send metrics and logs alongside traces on the
  # same endpoint. The destination ingests TRACES ONLY - anything else errors,
  # retries, and backs the persistent queue up until real spans stop flowing.
  - id: drop
    filter: "!__otlp || __otlp.type !== 'traces'"
    disabled: false
    conf: {}
{% if cribl_stream_otel_drop_span_names | length > 0 %}

  # 2. Non-LLM plumbing, dropped from this leg only (Splunk keeps it).
  # Single-quoted YAML scalar: to_json emits double quotes, which would end a
  # double-quoted scalar early and render invalid YAML.
  - id: drop
    filter: '{{ cribl_stream_otel_drop_span_names | to_json }}.includes(name)'
    disabled: false
    conf: {}
{% endif %}

  # 3. Identity. These attributes are already emitted; nothing downstream read
  # them, so every trace landed with a null user and no session.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: "attributes['langfuse.user.id']"
          value: "{% for a in cribl_stream_otel_user_id_sources %}attributes['{{ a }}'] || {% endfor %}undefined"
        - name: "attributes['langfuse.session.id']"
          value: "{% for a in cribl_stream_otel_session_id_sources %}attributes['{{ a }}'] || {% endfor %}undefined"
        - name: "attributes['langfuse.environment']"
          value: "attributes['deployment.environment'] || '{{ cribl_stream_otel_default_environment }}'"
        - name: "attributes['langfuse.observation.type']"
          value: "(attributes['gen_ai.request.model'] || attributes['model']) ? 'generation' : 'span'"
        # Deduplicated so an emitter that sets both `model` and
        # `gen_ai.request.model` does not produce the same tag twice.
        - name: "attributes['langfuse.trace.tags']"
          value: "[...new Set([{% for a in cribl_stream_otel_tag_sources %}attributes['{{ a }}']{{ ', ' if not loop.last }}{% endfor %}].filter(Boolean))]"

  # 4. Usage and passthrough metadata.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
{% for target, source in cribl_stream_otel_usage_aliases.items() %}
        - name: "attributes['{{ target }}']"
          value: "attributes['{{ target }}'] || attributes['{{ source }}'] || undefined"
{% endfor %}
{% for name, source in cribl_stream_otel_metadata_passthrough.items() %}
        - name: "attributes['langfuse.trace.metadata.{{ name }}']"
          value: "attributes['{{ source }}'] || undefined"
{% endfor %}

  # 5. Trace label, most specific meaningful value first. `name` is the span's
  # own name and wins when set; the fallbacks cover the unnamed third.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: "attributes['langfuse.trace.name']"
          value: "name || {% for a in cribl_stream_otel_trace_name_sources %}attributes['{{ a }}'] || {% endfor %}'{{ cribl_stream_otel_trace_name_fallback }}'"

  # 6. Noise removal.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      remove:
{% for attr in (cribl_stream_otel_noise_attributes + cribl_stream_otel_drop_attributes) %}
        - "attributes['{{ attr }}']"
{% endfor %}

  # 7. Credential redaction - see defaults/main.yml for the schema trap.
  - id: mask
    filter: "true"
    disabled: false
    conf:
      rules:
{% for rule in cribl_stream_otel_redaction_rules %}
        - matchRegex: '{{ rule.matchRegex }}'
          replaceExpr: "{{ rule.replaceExpr }}"
{% endfor %}
      fields:
{% for field in cribl_stream_otel_redaction_fields %}
        - '{{ field }}'
{% endfor %}

  # 8. Every step above sets an attribute with `x || undefined` when its
  # source is absent, which the OTLP exporter serializes as an attribute with
  # no value member at all. The Langfuse worker throws
  # "Cannot read properties of undefined (reading 'stringValue')" on that
  # exact shape and drops the whole span after the web tier already returned
  # 200 -- confirmed live with four hand-built payloads to the real endpoint
  # (plain string, array, and empty-object values all stored; a value-less
  # key alone reproduced the crash and never stored). Strip them here rather
  # than at every `|| undefined` site, so a source added later is covered too.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: "attributes"
          value: >-
            Object.fromEntries(Object.entries(attributes)
              .filter(([, v]) => v !== undefined && v !== null))
