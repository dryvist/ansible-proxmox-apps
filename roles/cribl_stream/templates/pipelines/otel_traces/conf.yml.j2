---
# OTLP trace pipeline for the in_otel -> langfuse_otlp connection
# Generated by Ansible - do not edit manually
#
# This leg feeds the Langfuse LLM-observability backend. The parallel Phoenix
# leg applies the same trace filtering and redaction without Langfuse-specific
# attribute rewrites.
#
# Every list this template loops over lives in defaults/main.yml. Adding a span
# name, a noisy attribute or a redaction pattern is a data change there, never
# an edit here.
#
# Order matters:
#   1. drop non-trace signals   (destination ingests traces only)
#   2. drop non-LLM plumbing    (keeps the trace viewer readable)
#   3. bucket Langfuse trace ids (one clock hour per backend trace)
#   4. normalize identity       (backend reads langfuse.*-prefixed attributes)
#   5. normalize usage/metadata (emitters disagree on attribute names)
#   6. guarantee a trace name   (a third of spans arrive unnamed)
#   7. trim noise               (always-empty attrs, multi-KB stack traces)
#   8. redact credentials       (before content capture is ever enabled)
#   9. drop valueless attrs     (backend worker throws on a value-less attr)

output: langfuse_otlp
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  # 1. The fabric's OTLP producers send metrics and logs alongside traces on the
  # same endpoint. The destination ingests TRACES ONLY - anything else errors,
  # retries, and backs the persistent queue up until real spans stop flowing.
  - id: drop
    filter: "!__otlp || __otlp.type !== 'traces'"
    disabled: false
    conf: {}

  # 2. Non-LLM plumbing, dropped from every trace leg.
{{ lookup('ansible.builtin.template', cribl_stream_role_dir ~ '/templates/pipelines/plumbing_drop.yml.j2') }}

{{ lookup('ansible.builtin.template', cribl_stream_role_dir ~ '/templates/pipelines/agent_tags.yml.j2') }}

{% if cribl_stream_otel_trace_bucket_seconds | int %}
  # 3. Re-key Langfuse spans by clock hour when a configured real grouping
  # attribute is present. This keeps each backend trace to one clock hour of
  # spans and bounds per-trace event volume. Preserve the original trace id
  # for metadata and the session fallback. parentSpanId stays unchanged, so
  # a child in a later hour is a root in that hour's trace.
  - id: code
    filter: "attributes.agent === 'unknown'"
    disabled: false
    conf:
      code: >-
        var tk = __e.trace_id !== undefined && __e.trace_id !== null &&
        __e.trace_id !== '' ? 'trace_id' : 'traceId';
        var sk = typeof __e.start_time_unix_nano !== 'undefined' ?
        'start_time_unix_nano' : 'startTimeUnixNano';
        var original = String(__e[tk]), ns = Number(__e[sk]), a = __e.attributes || {};
        var bucketSources = {{ cribl_stream_otel_bucket_sources | to_json }};
        var hasBucket = bucketSources.some(function (key) {
          var value = a[key];
          return value !== undefined && value !== null && value !== '';
        });
        if (/^[0-9a-f]{32}$/i.test(original) && hasBucket && Number.isFinite(ns)) {
          var originalKey = 'langfuse.trace.metadata.original_trace_id';
          if (a[originalKey] === undefined || a[originalKey] === null) {
            a[originalKey] = original;
          }
          var sessionKey = 'langfuse.session.id';
          if (a[sessionKey] === undefined || a[sessionKey] === null) {
            var session = original;
            var sessionSources = {{ cribl_stream_otel_session_id_sources | to_json }};
            for (var i = 0; i < sessionSources.length; i++) {
              var value = a[sessionSources[i]];
              if (value !== undefined && value !== null && value !== '') {
                session = value;
                break;
              }
            }
            a[sessionKey] = session;
          }
          __e[tk] = C.Mask.md5(original + ':' + Math.floor(ns /
            {{ cribl_stream_otel_ns_per_second }} /
            {{ cribl_stream_otel_trace_bucket_seconds }}));
        }
{% endif %}

  # 4. Identity. These attributes are already emitted; nothing downstream read
  # them, so every trace landed with a null user and no session.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: "attributes['langfuse.user.id']"
          value: "{% for a in cribl_stream_otel_user_id_sources %}attributes['{{ a }}'] || {% endfor %}(attributes['metadata.environment'] === 'benchmark' ? (attributes['metadata.user'] || attributes['metadata.trace_user_id']) : undefined) || undefined"
        - name: "attributes['langfuse.session.id']"
          value: "{% for a in cribl_stream_otel_session_id_sources %}attributes['{{ a }}'] || {% endfor %}(attributes['metadata.environment'] === 'benchmark' ? attributes['metadata.session_id'] : undefined) || undefined"
        - name: "attributes['langfuse.environment']"
          value: "attributes['langfuse.environment'] || attributes['litellm.metadata.environment'] || (attributes['metadata.environment'] === 'benchmark' ? attributes['metadata.environment'] : undefined) || attributes['deployment.environment'] || '{{ cribl_stream_otel_default_environment }}'"
        - name: "attributes['langfuse.release']"
          value: "attributes['langfuse.release'] || attributes['litellm.metadata.trace_release'] || attributes['litellm.metadata.release'] || (attributes['metadata.environment'] === 'benchmark' ? (attributes['metadata.trace_release'] || attributes['metadata.release']) : undefined) || undefined"
        - name: "attributes['langfuse.version']"
          value: "attributes['langfuse.version'] || attributes['litellm.metadata.trace_version'] || attributes['litellm.metadata.release'] || (attributes['metadata.environment'] === 'benchmark' ? (attributes['metadata.trace_version'] || attributes['metadata.release']) : undefined) || undefined"
        - name: "attributes['langfuse.observation.type']"
          value: "attributes['langfuse.observation.type'] || ((attributes['gen_ai.request.model'] || attributes['llm.model_name'] || attributes['model']) ? 'generation' : 'span')"
        # Deduplicated so an emitter that sets both `model` and
        # `gen_ai.request.model` does not produce the same tag twice.
        - name: "attributes['langfuse.trace.tags']"
          value: "[...new Set([].concat(attributes['langfuse.trace.tags'] || [], attributes['tag.tags'] || [], attributes['litellm.metadata.runner'], attributes['litellm.metadata.purpose'], [{% for a in cribl_stream_otel_tag_sources %}{% if a == 'model' %}attributes.model === 'unknown' ? undefined : {% endif %}attributes['{{ a }}']{{ ', ' if not loop.last }}{% endfor %}], attributes['metadata.environment'] === 'benchmark' ? [].concat(attributes['metadata.tags'] || [], attributes['metadata.runner'], attributes['metadata.purpose']) : []).filter(Boolean))]"

  # 5. Usage and passthrough metadata.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
{% for target, source in cribl_stream_otel_usage_aliases.items() %}
        - name: "attributes['{{ target }}']"
          value: "attributes['{{ target }}'] !== undefined && attributes['{{ target }}'] !== null ? attributes['{{ target }}'] : attributes['{{ source }}'] !== null ? attributes['{{ source }}'] : undefined"
{% endfor %}
{% for name, source in cribl_stream_otel_metadata_passthrough.items() %}
        - name: "attributes['langfuse.trace.metadata.{{ name }}']"
          value: "attributes['langfuse.trace.metadata.{{ name }}'] !== undefined && attributes['langfuse.trace.metadata.{{ name }}'] !== null ? attributes['langfuse.trace.metadata.{{ name }}'] : attributes['{{ source }}'] !== undefined && attributes['{{ source }}'] !== null ? attributes['{{ source }}'] : attributes['metadata.environment'] === 'benchmark' ? attributes['metadata.{{ name }}'] : undefined"
{% endfor %}

  # Canonical agent-run facets take precedence over emitter-specific metadata.
  - id: eval
    filter: "attributes.agent !== 'unknown'"
    disabled: false
    conf:
      add:
{% for tag in cribl_stream_otel_run_tags %}
{% for level in ['trace', 'observation'] %}
        - name: "attributes['langfuse.{{ level }}.metadata.{{ tag }}']"
          value: "attributes['{{ tag }}']"
{% endfor %}
{% endfor %}
        - name: "attributes['langfuse.trace.tags']"
          value: >-
            [...new Set([].concat(attributes['langfuse.trace.tags'] || [], [
{% for tag in cribl_stream_otel_run_tags %}
              '{{ tag }}:' + attributes['{{ tag }}']{{ ',' if not loop.last }}
{% endfor %}
            ]))]

  # 6. Trace label, most specific meaningful value first. `name` is the span's
  # own name and wins when set; the fallbacks cover the unnamed third.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        - name: "attributes['langfuse.trace.name']"
          value: "attributes['langfuse.trace.name'] || attributes['litellm.metadata.trace_name'] || (attributes['metadata.environment'] === 'benchmark' ? attributes['metadata.trace_name'] : undefined) || name || {% for a in cribl_stream_otel_trace_name_sources %}attributes['{{ a }}'] || {% endfor %}'{{ cribl_stream_otel_trace_name_fallback }}'"

  # Preserve the native trace label; name inference observations independently.
  - id: eval
    filter: "!!(attributes['litellm.metadata.generation_name'] || (attributes['metadata.environment'] === 'benchmark' ? attributes['metadata.generation_name'] : undefined)) && !!(attributes['gen_ai.request.model'] || attributes['llm.model_name'])"
    disabled: false
    conf:
      add:
        - name: name
          value: "attributes['litellm.metadata.generation_name'] || (attributes['metadata.environment'] === 'benchmark' ? attributes['metadata.generation_name'] : undefined) || name"

  # 7. Noise removal.
  - id: eval
    filter: "true"
    disabled: false
    conf:
      remove:
{% for attr in (cribl_stream_otel_noise_attributes + cribl_stream_otel_drop_attributes) %}
        - "attributes['{{ attr }}']"
{% endfor %}

  # 8. Credential redaction - see defaults/main.yml for the schema trap.
  - id: mask
    filter: "true"
    disabled: false
    conf:
      rules:
{% for rule in cribl_stream_secret_redaction_rules %}
        - matchRegex: '{{ rule.matchRegex }}'
          replaceExpr: "{{ rule.replaceExpr }}"
{% endfor %}
      fields:
{% for field in cribl_stream_otel_redaction_fields %}
        - '{{ field }}'
{% endfor %}

  # 9. Every step above sets an attribute with `x || undefined` when its
  # source is absent, which the OTLP exporter serializes as an attribute with
  # no value member at all. The Langfuse worker throws
  # "Cannot read properties of undefined (reading 'stringValue')" on that
  # exact shape and drops the whole span after the web tier already returned
  # 200 -- confirmed live with four hand-built payloads direct to the real
  # endpoint (plain string, array, and empty-object values all stored; a
  # value-less key alone reproduced the crash and never stored).
  #
  # A single Eval "add" expression (`Object.fromEntries(...).filter(([, v])
  # => ...)`) cannot do this: Eval's "add" value is validated as a
  # restricted single-expression grammar that rejects any function literal.
  # A Code function has no such restriction -- it runs full statements
  # against the reserved `__e` event reference, so the strip happens as an
  # in-place delete rather than a whole-field reassignment.
  - id: code
    filter: "true"
    disabled: false
    conf:
      code: >-
        if (__e.attributes) { for (var k in __e.attributes) { if
        (__e.attributes[k] === undefined || __e.attributes[k] === null) {
        delete __e.attributes[k]; } } }
