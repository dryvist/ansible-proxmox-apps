---
# Both telemetry streams fan out through their own pipeline and destination.
id: {{ cribl_stream_github_actions_collector_id }}
type: collection
collector: {{ cribl_stream_github_actions_collector_id }}
enabled: {{ cribl_stream_github_actions_enabled | lower }}
workerAffinity: true
input:
  type: collection_input
  sendToRoutes: false
  connections:
    - output: splunk_hec_github_actions
      pipeline: github_actions
    - output: victoriametrics_rw
      pipeline: github_actions_metrics
schedule:
  cronSchedule: "{{ cribl_stream_github_actions_schedule }}"
  timezone: UTC
  run:
    mode: full
