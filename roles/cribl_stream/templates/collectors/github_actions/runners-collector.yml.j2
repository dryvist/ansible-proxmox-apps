---
# The only self-hosted runners are in the configured runner organization.
id: github_actions_runners
type: collection
conf:
  type: rest
  discovery:
    discoverType: none
  collectUrl: >-
    {{ cribl_stream_github_actions_api_base_url ~ '/orgs/' ~
    cribl_stream_github_actions_runners_org ~ '/actions/runners?per_page=' ~
    cribl_stream_github_actions_repo_page_size }}
  collectMethod: get
  pagination:
    type: response_header_link
    nextRelationAttribute: next
    maxPages: 0
  collectRequestHeaders:
    - name: Accept
      value: "'application/vnd.github+json'"
    - name: X-GitHub-Api-Version
      value: "'2022-11-28'"
  authentication: login
  loginUrl: "{{ cribl_stream_github_actions_agent_proxy_url }}/v1/github-admin/token/exporter-dryvist"
  username: ""
  password: ""
  loginBody: "`{}`"
  tokenRespAttribute: data.token
  authHeaderExpr: '`Bearer ${token}`'
  authRequestHeaders:
    - name: Content-Type
      value: "'application/json'"
  timeout: 60
  rejectUnauthorized: true
  disableTimeFilter: true
