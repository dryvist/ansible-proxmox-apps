{{ ansible_managed | comment }}
[Unit]
Description=OpenBao Agent proxy for Cribl GitHub Actions collection
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart={{ cribl_stream_github_actions_openbao_bin }} agent -config={{ cribl_stream_github_actions_agent_config }}
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
