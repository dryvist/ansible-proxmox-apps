{{ ansible_managed | comment }}
exit_after_auth = false

vault {
  address = "{{ cribl_stream_github_actions_openbao_addr }}"
}

auto_auth {
  method "approle" {
    config = {
      role_id_file_path   = "{{ cribl_stream_github_actions_approle_dir }}/role_id"
      secret_id_file_path = "{{ cribl_stream_github_actions_approle_dir }}/secret_id"
      remove_secret_id_file_after_reading = false
    }
  }
}

# Cribl Login posts the per-owner request to this loopback-only API proxy.
# The proxy attaches its current auto-auth token; the returned GitHub token is
# extracted by Cribl from data.token and never persisted in Cribl's config.
api_proxy {
  use_auto_auth_token = true
}

listener "tcp" {
  address     = "{{ cribl_stream_github_actions_agent_proxy_address }}"
  tls_disable = true
}
