---
# Cribl Stream REST Collector: the r540 node iDRAC9 Redfish Thermal endpoint.
# destination.connections schema unconfirmed against a live Cribl instance.
id: idrac_r540_redfish_thermal
type: collection
conf:
  type: rest
  collectUrl: >-
    `https://{{ cribl_stream_idrac_r540_bmc_host }}/redfish/v1/Chassis/{{
    cribl_stream_idrac_r540_chassis }}/Thermal`
  collectMethod: get
  authentication: basic
  username: "{{ cribl_stream_idrac_r540_username }}"
  password: "{{ cribl_stream_idrac_r540_password }}"
  rejectUnauthorized: {{ cribl_stream_idrac_r540_tls_verify | lower }}
  timeout: 30
destination:
  connections:
    - output: splunk_hec
      pipeline: idrac_hw_metrics
    - output: victoriametrics_rw
      pipeline: idrac_hw_metrics
