---
# Cribl Stream REST Collector for LiteLLM's official model price catalog.
id: litellm_prices
type: collection
conf:
  type: rest
  discovery:
    discoverType: none
  collectUrl: "{{ cribl_stream_litellm_prices_url }}"
  collectMethod: get
  authentication: none
  timeout: 60
  rejectUnauthorized: true
  disableTimeFilter: true
