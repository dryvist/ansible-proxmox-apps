---
# Cribl Stream scheduled collection job for the complete model price file.
id: litellm_prices
type: collection
collector: litellm_prices
enabled: {{ cribl_stream_litellm_prices_enabled | lower }}
input:
  type: collection_input
  breakerRulesets:
    - litellm_pricefile
  sendToRoutes: false
  metadata:
    - name: index
      value: "'llm_pricefeed'"
    - name: sourcetype
      value: "'litellm:pricefile'"
    - name: source
      value: "'litellm-price-file'"
  connections:
    - output: splunk_hec_llm_pricefeed
schedule:
  cronSchedule: "{{ cribl_stream_litellm_prices_schedule }}"
  timezone: UTC
  run:
    mode: full
