---
# Event breaker ruleset for the single JSON document returned by the REST
# Collector. The contradictory regex matches no delimiter, so the complete
# body remains one event until the explicit 3.5 MiB safety ceiling. That stays
# below the existing 4 MiB HEC request-body target while leaving headroom over
# the latest 2.77 MB source snapshot.
litellm_pricefile:
  lib: custom
  description: Keep the LiteLLM price catalog as one event up to 3.5 MiB
  rules:
    - condition: "true"
      type: regex
      timestampAnchorRegex: /^/
      timestamp:
        type: auto
        length: 150
      timestampTimezone: local
      timestampEarliest: -420weeks
      timestampLatest: +1week
      maxEventBytes: 3670016
      disabled: false
      eventBreakerRegex: /\b\B/
      name: no-delimiter-break
