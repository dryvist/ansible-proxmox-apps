---
# Cribl Stream REST Collector: pve-r540 (iDRAC9) Redfish Power endpoint.
# Generated by Ansible.
#
# `conf` fields verified against the shipped
# cribl/default/cribl/collectors/rest/conf.schema.json in the vendored Cribl
# 4.20.1 release tarball (cdn.cribl.io/dl/latest-x64), NOT guessed: a REST
# Collector's own settings use collectUrl/collectMethod/authentication
# (single URL per collector — not a `urls` array), so Thermal and Power are
# two separate collectors, not one with two endpoints.
#
# NOT independently verified from this tarball: the surrounding Job/Schedule
# wrapper that assigns a saved Collector's destination pipeline and output(s)
# — no standalone JSON schema for it ships in the release tarball (only
# collectors/*/conf.schema.json do). `destination.connections` below mirrors
# this repo's own Stream *Source* `connections` shape (proven working for
# in_prometheus_rw), on the understanding that Collector Jobs share the same
# destination-targeting UI as Sources in current Cribl Stream — confirm
# against a live Cribl instance before/at deploy.
id: idrac_r540_redfish_power
type: collection
conf:
  type: rest
  collectUrl: >-
    `https://{{ cribl_stream_idrac_r540_bmc_host }}/redfish/v1/Chassis/{{
    cribl_stream_idrac_r540_chassis }}/Power`
  collectMethod: get
  authentication: basic
  username: "{{ cribl_stream_idrac_r540_username }}"
  password: "{{ cribl_stream_idrac_r540_password }}"
  rejectUnauthorized: {{ cribl_stream_idrac_r540_tls_verify | lower }}
  timeout: 30
destination:
  connections:
    - output: splunk_hec
      pipeline: idrac_hw_metrics
    - output: victoriametrics_rw
      pipeline: idrac_hw_metrics
