---
# Cribl Stream inputs configuration
# Generated by Ansible

inputs:
  netflow:in_ipfix:
    id: in_ipfix
    type: netflow
    disabled: false
    host: "0.0.0.0"
    port: {{ cribl_stream_netflow_port }}
    sendToRoutes: false
    connections:
{% if (cribl_stream_hec_namespace | default('')) | length > 0 %}
      # One index per HEC: IPFIX is single-index (netflow) -> dedicated output.
      - output: splunk_hec_netflow
        pipeline: ipfix
{% else %}
      - output: splunk_hec
        pipeline: ipfix
{% endif %}
    pqEnabled: {{ cribl_stream_pq_enabled | lower }}
  tcpjson:in_cribl_s2s:
    id: in_cribl_s2s
    # TCP JSON, not cribl_tcp: the Cribl TCP source is only available in
    # DISTRIBUTED Stream deployments and fails on this single-instance Stream
    # with "Source is not allowed in this deployment". TCP JSON is Cribl's
    # documented single-instance equivalent; the remote Edge ships with the
    # matching tcpjson destination on the same port.
    type: tcpjson
    disabled: false
    host: "0.0.0.0"
    port: {{ cribl_stream_s2s_port }}
    # Remote Edge nodes stamp index/sourcetype where they can, but Cribl
    # Edge provably skips its destination post-processing pipeline for
    # pack-routed events (claude/gemini transcripts arrived with datatype
    # but no index/sourcetype and fell into Splunk's token defaults:
    # index=main, sourcetype=httpevent). The force_splunk_meta connection
    # pipeline is a conditional safety net: every eval is `index || ...`,
    # so events the Edge DID stamp pass through untouched.
    sendToRoutes: false
    connections:
      - output: splunk_hec
        pipeline: force_splunk_meta
    pqEnabled: {{ cribl_stream_pq_enabled | lower }}
{% for name, entry in cribl_stream_ai_log_routing | default({}) | dictsort %}
{% set ai_type = cribl_stream_ai_input_types.get(name, 'syslog' if name.endswith('_docker') else 'tcpjson') %}
  # AI/LLM ingest '{{ name }}' (HAProxy-fronted). The ai_stamp connection
  # pipeline stamps index={{ entry.index }} / sourcetype={{ entry.sourcetype }}
  # by __inputId (conditional evals — pre-stamped events pass untouched).
  {{ ai_type }}:in_ai_{{ name }}:
    id: in_ai_{{ name }}
    type: {{ ai_type }}
    disabled: false
    host: "0.0.0.0"
{% if ai_type == 'syslog' %}
    # rsyslog sender (omfwd): RFC3164/5424 over TCP; no udpPort => no UDP
    # listener (omfwd is configured protocol=tcp on every sender).
    tcpPort: {{ entry.port }}
{% else %}
    port: {{ entry.port }}
{% endif %}
    sendToRoutes: false
    connections:
{% if (cribl_stream_hec_namespace | default('')) | length > 0 %}
      # One index per HEC: this AI source maps to a single Splunk index, so
      # send directly to that index's dedicated HEC output.
      - output: splunk_hec_{{ entry.index }}
        pipeline: ai_stamp
{% else %}
      - output: splunk_hec
        pipeline: ai_stamp
{% endif %}
    pqEnabled: {{ cribl_stream_pq_enabled | lower }}
{% endfor %}
  prometheus_rw:in_prometheus_rw:
    id: in_prometheus_rw
    type: prometheus_rw
    disabled: false
    host: "0.0.0.0"
    port: {{ cribl_stream_prometheus_rw_port }}
    prometheusAPI: {{ cribl_stream_prometheus_rw_api_path }}
    sendToRoutes: false
    connections:
      - output: splunk_hec
        pipeline: prometheus_to_netmon
    pqEnabled: {{ cribl_stream_pq_enabled | lower }}
  # OTLP trace spans, fronted by the otel Traefik ingress on 443 (TLS
  # terminated at Traefik; this listens plain HTTP). Claude Code and any other
  # OTLP/HTTP producer POST /v1/traces here. extractSpans turns each OTLP span
  # into a Splunk event; the otel_stamp connection pipeline stamps
  # index=otel_traces / sourcetype=otel:span (single index -> dedicated HEC).
  open_telemetry:in_otel:
    id: in_otel
    type: open_telemetry
    disabled: false
    host: "0.0.0.0"
    port: {{ cribl_stream_otel_port }}
    protocol: http
    # Must match the destination's OTLP version: the input's default (0.10.0)
    # decodes into instrumentation_library_* field names that a 1.3.1
    # destination cannot re-serialize ("Event had no scope_spans"), silently
    # dropping every span.
    otlpVersion: "1.3.1"
    # Spans must be extracted into first-class span events: with extraction off
    # the OTel destination cannot re-serialize the wrapped payload and drops
    # every event ("Event had no scope_metrics or __criblMetrics").
    extractSpans: true
    extractMetrics: false
    # Log records become first-class events too: the api_request event is the
    # only per-request token record the producers emit. Each leg below filters
    # to its own signal, so turning this on adds nothing to the trace legs.
    extractLogs: true
    sendToRoutes: false
    connections:
{% if (cribl_stream_hec_namespace | default('')) | length > 0 %}
      # One index per HEC: OTLP traces are single-index (otel_traces).
      - output: splunk_hec_otel_traces
        pipeline: otel_stamp
{% else %}
      - output: splunk_hec
        pipeline: otel_stamp
{% endif %}
      # Second leg of the same input: the otel_traces pipeline drops every
      # non-trace signal before Langfuse (which ingests traces only and backs
      # its queue up on anything else). Splunk leg above is unchanged.
      - output: langfuse_otlp
        pipeline: otel_traces
      # Third leg: OTLP log records only, stamped for the ai_usage index.
{% if (cribl_stream_hec_namespace | default('')) | length > 0 %}
      - output: splunk_hec_ai_usage
        pipeline: otel_logs
{% else %}
      - output: splunk_hec
        pipeline: otel_logs
{% endif %}
    pqEnabled: {{ cribl_stream_pq_enabled | lower }}
