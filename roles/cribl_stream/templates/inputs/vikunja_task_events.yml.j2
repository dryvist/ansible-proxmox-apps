{% if cribl_stream_vikunja_task_events_enabled | default(false) | bool %}
  http:vikunja_task_events:
    id: vikunja_task_events
    type: http
    disabled: false
    host: "0.0.0.0"
    port: {{ cribl_stream_vikunja_task_events_port }}
    authTokens:
      - token: "{{ cribl_stream_vikunja_task_events_header_value | default(undef(hint='VIKUNJA_TASK_EVENTS_PASSWORD must be non-empty when cribl_stream_vikunja_task_events_enabled is true'), true) }}"
        description: Vikunja project task events
    pipeline: ansi_csi_strip
    sendToRoutes: false
    connections:
      - output: vikunja_task_events_splunk
        pipeline: vikunja_task_events
    pqEnabled: {{ cribl_stream_pq_enabled | lower }}
{% endif %}
