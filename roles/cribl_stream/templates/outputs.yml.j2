---
# Cribl Stream outputs configuration
# Generated by Ansible

outputs:
  splunk_hec:
    id: splunk_hec
    type: splunk_hec
    disabled: false
    url: "{{ cribl_stream_splunk_hec_url }}"
    token: "{{ cribl_stream_splunk_hec_token }}"
{% if (cribl_stream_splunk_hec_post_processing_pipeline | default('')) | length > 0 %}
    # Post-processing pipeline: the last thing every event passes through
    # before it leaves for Splunk. Placing the redaction here rather than in
    # each producer's own pack makes it one choke point for all of them, and
    # one that a new producer cannot be added around.
    pipeline: "{{ cribl_stream_splunk_hec_post_processing_pipeline }}"
{% endif %}
    concurrency: 5
    maxPayloadSizeKB: 4096
    maxPayloadEvents: 0
    compress: true
    rejectUnauthorized: {{ cribl_stream_splunk_hec_tls_verify | lower }}
    timeoutSec: 30
    flushPeriodSec: 1
    useRoundRobinDns: false
    failedRequestLoggingMode: payload
    safeHeaders: []
    onBackpressure: block
    pqEnabled: {{ cribl_stream_pq_enabled | lower }}
    pqPath: "$CRIBL_HOME/state/queues"
    pqMaxFileSize: "1 GB"
    pqMaxSize: "10 GB"
    pqCompress: none
{% if (cribl_stream_hec_namespace | default('')) | length > 0 %}
{% for idx in cribl_stream_per_index_indexes %}
  # Dedicated HEC output for index '{{ idx }}'. Token = uuid5('splunk-hec-{{ idx }}',
  # HEC_NAMESPACE) — identical to the Splunk-side per-index token.
  splunk_hec_{{ idx }}:
    id: splunk_hec_{{ idx }}
    type: splunk_hec
    disabled: false
    url: "{{ cribl_stream_splunk_hec_url }}"
    token: "{{ ('splunk-hec-' ~ idx) | to_uuid(cribl_stream_hec_namespace) }}"
{% if (cribl_stream_splunk_hec_post_processing_pipeline | default('')) | length > 0 %}
    # Same choke point as the base output above; a per-index HEC bypasses it
    # entirely otherwise, and every AI index goes through one of these.
    pipeline: "{{ cribl_stream_splunk_hec_post_processing_pipeline }}"
{% endif %}
    concurrency: 5
    maxPayloadSizeKB: 4096
    maxPayloadEvents: 0
    compress: true
    rejectUnauthorized: {{ cribl_stream_splunk_hec_tls_verify | lower }}
    timeoutSec: 30
    flushPeriodSec: 1
    useRoundRobinDns: false
    failedRequestLoggingMode: payload
    safeHeaders: []
    onBackpressure: block
    pqEnabled: {{ cribl_stream_pq_enabled | lower }}
    pqPath: "$CRIBL_HOME/state/queues"
    pqMaxFileSize: "1 GB"
    pqMaxSize: "10 GB"
    pqCompress: none
{% endfor %}
{% endif %}

{% if cribl_stream_alerts_ntfy_url | default('') | length > 0 %}
  # Grafana's HEC alert leg publishes the filtered event to the existing ntfy
  # topic. The ntfy subscriber owns Slack delivery for all issue severities.
  ntfy_grafana_alerts:
    id: ntfy_grafana_alerts
    type: webhook
    disabled: false
    url: "{{ cribl_stream_alerts_ntfy_url }}"
    method: POST
    format: custom
    customSourceExpression: _raw
    customContentType: text/plain
    customDropWhenNull: true
    maxPayloadEvents: 1
    compress: false
    rejectUnauthorized: true
    timeoutSec: 30
    flushPeriodSec: 1
    concurrency: 1
    onBackpressure: queue
    pqMode: error
    pqPath: "$CRIBL_HOME/state/queues"
    pqMaxFileSize: "1 MB"
    pqMaxSize: "100 MB"
    pqCompress: none
    pqOnBackpressure: drop
{% endif %}

  # Langfuse OTLP destination for the LLM fabric traces (basic auth with the
  # project keypair, same keys the langfuse role provisions at first boot).
  langfuse_otlp:
    id: langfuse_otlp
    type: open_telemetry
    disabled: false
    protocol: http
    endpoint: "{{ cribl_stream_langfuse_url }}"
    otlpVersion: "1.3.1"
    authType: basic
    username: "{{ cribl_stream_langfuse_public_key }}"
    password: "{{ cribl_stream_langfuse_secret_key }}"
    # WHAT: a secondary sink dropping must not gate in_otel admission.
    onBackpressure: drop
    pqEnabled: true
    pqPath: "$CRIBL_HOME/state/queues"
    pqMaxFileSize: "1 GB"
    pqMaxSize: "5 GB"
    pqCompress: none

  # VictoriaMetrics remote_write — fan-out sibling of the Splunk leg on
  # in_prometheus_rw. Receives the same keep-list samples Prometheus already
  # posts to Stream (including job=gatus). Internal-only; no Traefik.
  victoriametrics_rw:
    id: victoriametrics_rw
    type: prometheus
    disabled: false
    url: "{{ cribl_stream_victoriametrics_rw_url }}"
    concurrency: 5
    maxPayloadSizeKB: 4096
    maxPayloadEvents: 0
    rejectUnauthorized: false
    timeoutSec: 30
    flushPeriodSec: 1
    useRoundRobinDns: false
    failedRequestLoggingMode: none
    safeHeaders: []
    # Secondary fan-out: drop on backpressure so a down sink never blocks
    # the route feeding Splunk.
    onBackpressure: drop

{% if cribl_stream_prometheus_rw_url | default('') | trim | length > 0 %}
  # Prometheus remote_write — fan-out sibling of the VictoriaMetrics leg for
  # native Edge GPU metrics. The receiver is enabled by inventory.
  prometheus_rw:
    id: prometheus_rw
    type: prometheus
    disabled: false
    url: "{{ cribl_stream_prometheus_rw_url }}"
    concurrency: 5
    maxPayloadSizeKB: 4096
    maxPayloadEvents: 0
    rejectUnauthorized: false
    timeoutSec: 30
    flushPeriodSec: 1
    useRoundRobinDns: false
    failedRequestLoggingMode: none
    safeHeaders: []
    onBackpressure: drop
{% endif %}

  # OTLP metrics from in_otel. VictoriaMetrics uses Prometheus naming, so
  # this destination keeps producer metric names and dimensions intact for
  # dashboards while leaving the existing remote_write receiver unchanged.
  victoriametrics_otlp:
    id: victoriametrics_otlp
    type: open_telemetry
    disabled: false
    protocol: http
    endpoint: "{{ cribl_stream_victoriametrics_otlp_endpoint }}"
    otlpVersion: "1.3.1"
    # Avoid adding Cribl-only dimensions to the producer's label set.
    systemFields: []
    responseRetrySettings:
{% for status in [429, 502, 503, 504] %}
      - httpStatus: {{ status }}
        initialBackoff: 1000
        backoffRate: 2
        maxBackoff: 60000
{% endfor %}
    timeoutRetrySettings:
      timeoutRetry: true
      initialBackoff: 1000
      backoffRate: 2
      maxBackoff: 60000
    responseHonorRetryAfterHeader: true
    # Bound disk use and keep VictoriaMetrics as a secondary fan-out sink.
    onBackpressure: queue
    pqMode: error
    pqOnBackpressure: drop
    pqPath: "$CRIBL_HOME/state/queues"
    pqMaxFileSize: "100 MB"
    pqMaxSize: "1 GB"
    pqCompress: gzip

  # Arize Phoenix OTLP destination — second sink for the same LLM fabric
  # traces (bearer API key minted in the Phoenix UI). Phoenix reads the OTel
  # GenAI / OpenInference attributes as emitted, so this leg gets the
  # otel_traces_phoenix pipeline: same drops and redaction as the Langfuse
  # leg, none of the langfuse.*-prefixed rewrites.
  phoenix_otlp:
    id: phoenix_otlp
    type: open_telemetry
    disabled: false
    protocol: http
    endpoint: "{{ cribl_stream_phoenix_url }}"
    otlpVersion: "1.3.1"
    authType: token
    token: "{{ cribl_stream_phoenix_api_key }}"
    # Bounded exponential backoff on retryable responses and timeouts:
    # 1s doubling to a 60s ceiling, honoring a Retry-After header.
    responseRetrySettings:
{% for status in [429, 502, 503, 504] %}
      - httpStatus: {{ status }}
        initialBackoff: 1000
        backoffRate: 2
        maxBackoff: 60000
{% endfor %}
    timeoutRetrySettings:
      timeoutRetry: true
      initialBackoff: 1000
      backoffRate: 2
      maxBackoff: 60000
    responseHonorRetryAfterHeader: true
    # Batches that exhaust their retries spill to a capped disk queue (error
    # mode: only while the destination is failing); a full queue drops new
    # events, so this secondary sink never gates in_otel admission.
    onBackpressure: queue
    pqMode: error
    pqOnBackpressure: drop
    pqPath: "$CRIBL_HOME/state/queues"
    pqMaxFileSize: "100 MB"
    pqMaxSize: "1 GB"
    pqCompress: gzip
