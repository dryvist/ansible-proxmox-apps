[Unit]
# {{ ansible_managed }}
Description=Poll the autonomous agent task queue every {{ agent_guest_queue_poll_interval }}

[Timer]
OnBootSec={{ agent_guest_queue_poll_interval }}
OnUnitInactiveSec={{ agent_guest_queue_poll_interval }}
# Spread the poll so a fleet of agent guests does not hit the queue in lockstep.
RandomizedDelaySec=30
Persistent=true

[Install]
WantedBy=timers.target
