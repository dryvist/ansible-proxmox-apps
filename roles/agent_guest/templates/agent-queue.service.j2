[Unit]
# {{ ansible_managed }}
# Queue poller: lists the task queue and starts one agent-task@<id> per entry.
# Runs as root because its only privileged action is `systemctl start`; it never
# touches a task payload or a credential.
Description=Poll the autonomous agent task queue
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{ agent_guest_queue_poll_bin }}
