storage: {{ verdaccio_cache_storage_dir }}
listen: {{ verdaccio_cache_bind_address }}:{{ verdaccio_cache_port }}

auth:
  htpasswd:
    file: {{ verdaccio_cache_htpasswd_file }}
    max_users: -1

uplinks:
  npmjs:
    url: https://registry.npmjs.org/
    cache: true

packages:
  '**':
    access: $all
    publish: $authenticated
    unpublish: $authenticated
    proxy: npmjs

web:
  enable: true

log:
  type: stdout
  format: pretty
  level: http
