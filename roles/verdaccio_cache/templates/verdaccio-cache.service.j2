[Unit]
Description=Verdaccio npm package cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ verdaccio_cache_service_user }}
Group={{ verdaccio_cache_service_group }}
WorkingDirectory={{ verdaccio_cache_data_dir }}
Environment=PATH={{ verdaccio_cache_node_dir }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart={{ verdaccio_cache_app_dir }}/bin/verdaccio --config {{ verdaccio_cache_config_file }}
Restart=on-failure
RestartSec=5
StateDirectory=verdaccio
StateDirectoryMode=0750
{% include _service_hardening_template %}
ReadWritePaths={{ verdaccio_cache_data_dir }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
