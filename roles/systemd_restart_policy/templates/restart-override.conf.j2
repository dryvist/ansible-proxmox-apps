[Unit]
StartLimitIntervalSec={{ systemd_restart_policy_start_limit_interval_sec }}
{% if systemd_restart_policy_start_limit_interval_sec | string not in ['0', '0s'] %}
StartLimitBurst={{ systemd_restart_policy_start_limit_burst }}
{% endif %}

[Service]
Restart={{ systemd_restart_policy_restart }}
RestartSec={{ systemd_restart_policy_restart_sec }}
{% if systemd_restart_policy_restart_steps | int > 0 %}
{# systemd silently IGNORES RestartMaxDelaySec unless RestartSteps is also set
   (verified against systemd 257 with systemd-analyze verify), so these two are
   emitted together or not at all. #}
RestartSteps={{ systemd_restart_policy_restart_steps }}
RestartMaxDelaySec={{ systemd_restart_policy_restart_max_delay_sec }}
{% endif %}
