{{ ansible_managed | comment }}
# Daily Leantime database backup. The randomized delay spreads the load on the host.
[Unit]
Description=Daily Leantime database backup

[Timer]
OnCalendar={{ leantime_backup_on_calendar }}
RandomizedDelaySec={{ leantime_backup_randomized_delay_sec }}
Persistent=true

[Install]
WantedBy=timers.target
