{{ ansible_managed | comment }}
# Leantime vhost. Traefik terminates TLS and forwards here on {{ leantime_port }}.
# The application front controller is public/index.php under PHP-FPM.
server {
    listen {{ leantime_port }} default_server;
    server_name _;

    root {{ leantime_web_root }};
    index index.php;

    client_max_body_size 100M;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass unix:/run/php/php{{ leantime_php_version }}-fpm.sock;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_read_timeout 300;
    }

    location ~ /\. {
        deny all;
    }

    location ^~ /dist/ {
        expires 7d;
        access_log off;
    }
}
