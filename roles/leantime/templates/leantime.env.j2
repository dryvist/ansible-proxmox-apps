{{ ansible_managed | comment }}
# Leantime runtime configuration. Leantime reads this file from config/.env.
# Keys follow the upstream config/sample.env for v3.13.2.

# Public base URL. Links, cookies and the OIDC callback
# (<LEAN_APP_URL>/oidc/callback) are built from it.
LEAN_APP_URL = '{{ leantime_public_url }}'
LEAN_DEBUG = 0
LEAN_SESSION_SECURE = true
LEAN_ALLOW_TELEMETRY = {{ leantime_allow_telemetry | bool | lower }}

LEAN_DB_HOST = '{{ leantime_db_host }}'
LEAN_DB_PORT = '{{ leantime_db_port }}'
LEAN_DB_DATABASE = '{{ leantime_db_name }}'
LEAN_DB_USER = '{{ leantime_db_user }}'
LEAN_DB_PASSWORD = '{{ leantime_db_password }}'

LEAN_SESSION_PASSWORD = '{{ leantime_session_password }}'

# Relative to the install directory. The daily backup timer writes here too.
LEAN_DB_BACKUP_PATH = '{{ leantime_db_backup_path }}'

LEAN_OIDC_ENABLE = true
LEAN_OIDC_CLIENT_ID = '{{ leantime_oidc_client_id }}'
LEAN_OIDC_CLIENT_SECRET = '{{ leantime_oidc_client_secret }}'
LEAN_OIDC_PROVIDER_URL = '{{ leantime_oidc_provider_url }}'
LEAN_OIDC_CREATE_USER = {{ leantime_oidc_create_user | bool | lower }}
