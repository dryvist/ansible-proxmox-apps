{{ ansible_managed | comment }}
# Homarr runtime environment. The community-scripts installer wrote this file
# once at install time; from here on Ansible owns it.
#
# SECRET_ENCRYPTION_KEY is NOT generated here. It is read back from whatever is
# already on disk (tasks/configure.yml) and only minted when absent, because it
# is the AES-256-CBC key for every row in `integrationSecret`. Rotating it does
# not invalidate those rows — it makes them undecryptable, silently, and the
# only symptom is every integration failing at once. Treat it as data, not as a
# credential to rotate.
DB_DRIVER='{{ homarr_db_driver }}'
DB_DIALECT='{{ homarr_db_dialect }}'
DB_URL='{{ homarr_db_url }}'
SECRET_ENCRYPTION_KEY='{{ homarr_effective_encryption_key }}'
TURBO_TELEMETRY_DISABLED=1
NODE_ENV='production'
REDIS_IS_EXTERNAL='true'

# `credentials` must stay enabled even once OIDC is live: Homarr's
# `user.initUser` calls throwIfCredentialsDisabled(), so an OIDC-only instance
# cannot be bootstrapped without a human. The local admin is Ansible's service
# account for the API — humans sign in through Authelia.
AUTH_PROVIDERS='{{ homarr_auth_providers }}'
{% if homarr_oidc_enabled %}
AUTH_OIDC_ISSUER='{{ homarr_oidc_issuer }}'
AUTH_OIDC_CLIENT_ID='{{ homarr_oidc_client_id }}'
AUTH_OIDC_CLIENT_SECRET='{{ homarr_oidc_client_secret }}'
AUTH_OIDC_CLIENT_NAME='{{ homarr_oidc_client_name }}'
AUTH_OIDC_AUTO_LOGIN='{{ homarr_oidc_auto_login | lower }}'
{% endif %}
