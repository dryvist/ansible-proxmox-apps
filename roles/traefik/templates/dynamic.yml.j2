{# Dynamic Traefik config — routers + services generated from the OpenTofu
   inventory (traefik_routes, built in tasks/main.yml). Each router requests the
   single wildcard *.{{ traefik_base_domain }} cert so Traefik issues it once and
   serves it for every host. Managed by Ansible (traefik role). Do not edit. #}
{# The Authelia forwardAuth middleware dials the authelia BACKEND url directly
   (its ingress-row server), never authelia.<domain> — that FQDN CNAMEs back to
   Traefik itself and would loop. Routes opt in via the tofu-owned sso flag;
   when no authelia route exists in the inventory nothing is gated (safe
   pre-cutover rollout). #}
{% set authelia_routes = traefik_routes | selectattr('name', 'equalto', 'authelia') | list %}
{% set openbao_routes = traefik_routes | selectattr('name', 'equalto', 'openbao') | list %}
{% set sso_enabled = authelia_routes | length > 0 %}
{# Wall/glance kiosk bypass: a second router per eligible sso route, ClientIP-
   scoped, with no authelia middleware -- see roles/traefik/defaults/main.yml
   traefik_wall_kiosk_*. Built once here so every route in the loop below
   reuses the same clause. #}
{% set kiosk_networks = traefik_wall_kiosk_networks | default([]) %}
{% set kiosk_clientip_rules = [] %}
{% for _n in kiosk_networks %}{% set _ = kiosk_clientip_rules.append('ClientIP(`' ~ _n ~ '`)') %}{% endfor %}
http:
  routers:
{% if traefik_openbao_oauth_callback_enabled and openbao_routes | length > 0 %}
    openbao-oauth-callback:
      rule: "Host(`{{ openbao_routes[0].fqdn }}`) && Path(`{{ traefik_openbao_oauth_callback_path }}`)"
      priority: {{ traefik_openbao_oauth_callback_priority }}
      # noop@internal returns a fixed 418 and retains no authorization code.
      # Do not attach Authelia: it would redirect the OAuth return URL.
      service: noop@internal
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_base_domain }}"
            sans:
              - "*.{{ traefik_base_domain }}"
{% endif %}
{% for route in traefik_routes %}
{% set _rule = "Host(`" ~ route.fqdn ~ "`)" ~ (" && PathPrefix(`" ~ route.path_prefix ~ "`)" if route.path_prefix | default('') | length > 0 else "") %}
{% set _priority = route.priority | default(0) | int %}
{# Traefik's own default priority (left unset) is the rule string's length --
   longer rules win ties. Computed here so the kiosk router below can always
   render an explicit priority higher than whatever the base router actually
   runs at, whether or not the base row set one. #}
{% set _effective_priority = _priority if _priority > 0 else _rule | length %}
    {{ route.name }}:
      rule: "{{ _rule }}"
{% if _priority > 0 %}
      priority: {{ _priority }}
{% endif %}
      service: {{ route.name }}
      entryPoints:
        - websecure
{# strip-remote-headers goes on EVERY router, ahead of authelia, and is not
   optional: an app that trusts Remote-User (Zammad's auth_sso) would otherwise
   accept whatever a client sent. Ungated and bypassed paths need it MOST —
   they never reach Authelia, so nothing else would overwrite a forged header.
   Authelia re-adds the real values via authResponseHeaders on gated routes. #}
{# route.name != 'authelia': the portal must never gate itself (auth loop),
   even if its inventory row is ever mis-flagged sso: true. #}
      middlewares:
        - strip-remote-headers
{% if route.root_redirect | default('') | length > 0 %}
        - {{ route.name }}-root-redirect
{% endif %}
{% if sso_enabled and route.name != 'authelia' and route.sso | default(false) %}
        - authelia
{% endif %}
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_base_domain }}"
            sans:
              - "*.{{ traefik_base_domain }}"
{% if sso_enabled and route.sso | default(false) and route.name in traefik_wall_kiosk_route_names and kiosk_networks | length > 0 %}
{# Same router as above in every way except the rule gains a ClientIP match
   and authelia is dropped from the middleware chain -- the display-only
   kiosk cannot complete a login, so it needs to reach this route even while
   Authelia itself is unreachable. Priority is always explicit and one above
   the base router's own effective priority, so this can never win a tie
   against it for a client outside the kiosk networks. #}
    {{ route.name }}-kiosk:
      rule: "{{ _rule }} && ({{ kiosk_clientip_rules | join(' || ') }})"
      priority: {{ _effective_priority + 1 }}
      service: {{ route.name }}
      entryPoints:
        - websecure
      middlewares:
        - strip-remote-headers
{% if route.root_redirect | default('') | length > 0 %}
        - {{ route.name }}-root-redirect
{% endif %}
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_base_domain }}"
            sans:
              - "*.{{ traefik_base_domain }}"
{% endif %}
{% endfor %}
{% if traefik_dashboard_enabled %}
    dashboard:
      rule: "Host(`traefik.{{ traefik_base_domain }}`)"
      service: api@internal
      entryPoints:
        - websecure
      middlewares:
        - strip-remote-headers
{# Authelia gates the public dashboard so the operator signs in with the estate
   identity. If SSO is unavailable (no authelia row in the inventory) this MUST
   fall back to basicAuth — the dashboard is never left unauthenticated. #}
{% if sso_enabled and traefik_dashboard_sso %}
        - authelia
{% else %}
        - dashboard-auth
{% endif %}
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_base_domain }}"
            sans:
              - "*.{{ traefik_base_domain }}"
{% if traefik_dashboard_breakglass_enabled %}
{# Break-glass: its own private entryPoint, basicAuth only, no Host rule. This
   router must NEVER carry the authelia middleware — its whole purpose is to
   still work when Authelia does not. #}
    dashboard-breakglass:
      rule: "PathPrefix(`/`)"
      service: api@internal
      entryPoints:
        - {{ traefik_dashboard_breakglass_entrypoint }}
      middlewares:
        - strip-remote-headers
        - dashboard-auth
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_base_domain }}"
            sans:
              - "*.{{ traefik_base_domain }}"
{% endif %}
{% endif %}

  services:
{% for route in traefik_routes %}
{% if route.failover_fallback %}
{# A route carrying failover_fallback publishes a `failover` service under its
   OWN name (so the router's `service: {{ route.name }}` needs no change) that
   points at two ordinary loadBalancer services suffixed -primary/-fallback.
   Traefik only sends traffic to -fallback when -primary has no healthy
   server left — e.g. openbao's leader-election gap, where the primary pool
   (active-only health check) can briefly go to zero. #}
    {{ route.name }}:
      failover:
        service: {{ route.name }}-primary
        fallback: {{ route.name }}-fallback
        healthCheck: {}
    {{ route.name }}-primary:
      loadBalancer:
        passHostHeader: true
        servers:
{% for url in route.servers %}
          - url: "{{ url }}"
{% endfor %}
        healthCheck:
          scheme: "{{ route.scheme | default('http') }}"
          path: "{{ route.health_check_path | default('/') }}"
          interval: "{{ route.health_check_interval | default('10s') }}"
          timeout: "{{ route.health_check_timeout | default('5s') }}"
    {{ route.name }}-fallback:
      loadBalancer:
        passHostHeader: true
        servers:
{% for url in route.failover_fallback.servers %}
          - url: "{{ url }}"
{% endfor %}
        healthCheck:
          scheme: "{{ route.scheme | default('http') }}"
          path: "{{ route.failover_fallback.health_check_path }}"
          interval: "{{ route.failover_fallback.health_check_interval }}"
          timeout: "{{ route.failover_fallback.health_check_timeout }}"
{% else %}
    {{ route.name }}:
      loadBalancer:
        passHostHeader: true
{% if route.strategy | default('') | length > 0 %}
        strategy: "{{ route.strategy }}"
{% endif %}
{% if route.sticky | default(false) %}
        sticky:
          cookie:
            name: "{{ route.name }}_lb"
            secure: true
            httpOnly: true
{% endif %}
        servers:
{% for url in route.servers %}
          - url: "{{ url }}"
{% endfor %}
{% if route.health_check | default(false) %}
{# health_check_path comes from the tofu ingress contract. A hardcoded "/"
   ejects every server of any backend whose root is not 200 - an API that only
   answers on /health looks entirely down. Default "/" keeps legacy routes
   byte-identical. Keep comments at column 0, never indented inside the emitted
   block: the stripped comment leaves its leading whitespace behind and
   corrupts the YAML. #}
        healthCheck:
          scheme: "{{ route.scheme | default('http') }}"
          path: "{{ route.health_check_path | default('/') }}"
{% if route.health_check_port | default(0) %}
{# Probe a different port than the traffic port (e.g. agentgateway: proxy 8080
   answers 404/406 to plain GETs, health lives on the stats port's /metrics). #}
          port: {{ route.health_check_port }}
{% endif %}
{# Interval and timeout are per-route, defaulting to the historic 10s/5s so every
   existing route renders byte-identical. A route overrides them only when its
   backend set has a reason to be probed less twitchily. #}
          interval: "{{ route.health_check_interval | default('10s') }}"
          timeout: "{{ route.health_check_timeout | default('5s') }}"
{% endif %}
{% if route.response_header_timeout | default('') %}
        serversTransport: {{ route.name }}
{% elif route.insecure_tls | default(false) %}
        serversTransport: insecure-backend
{% endif %}
{% endif %}
{% endfor %}
{% set _insecure_routes = traefik_routes | selectattr('insecure_tls', 'defined') | selectattr('insecure_tls') | rejectattr('response_header_timeout') | list %}
{% set _timed_routes = traefik_routes | selectattr('response_header_timeout', 'defined') | selectattr('response_header_timeout') | list %}
{% if _insecure_routes or _timed_routes %}

  serversTransports:
{% for route in _timed_routes %}
{# A route whose ingress row carries response_header_timeout gets its own
   transport: the backend bounds its own request lifetime, so the ingress
   waits for its headers as long as the row says ("0s" = no limit) while the
   dial stays bounded like everywhere else. #}
    {{ route.name }}:
      forwardingTimeouts:
        dialTimeout: "{{ traefik_backend_dial_timeout }}"
        responseHeaderTimeout: "{{ route.response_header_timeout }}"
{% if route.insecure_tls | default(false) %}
      insecureSkipVerify: true
{% endif %}
{% endfor %}
{% endif %}
{% if _insecure_routes %}
    # Backends serving HTTPS with a self-signed cert (e.g. Splunk Web). Traefik
    # terminates the public wildcard cert and re-encrypts to the backend; the
    # backend cert is not chain-verifiable, so skip verification for these only.
    insecure-backend:
      insecureSkipVerify: true
{# A NAMED transport does not inherit the default one's forwardingTimeouts, so
   these have to be repeated here. Without them these routes keep Traefik's own
   default of no response-header timeout at all, and the unbounded hang the
   default transport exists to prevent comes straight back for exactly the
   backends that are hardest to reason about. #}
      forwardingTimeouts:
        dialTimeout: "{{ traefik_backend_dial_timeout }}"
        responseHeaderTimeout: "{{ traefik_backend_response_header_timeout }}"
{% endif %}

  middlewares:
{# Always defined — every router references it, and an undefined middleware
   makes Traefik drop the whole router. Setting a header to "" removes it from
   the forwarded request, so a client cannot smuggle an identity into an app
   that trusts these (Zammad auth_sso). This is the control that makes header
   trust safe; do not make it conditional on sso_enabled. #}
    strip-remote-headers:
      headers:
        customRequestHeaders:
          Remote-User: ""
          Remote-Groups: ""
          Remote-Email: ""
          Remote-Name: ""
{# root_redirect (tofu-owned, optional): one redirectRegex per route, matching
   only that route's own bare root, referenced solely by that route's own
   router — never a shared middleware. #}
{% for route in traefik_routes %}
{% if route.root_redirect | default('') | length > 0 %}
    {{ route.name }}-root-redirect:
      redirectRegex:
        regex: "^https?://[^/]+/?$"
        replacement: "https://{{ route.fqdn }}{{ route.root_redirect }}"
{% endif %}
{% endfor %}
{% if traefik_dashboard_enabled %}
    dashboard-auth:
      basicAuth:
        usersFile: "{{ traefik_dashboard_users_file }}"
{% endif %}
{% if sso_enabled %}
    authelia:
      forwardAuth:
        address: "{{ authelia_routes[0].servers[0] }}/api/authz/forward-auth"
        authResponseHeaders:
          - Remote-User
          - Remote-Groups
          - Remote-Email
          - Remote-Name
{% endif %}
