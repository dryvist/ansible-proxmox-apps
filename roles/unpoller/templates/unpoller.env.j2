# {{ ansible_managed }}
# unpoller reads its entire configuration from UP_* environment variables.
# 0600, owned by {{ unpoller_user }} -- holds the controller password.
UP_POLLER_DEBUG=false
UP_INFLUXDB_DISABLE=true
UP_PROMETHEUS_DISABLE=false
UP_PROMETHEUS_HTTP_LISTEN={{ unpoller_listen_address }}:{{ unpoller_metrics_port }}
UP_UNIFI_DEFAULT_URL={{ unpoller_controller_url }}
UP_UNIFI_DEFAULT_USER={{ unpoller_controller_user }}
UP_UNIFI_DEFAULT_PASS={{ unpoller_controller_password }}
UP_UNIFI_DEFAULT_VERIFY_SSL={{ unpoller_controller_verify_ssl | lower }}
UP_UNIFI_DEFAULT_SAVE_SITES=true
UP_UNIFI_DEFAULT_SAVE_DPI=true
UP_UNIFI_DEFAULT_SITES={{ unpoller_sites }}
