# {{ ansible_managed }}
[Unit]
Description=unpoller (UniFi controller poller, v{{ unpoller_version }})
Documentation=https://unpoller.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ unpoller_user }}
Group={{ unpoller_user }}
EnvironmentFile=/etc/unpoller.env
ExecStart=/usr/local/bin/unpoller

Restart=on-failure
RestartSec=5s

# Outbound poller + read-only metrics daemon: lock it down.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
