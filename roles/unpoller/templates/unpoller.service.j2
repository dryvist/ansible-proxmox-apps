# {{ ansible_managed }}
[Unit]
Description=unpoller (UniFi controller poller, v{{ unpoller_version }})
Documentation=https://unpoller.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ unpoller_user }}
Group={{ unpoller_user }}
EnvironmentFile=/etc/unpoller.env
ExecStart=/usr/local/bin/unpoller --config /etc/unpoller.conf

Restart=on-failure
RestartSec=5s

# Outbound poller + read-only metrics daemon: lock it down. The mount
# namespace directives fail with status=226/NAMESPACE in an unprivileged
# LXC, so they apply only outside a container (same gate as node_exporter).
NoNewPrivileges=true
{% if _unpoller_virt_container.rc | default(1) != 0 %}
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectControlGroups=true
{% endif %}

[Install]
WantedBy=multi-user.target
