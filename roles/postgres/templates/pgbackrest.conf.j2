# {{ ansible_managed }}
# pgBackRest configuration for point-in-time recovery to S3-compatible storage.
# repo1 is the homelab RustFS endpoint. repo2, when enabled, is the offsite
# Backblaze B2 endpoint: pgBackRest writes both repos itself, so the copies
# cannot drift. An out-of-band mirror used to fill that role and silently copied
# a truncated subset (#1027) — do not reintroduce one.
[global]
repo1-type=s3
repo1-s3-bucket={{ postgres_backup_s3_bucket }}
repo1-s3-endpoint={{ postgres_backup_s3_endpoint }}
repo1-s3-region={{ postgres_backup_s3_region }}
repo1-s3-uri-style={{ postgres_backup_s3_uri_style }}
repo1-s3-key={{ postgres_backup_s3_access_key_id }}
repo1-s3-key-secret={{ postgres_backup_s3_secret_access_key }}
repo1-path={{ postgres_pgbackrest_repo_path }}
repo1-retention-full={{ postgres_pgbackrest_retention_full }}
{% if postgres_pgbackrest_repo1_cipher_type != 'none' %}
repo1-cipher-type={{ postgres_pgbackrest_repo1_cipher_type }}
repo1-cipher-pass={{ postgres_pgbackrest_repo1_cipher_pass }}
{% endif %}
{% if postgres_pgbackrest_repo2_enabled | bool %}
repo2-type=s3
repo2-s3-bucket={{ postgres_backup_repo2_s3_bucket }}
repo2-s3-endpoint={{ postgres_backup_repo2_s3_endpoint }}
repo2-s3-region={{ postgres_backup_repo2_s3_region }}
repo2-s3-uri-style={{ postgres_backup_repo2_s3_uri_style }}
repo2-s3-key={{ postgres_backup_repo2_s3_access_key_id }}
repo2-s3-key-secret={{ postgres_backup_repo2_s3_secret_access_key }}
repo2-path={{ postgres_pgbackrest_repo2_path }}
repo2-retention-full={{ postgres_pgbackrest_repo2_retention_full }}
{% if postgres_pgbackrest_repo2_cipher_type != 'none' %}
repo2-cipher-type={{ postgres_pgbackrest_repo2_cipher_type }}
repo2-cipher-pass={{ postgres_pgbackrest_repo2_cipher_pass }}
{% endif %}
{% endif %}
{% if postgres_pgbackrest_archive_async | bool %}
# Asynchronous archiving: pushes are batched and parallelized by a background
# process; the spool holds only its acknowledgement files, not WAL. The queue
# bound is what keeps a repo outage from filling pg_wal and halting the
# primary: past the limit pgBackRest acks and DROPS segments (warning in the
# PostgreSQL log), trading a PITR gap until the next base backup for primary
# availability. See roles/postgres/defaults/main.yml.
archive-async=y
spool-path={{ postgres_pgbackrest_spool_path }}
archive-push-queue-max={{ postgres_pgbackrest_queue_max }}
{% endif %}
# zstd compression + parallelism keep base backups small and fast over the LAN.
compress-type=zst
process-max=2
start-fast=y
log-level-console=info
log-level-file=detail

[{{ postgres_pgbackrest_stanza }}]
pg1-path={{ postgres_data_dir }}
pg1-port={{ postgres_port }}
