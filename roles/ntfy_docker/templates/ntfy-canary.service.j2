{{ ansible_managed | comment }}
[Unit]
Description=Publish the end-to-end ntfy canary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/curl -fsS --max-time 10 --retry 3 -o /dev/null -H "Priority: min" -d "canary from %H" {{ ntfy_docker_base_url }}/{{ ntfy_docker_canary_topic }}
