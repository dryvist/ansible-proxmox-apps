{{ ansible_managed | comment }}
[Unit]
Description=ntfy-to-slack fan-out for topic %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile={{ ntfy_docker_to_slack_env_dir }}/%i.env
ExecStart={{ ntfy_docker_to_slack_install_dir }}/ntfy-to-slack
Restart=on-failure
RestartSec=5
DynamicUser=true

[Install]
WantedBy=multi-user.target
