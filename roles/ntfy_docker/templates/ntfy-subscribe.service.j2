{{ ansible_managed | comment }}
[Unit]
Description=ntfy CLI subscriber (Zammad ticket bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile={{ ntfy_docker_zammad_env_file }}
ExecStart=/usr/bin/ntfy subscribe --from-config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
