{#- Groups and app names come from the shared catalog's UI rows; Gatus names its
    endpoints after the same rows, so each hex matches its series. -#}
{%- set _groups = [] -%}
{%- for grp, rows in (dashboard_catalog_services | default([]) | selectattr('ui') | groupby('group')) -%}
{%- set _ = _groups.append({'name': grp, 'apps': rows | map(attribute='name') | list}) -%}
{%- endfor -%}
{#- A node with no distinct role maps to ITS OWN NAME, not an empty string —
    the wall's mc1.js reads nodeRoles[name] === name as "no role" and shows
    nothing; nodeRoles[name] === '' would instead render a blank role label. -#}
{%- set _roles = {} -%}
{%- for name, node in (tofu_data.nodes | default({})) | dictsort -%}
{%- if node.commissioned | default(true) -%}
{%- set _ = _roles.update({name: node.role | default(name, true)}) -%}
{%- endif -%}
{%- endfor -%}
{{ {
  'title': wall_title,
  'refreshSeconds': wall_refresh_seconds | int,
  'guestCount': (tofu_data.containers | default({}) | length) + (tofu_data.vms | default({}) | length),
  'nodeRoles': _roles,
  'extraNodes': wall_extra_nodes,
  'groups': _groups,
  'slides': wall_slides,
} | to_nice_json }}
