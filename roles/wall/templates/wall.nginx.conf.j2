{{ ansible_managed | comment }}
# The gateway (wall-feed.conf) names this upstream; its address comes from the
# published inventory.
upstream prometheus {
    server {{ wall_prometheus_host | trim }}:{{ wall_prometheus_port | trim }};
    keepalive 4;
}

server {
    listen {{ wall_port | trim }} default_server;
    listen [::]:{{ wall_port | trim }} default_server;
    server_name _;

    # Traefik terminates TLS and proxies here on wall_port; without this,
    # nginx's own directory-trailing-slash redirects are absolute and leak
    # this internal scheme and port straight to the browser.
    absolute_redirect off;

    root {{ wall_site_dir }};
    index index.html;

    location = /config.json {
        alias {{ wall_config_dir }}/config.json;
        add_header Cache-Control "no-store" always;
    }

    include wall-feed.conf;

    location / {
        # Restated here, not only at server scope above: this is the
        # location whose try_files fallback generates the directory
        # trailing-slash redirect, so it is asserted directly on the
        # location that emits it rather than relied on by inheritance.
        absolute_redirect off;
        try_files $uri $uri/ =404;
    }
}
