{{ ansible_managed | comment }}
# The gateway (wall-feed.conf) names this upstream; its address comes from the
# published inventory.
upstream prometheus {
    server {{ wall_prometheus_host | trim }}:{{ wall_prometheus_port | trim }};
    keepalive 4;
}

server {
    listen {{ wall_port | trim }} default_server;
    listen [::]:{{ wall_port | trim }} default_server;
    server_name _;

    root {{ wall_site_dir }};
    index index.html;

    location = /config.json {
        alias {{ wall_config_dir }}/config.json;
        add_header Cache-Control "no-store" always;
    }

    include wall-feed.conf;

    location / {
        try_files $uri $uri/ =404;
    }
}
