{{ ansible_managed | comment }}
# Included by the gateway's /api/words and /api/llm/recent locations
# (wall-feed.conf). nginx adds the read-only ClickHouse user to every
# proxied request, so the browser never carries the credential.
proxy_set_header X-ClickHouse-User wall_reader;
proxy_set_header X-ClickHouse-Key {{ wall_clickhouse_password }};
