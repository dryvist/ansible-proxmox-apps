[Unit]
Description=devpi package cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ devpi_server_service_user }}
Group={{ devpi_server_service_group }}
WorkingDirectory={{ devpi_server_data_dir }}
ExecStart={{ devpi_server_venv }}/bin/devpi-server --serverdir {{ devpi_server_data_dir }} --host {{ devpi_server_bind_address }} --port {{ devpi_server_port }} --restrict-modify root
Restart=on-failure
RestartSec=5
StateDirectory=devpi-server
StateDirectoryMode=0750
{{ lookup('ansible.builtin.file', _service_hardening_template) }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
