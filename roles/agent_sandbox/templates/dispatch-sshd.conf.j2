Match User {{ agent_sandbox_dispatch_user }}
    AuthorizedKeysFile /etc/ssh/agent-dispatch-keys/{{ agent_sandbox_dispatch_user }}
    AuthorizedPrincipalsFile none
    AuthorizedPrincipalsCommand none
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    ForceCommand {{ agent_sandbox_dispatch_command }}
    DisableForwarding yes
    PermitTTY yes
    PermitUserRC no
{% if agent_sandbox_allow_access_enabled | bool %}
Match User {{ agent_sandbox_allow_user }}
    AuthorizedKeysFile {{ agent_sandbox_allow_authorized_keys_file }}
    AuthorizedPrincipalsFile none
    AuthorizedPrincipalsCommand none
    AuthenticationMethods publickey
    PasswordAuthentication no
    KbdInteractiveAuthentication no
    ForceCommand {{ agent_sandbox_allow_command }}
    DisableForwarding yes
    PermitTTY no
    PermitUserRC no
{% endif %}
Match all
