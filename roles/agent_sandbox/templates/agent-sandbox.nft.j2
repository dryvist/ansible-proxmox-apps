{{ ansible_managed | comment }}
# Backstop for the egress boundary. Docker's internal network already gives
# agent containers no route out; this filter drops, on the host, any forwarded
# packet that leaves the agents bridge or enters it from elsewhere, except the
# published Web port from inventory-listed Traefik — even if a container
# ignores the proxy settings or the network definition drifts.
# The proxy is the only member on both bridges, so the one thing an agent
# container may do on its bridge is open a connection to the proxy port.
# Its own table, so a docker restart or backend change never touches it; the
# chain runs ahead of Docker's own forward rules (lower priority) and plays the
# role of Docker's DOCKER-USER chain. Container addresses are not pinned; the
# Web ingress source is taken from the dynamic inventory.
#
# Loaded as one transaction: the table is declared, deleted and recreated, so
# a reload replaces it atomically and never flushes anything outside it.
table inet {{ agent_sandbox_nft_table }}
delete table inet {{ agent_sandbox_nft_table }}

table inet {{ agent_sandbox_nft_table }} {
  chain DOCKER-USER {
    type filter hook forward priority -10; policy accept;

    # Replies to flows this chain already admitted.
    ct state established,related accept

    # The one inbound exception: Traefik may reach the authenticated Web
    # service through its published host port. Match both its inventory IP
    # and Docker's DNAT to the service container; all other traffic to this
    # bridge remains denied.
{% for source_ip in agent_sandbox_zcode_web_ingress_source_ips %}
    oifname "{{ agent_sandbox_bridge }}" ip saddr {{ source_ip }} tcp dport {{ agent_sandbox_zcode_web_port }} ct status dnat ct original proto-dst {{ agent_sandbox_zcode_web_host_port }} accept
{% endfor %}

    # Agent containers: the proxy port on their own bridge, nothing else.
    iifname "{{ agent_sandbox_bridge }}" oifname "{{ agent_sandbox_bridge }}" tcp dport {{ agent_sandbox_proxy_port }} accept
    iifname "{{ agent_sandbox_bridge }}" limit rate 6/minute log prefix "agent-sandbox-egress-drop: "
    iifname "{{ agent_sandbox_bridge }}" counter drop

    # Nothing from another network is forwarded into the agents bridge.
    oifname "{{ agent_sandbox_bridge }}" counter drop

    # Any other container bridge may not forward at all. The egress bridge
    # carries only the proxy and the log shipper, which are the sanctioned
    # way out.
    iifname "docker0" counter drop
    iifname "br-*" iifname != { "{{ agent_sandbox_bridge }}", "{{ agent_sandbox_egress_bridge }}" } counter drop
  }
}
