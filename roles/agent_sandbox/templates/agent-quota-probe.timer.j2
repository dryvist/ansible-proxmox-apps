# {{ ansible_managed | comment }}
[Unit]
Description=Schedule the {{ item.executor }} provider quota probe

[Timer]
OnCalendar={{ agent_sandbox_quota_probe_calendar }}
RandomizedDelaySec={{ agent_sandbox_quota_probe_random_delay_seconds }}
FixedRandomDelay=true
Persistent=false
Unit=agent-quota-probe-{{ item.executor }}.service

[Install]
WantedBy=timers.target
