# {{ ansible_managed }}
[Unit]
Description=Process one eligible queued ZCode coding task
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=AGENT_IMAGE={{ agent_sandbox_zcode_feeder_image }}
Environment=AGENT_DISPATCH_STATE_DIR={{ agent_sandbox_zcode_feeder_dispatch_state_dir }}
EnvironmentFile={{ agent_sandbox_zcode_dispatcher_env_file }}
EnvironmentFile={{ agent_sandbox_dispatch_alert_env_file }}
EnvironmentFile={{ agent_sandbox_zcode_feeder_env_file }}
ExecStart=/usr/bin/python3 /usr/local/lib/agent-sandbox/zcode_feeder.py --config {{ agent_sandbox_zcode_feeder_config_file }}
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths={{ agent_sandbox_zcode_feeder_dir }} {{ agent_sandbox_zcode_feeder_dispatch_state_dir }}

[Install]
WantedBy=multi-user.target
