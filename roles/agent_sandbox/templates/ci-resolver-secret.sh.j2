#!/usr/bin/env bash
set -euo pipefail

login_token=''
result=''
error='request failed'

fail() {
  error="$1"
  exit 1
}

revoke_login() {
  printf '%s\n' "$login_token" |
    bao-approle revoke-self >/dev/null 2>/dev/null
}

finish() {
  local status=$?
  trap - EXIT
  if [[ -n "$login_token" ]]; then
    if ! revoke_login; then
      status=1
      error='OpenBao token revocation failed'
    fi
    login_token=''
  fi
  if ((status == 0)); then
    printf '%s\n' "$result"
  else
    printf 'ci-resolver-secret: %s\n' "$error" >&2
  fi
  exit "$status"
}
trap finish EXIT

# shellcheck source=/etc/agent-sandbox/agent-dispatch-profile.sh
if ! source /etc/agent-sandbox/agent-dispatch-profile.sh 2>/dev/null; then
  fail 'dispatcher profile could not be read'
fi
if [[ ! "${BAO_ADDR:-}" =~ ^https://[^[:space:]]+$ ]]; then
  fail 'OpenBao address is invalid'
fi

if [[ $# -ne 2 ]]; then
  fail 'expected token or field arguments'
fi

verb="$1"
value="$2"
case "$verb" in
  token)
    if [[ ! "$value" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]]; then
      fail 'repository name is invalid'
    fi
    ;;
  field)
    if [[ ! "$value" =~ ^[A-Z][A-Z0-9_]{0,63}$ ]]; then
      fail 'field name is invalid'
    fi
    ;;
  *)
    fail 'unknown verb'
    ;;
esac

login_token=$(bao-approle login \
  --role-id-file "{{ agent_sandbox_ci_resolver_approle_dir }}/role_id" \
  --secret-id-file "{{ agent_sandbox_ci_resolver_approle_dir }}/secret_id" \
  2>/dev/null) || fail 'OpenBao login failed'

if [[ "$verb" == field ]]; then
  secret_response=$(
    curl --fail --silent --show-error \
      --header @<(printf 'X-Vault-Token: %s\n' "$login_token") \
      "${BAO_ADDR%/}/v1/{{ agent_sandbox_ci_resolver_secret_path }}" 2>/dev/null
  ) || fail 'OpenBao secret read failed'
  result=$(jq -er --arg key "$value" '.data.data[$key] | strings | select(length > 0)' <<<"$secret_response" 2>/dev/null) || fail 'requested field is unavailable'
  unset secret_response
else
  token_output=$(BAO_TOKEN="$login_token" bao-approle gh-token \
    "{{ agent_sandbox_ci_resolver_github_mount }}" \
    "{{ agent_sandbox_ci_resolver_permission_set }}" 2>&1) || {
    login_token=''
    fail 'GitHub installation token request failed'
  }
  # gh-token revokes the login token on every path, so finish() must not revoke it again.
  login_token=''
  if [[ "$token_output" == *"bao-approle: revoke-self "* ]]; then
    fail 'OpenBao token revocation failed'
  fi
  result="$token_output"
  unset token_output
fi
