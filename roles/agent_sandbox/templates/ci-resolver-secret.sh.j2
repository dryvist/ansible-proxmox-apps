#!/usr/bin/env bash
set -euo pipefail

login_token=''
result=''
error='request failed'

fail() {
  error="$1"
  exit 1
}

revoke_login() {
  printf '{}' |
    curl --fail --silent --show-error \
      --header 'Content-Type: application/json' \
      --header @<(printf 'X-Vault-Token: %s\n' "$login_token") \
      --data-binary @- "${BAO_ADDR%/}/v1/auth/token/revoke-self" \
      >/dev/null 2>/dev/null
}

finish() {
  local status=$?
  trap - EXIT
  if [[ -n "$login_token" ]]; then
    if ! revoke_login; then
      status=1
      error='OpenBao token revocation failed'
    fi
    login_token=''
  fi
  if ((status == 0)); then
    printf '%s\n' "$result"
  else
    printf 'ci-resolver-secret: %s\n' "$error" >&2
  fi
  exit "$status"
}
trap finish EXIT

# shellcheck source=/etc/agent-sandbox/agent-dispatch-profile.sh
if ! source /etc/agent-sandbox/agent-dispatch-profile.sh 2>/dev/null; then
  fail 'dispatcher profile could not be read'
fi
if [[ ! "${BAO_ADDR:-}" =~ ^https://[^[:space:]]+$ ]]; then
  fail 'OpenBao address is invalid'
fi

if [[ $# -ne 2 ]]; then
  fail 'expected token or field arguments'
fi

verb="$1"
value="$2"
repository=''
case "$verb" in
  token)
    if [[ ! "$value" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]]; then
      fail 'repository name is invalid'
    fi
    repository="${value#*/}"
    ;;
  field)
    if [[ ! "$value" =~ ^[A-Z][A-Z0-9_]{0,63}$ ]]; then
      fail 'field name is invalid'
    fi
    ;;
  *)
    fail 'unknown verb'
    ;;
esac

role_id=''
secret_id=''
if ! role_id=$(<{{ agent_sandbox_ci_resolver_approle_dir }}/role_id); then
  fail 'AppRole role ID could not be read'
fi
if ! secret_id=$(<{{ agent_sandbox_ci_resolver_approle_dir }}/secret_id); then
  fail 'AppRole secret ID could not be read'
fi
if [[ -z "$role_id" || -z "$secret_id" ]]; then
  fail 'AppRole credentials are empty'
fi

login_response=$(
  printf '%s\0%s' "$role_id" "$secret_id" |
    python3 -c 'import json,sys; role_id,secret_id=sys.stdin.buffer.read().split(b"\0",1); print(json.dumps({"role_id":role_id.decode(),"secret_id":secret_id.decode()}))' 2>/dev/null |
    curl --fail --silent --show-error \
      --header 'Content-Type: application/json' \
      --data-binary @- "${BAO_ADDR%/}/v1/auth/approle/login" 2>/dev/null
) || fail 'OpenBao login failed'
unset role_id secret_id

login_token=$(jq -er '.auth.client_token | strings | select(length > 0)' <<<"$login_response" 2>/dev/null) || fail 'OpenBao login response was invalid'
unset login_response

secret_response=$(
  curl --fail --silent --show-error \
    --header @<(printf 'X-Vault-Token: %s\n' "$login_token") \
    "${BAO_ADDR%/}/v1/{{ agent_sandbox_ci_resolver_secret_path }}" 2>/dev/null
) || fail 'OpenBao secret read failed'

if [[ "$verb" == field ]]; then
  result=$(jq -er --arg key "$value" '.data.data[$key] | strings | select(length > 0)' <<<"$secret_response" 2>/dev/null) || fail 'requested field is unavailable'
else
  installation_id=$(jq -er '.data.data.GITHUB_AGENTS_INSTALLATION_ID | select(. != null) | tostring | select(length > 0)' <<<"$secret_response" 2>/dev/null) || fail 'GitHub installation ID is unavailable'
  token_response=$(
    printf '%s\0%s' "$installation_id" "$repository" |
      python3 -c 'import json,sys; installation_id,repository=sys.stdin.buffer.read().split(b"\0",1); print(json.dumps({"installation_id":installation_id.decode(),"repositories":repository.decode(),"permissions":{"checks":"write","actions":"write","contents":"write","pull_requests":"write"}}))' 2>/dev/null |
      curl --fail --silent --show-error \
        --header 'Content-Type: application/json' \
        --header @<(printf 'X-Vault-Token: %s\n' "$login_token") \
        --data-binary @- "${BAO_ADDR%/}/v1/{{ agent_sandbox_ci_resolver_github_mount }}/token" 2>/dev/null
  ) || fail 'GitHub installation token request failed'
  result=$(jq -er '.data.token | strings | select(length > 0)' <<<"$token_response" 2>/dev/null) || fail 'GitHub token response was invalid'
  unset installation_id token_response
fi
unset secret_response
