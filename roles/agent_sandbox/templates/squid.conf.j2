{{ ansible_managed | comment }}
# Egress gate for agent containers: default-deny CONNECT proxy. Not a cache.
# The allowlist mirrors nix-agent-sandbox lib.egressDomains and includes the
# router endpoint used by the dispatcher profiles.

http_port {{ agent_sandbox_proxy_port }}

# Denied task-tracker hosts. The rendered entries carry leading dots, Squid's
# "this domain and its subdomains" spelling, and the deny rule below precedes
# every allow rule: neither allowlist file can open them, and agent-allow
# refuses to add them to the operator list.
acl denied_dst dstdomain {{ agent_sandbox_denied_domains | map('regex_replace', '^', '.') | join(' ') }}
acl allowed_dst_static dstdomain "/etc/squid/allowed-domains.txt"
acl allowed_dst_operator dstdomain "/etc/agent-sandbox/allowed-domains.d/operator.txt"
acl SSL_ports port 443
acl CONNECT method CONNECT

# CONNECT only to 443; plain http only to the allowlist (nix substituters
# and package indexes are https, but redirects may bounce through http).
http_access deny CONNECT !SSL_ports
http_access deny denied_dst
http_access allow allowed_dst_static
http_access allow allowed_dst_operator
http_access deny all

cache deny all
# Logging stays on the image defaults (/var/log/squid, writable by the
# squid `proxy` user). stdio:/dev/stdout is fatal here: squid drops
# privileges and the proxy user cannot open the container's stdout.
