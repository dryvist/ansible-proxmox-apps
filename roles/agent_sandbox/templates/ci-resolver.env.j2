# {{ ansible_managed }}
CI_RESOLVER_APP_ID={{ agent_sandbox_ci_resolver_app_id }}
CI_RESOLVER_ORG={{ agent_sandbox_ci_resolver_org }}
CI_RESOLVER_REPOS={{ agent_sandbox_ci_resolver_repos | join(',') }}
CI_RESOLVER_GH_TOKEN_CMD={{ agent_sandbox_ci_resolver_secret_helper }} token
CI_RESOLVER_TOKEN_REPO={{ agent_sandbox_ci_resolver_token_repo }}
CI_RESOLVER_DISPATCH_CMD={{ agent_sandbox_dispatch_dispatcher }}
CI_RESOLVER_WORKBOOK_DIR={{ agent_sandbox_ci_resolver_workbook_dir }}
CI_RESOLVER_STATE_DIR={{ agent_sandbox_ci_resolver_state_dir }}
CI_RESOLVER_MAX_ATTEMPTS={{ agent_sandbox_ci_resolver_max_attempts | int }}
CI_RESOLVER_SHADOW={{ '1' if agent_sandbox_ci_resolver_shadow | bool else '0' }}
CI_RESOLVER_VIKUNJA_URL={{ agent_sandbox_ci_resolver_vikunja_url }}
CI_RESOLVER_VIKUNJA_PROJECT={{ agent_sandbox_ci_resolver_vikunja_project | int }}
CI_RESOLVER_VIKUNJA_TOKEN_CMD={{ agent_sandbox_ci_resolver_secret_helper }} field VIKUNJA_CI_RESOLVER_TOKEN
CI_RESOLVER_ZAMMAD_URL={{ agent_sandbox_ci_resolver_zammad_url }}
CI_RESOLVER_ZAMMAD_GROUP={{ agent_sandbox_ci_resolver_zammad_group | quote }}
CI_RESOLVER_ZAMMAD_TOKEN_CMD={{ agent_sandbox_ci_resolver_secret_helper }} field ZAMMAD_HTTP_TOKEN
