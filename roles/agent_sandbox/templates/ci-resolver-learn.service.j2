# {{ ansible_managed | comment }}
[Unit]
Description=Learn from completed CI resolver fixes

[Service]
Type=oneshot
User={{ agent_sandbox_dispatch_user }}
Group={{ agent_sandbox_dispatch_user }}
EnvironmentFile={{ agent_sandbox_ci_resolver_env_file }}
RuntimeDirectory=ci-resolver-learn
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/git clone --depth 1 https://github.com/dryvist/ai-llm-prompts.git /run/ci-resolver-learn/workbook
ExecStart=/usr/bin/python3 {{ agent_sandbox_ci_resolver_script }} learn --workbook-repo /run/ci-resolver-learn/workbook --publish dryvist/ai-llm-prompts
