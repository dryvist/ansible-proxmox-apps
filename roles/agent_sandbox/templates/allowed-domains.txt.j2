{{ ansible_managed | comment }}
{% set static_domains = agent_sandbox_egress_domains.values() | flatten %}
{% set extra_domains = agent_sandbox_extra_egress_domains | reject('in', static_domains) | unique | list %}
{% for group, domains in agent_sandbox_egress_domains.items() %}
# {{ group }}
{% for domain in domains %}
