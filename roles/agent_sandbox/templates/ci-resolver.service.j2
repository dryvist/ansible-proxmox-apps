# {{ ansible_managed | comment }}
[Unit]
Description=Reconcile failed CI runs with the host dispatcher
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User={{ agent_sandbox_dispatch_user }}
Group={{ agent_sandbox_dispatch_user }}
EnvironmentFile={{ agent_sandbox_ci_resolver_env_file }}
ExecStart=/usr/bin/python3 {{ agent_sandbox_ci_resolver_script }} tick --loop 30
Restart=always
RestartSec=30
StateDirectory=ci-resolver
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
