# {{ ansible_managed }}
[Unit]
Description=Agent sandbox container-egress filter (nftables)
# Loaded before the Docker daemon so the filter is in place before any
# container exists; it keys off interface names, so the bridges need not exist.
Before=docker.service
Wants=network-pre.target
Before=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ agent_sandbox_nft_file }}
ExecReload=/usr/sbin/nft -f {{ agent_sandbox_nft_file }}
# Removes only this table; every other rule on the host is left alone.
ExecStop=/usr/sbin/nft delete table inet {{ agent_sandbox_nft_table }}

[Install]
WantedBy=multi-user.target
