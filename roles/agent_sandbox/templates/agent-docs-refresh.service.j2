# {{ ansible_managed | comment }}
[Unit]
Description=Refresh the filtered public docs tree for agent containers
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=GIT_TERMINAL_PROMPT=0
ExecStartPre=/usr/bin/git -C {{ agent_sandbox_docs_source_path }} pull --ff-only
ExecStart=/usr/bin/rsync --archive --delete --delete-excluded --exclude=.git/ {% for path in agent_sandbox_docs_exclude_paths %}--exclude={{ path }} {% endfor %}{{ agent_sandbox_docs_source_path }}/ {{ agent_sandbox_docs_checkout_path }}/
TimeoutStartSec=10min
