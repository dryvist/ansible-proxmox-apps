---
# Syslog processing pipeline
# Generated by Ansible - cribl_edge_pipelines role - do not edit manually
#
# Stage order matters. Routing and field extraction run first so the reduction
# stages can filter on real fields instead of re-parsing _raw. Reduction runs
# last, immediately before egress, so nothing downstream of it has to know the
# reduction exists.

output: splunk_hec
streamtags: []
groups: {}
asyncFuncTimeout: 1000
functions:
  - id: eval
    filter: "true"
    disabled: false
    conf:
      add:
        # index/sourcetype conditionals are generated from the tofu
        # syslog_port_map (cribl_edge_syslog_routing) — routing truth lives
        # in terraform-proxmox constants, not here. The unifi family gets a
        # firewall/IPS split first: raw lines matching
        # cribl_edge_unifi_fw_match re-route to index=firewall
        # sourcetype=ubiquiti:firewall before the plain unifi branch.
        - name: index
          value: >-
            __inputId.includes('1516') ? 'firewall' :
            __inputId.includes('1522') ? 'dns' :
            __inputId.includes('1519') ? 'honeypot' :
            __inputId.includes('1517') ? 'os' :
            __inputId.includes('1521') ? 'os' :
            __inputId.includes('1515') ? 'firewall' :
            __inputId.includes('1523') ? 'proxy' :
            __inputId.includes('1514') && /\[[A-Z][A-Z0-9_.-]*-[ADR](-\d+)?\]|\bIN=\S* OUT=\S* MAC=|suricata/.test(_raw) ? 'firewall' :
            __inputId.includes('1514') ? 'unifi' :
            __inputId.includes('1520') ? 'firewall' :
            __inputId.includes('1518') ? 'os' :
            'main'
        - name: sourcetype
          value: >-
            __inputId.includes('1516') ? 'cisco:asa' :
            __inputId.includes('1522') ? 'technitium:dnsquery' :
            __inputId.includes('1519') ? 'honeypot:opencanary' :
            __inputId.includes('1517') ? 'syslog' :
            __inputId.includes('1521') ? 'syslog:macos' :
            __inputId.includes('1515') ? 'pan:firewall' :
            __inputId.includes('1523') ? 'haproxy' :
            __inputId.includes('1514') && /\[[A-Z][A-Z0-9_.-]*-[ADR](-\d+)?\]|\bIN=\S* OUT=\S* MAC=|suricata/.test(_raw) ? 'ubiquiti:firewall' :
            __inputId.includes('1514') ? 'ubiquiti:unifi' :
            __inputId.includes('1520') ? 'ubiquiti:firewall' :
            __inputId.includes('1518') ? 'syslog' :
            'syslog'
        - name: source
          value: "'syslog:' + ((__inputId.match(/\\d{4}/) || ['0000'])[0])"

  - id: regex_extract
    filter: "!__inputId.includes('ipfix')"
    disabled: false
    conf:
      source: _raw
      iterations: 100
      overwrite: false
      regex: /^<\d+>(?:\d+ )?(?:(?<timestamp>\w{3}\s+\d+\s+[\d:]+)|(?<timestamp_iso>\d{4}-\d{2}-\d{2}T[\d:.Z+-]+))\s+(?<log_host>\S+)\s+(?<process>[^\[:\s]+)(?:\[(?<pid>\d+)\])?[:\s]+(?<message>.*)/

  # The proxy family carries BOTH traefik and haproxy program routes on one
  # port (1523); refine the sourcetype
  # from the syslog-header program name (`process`, extracted above) AFTER
  # regex_extract has run. Unknown programs keep the family sourcetype.
  - id: eval
    filter: "__inputId.includes('1523') && process != null"
    disabled: false
    conf:
      add:
        - name: sourcetype
          value: >-
            process === 'traefik' ? 'traefik:syslog'
            : process === 'haproxy' ? 'haproxy:syslog'
            : sourcetype

  - id: eval
    filter: log_host != null
    disabled: false
    conf:
      add:
        - name: host
          value: log_host

  # --- Reduction stage 1 of 3: extract the fields reduction groups on -------
  #
  # Packet-filter records carry their rule identity, verdict, and 5-tuple in
  # the message body. Pull them out here so the rollup can group on the
  # identity that makes an event interesting, rather than on opaque text.
  # Firewall family only — nothing else has these fields.
  - id: regex_extract
    filter: "sourcetype === 'ubiquiti:firewall'"
    disabled: false
    conf:
      source: _raw
      iterations: 1
      overwrite: false
      regex: /\[(?<fw_rule>[A-Z][A-Z0-9_.-]*)-(?<fw_action>[ADR])(?:-\d+)?\]/
      regexList:
        - /\bPROTO=(?<fw_proto>\S+)/
        - /\bSRC=(?<fw_src>\S+)/
        - /\bDPT=(?<fw_dport>\d+)/

  # --- Reduction stage 2 of 3: suppress forwarder self-chatter -------------
  #
  # A log forwarder that cannot reach its destination re-reports the same
  # failure on every retry, forever. The key normalizes worker ids and action
  # indexes to digits-as-# so all copies of one failure mode collapse to one
  # key, then `allow` events per host per window pass through untouched.
  #
  # What this makes unanswerable: "exactly how many retries did this host
  # make". Nothing else — the failure, its host, its text, its start time and
  # its ongoing presence all survive at window resolution.
  - id: suppress
    filter: "sourcetype === 'syslog' && process === '{{ cribl_edge_pipelines_suppress_process }}'"
    disabled: false
    conf:
      keyExpr: "`${host}:${(message || '').replace(/\\d+/g, '#').slice(0, 60)}`"
      allow: {{ cribl_edge_pipelines_suppress_allow }}
      suppressPeriodSec: {{ cribl_edge_pipelines_suppress_period_sec }}
      dropEventsMode: true

  # --- Reduction stage 3 of 3: roll up service-discovery ALLOW beacons -----
  #
  # Stamp the rollup sourcetype BEFORE aggregating so it survives as a
  # groupby. Doing it here rather than in the aggregation's `add` keeps the
  # rollup identity in one place and out of the aggregation schema.
  - id: eval
    filter: >-
      sourcetype === 'ubiquiti:firewall' && fw_action === 'A' &&
      [{{ cribl_edge_pipelines_rollup_ports | join(', ') }}].includes(Number(fw_dport))
    disabled: false
    conf:
      add:
        - name: sourcetype
          value: "'{{ cribl_edge_pipelines_rollup_sourcetype }}'"

  # Collapse the stamped beacons into one counted event per identity per
  # window. Originals are dropped (passthrough defaults to false) — this is
  # the whole point, and it is safe ONLY because every field that makes one
  # beacon distinguishable from another is a groupby below.
  #
  # What this makes unanswerable: per-packet timing and per-packet byte
  # length for permitted discovery traffic, and the destination address of a
  # beacon (which is the well-known multicast group for its port).
  # Still answerable: which endpoint beaconed, on what port and protocol,
  # under which rule, how often, and when it started or stopped.
  #
  # DENY/REJECT is excluded by `fw_action === 'A'` in the stamp filter above,
  # so a blocked discovery attempt is never rolled up.
  - id: aggregation
    filter: "sourcetype === '{{ cribl_edge_pipelines_rollup_sourcetype }}'"
    disabled: false
    conf:
      timeWindow: "{{ cribl_edge_pipelines_rollup_window }}"
      aggregations:
        - "count().as(event_count)"
      groupbys:
        - index
        - sourcetype
        - source
        - host
        - fw_rule
        - fw_action
        - fw_proto
        - fw_src
        - fw_dport
      # Flush partial windows when an input closes so a restart or a source
      # disconnecting cannot strand counts that were never emitted.
      flushOnInputClose: true

  # Drop the grouping fields from raw firewall events that were NOT rolled up.
  # Rollup events keep them — there they are the entire payload.
  - id: eval
    filter: "sourcetype === 'ubiquiti:firewall'"
    disabled: false
    conf:
      remove:
        - fw_rule
        - fw_action
        - fw_proto
        - fw_src
        - fw_dport

  - id: eval
    filter: "true"
    disabled: false
    conf:
      remove:
        - log_host
        - timestamp_iso
