---
collector_name: zammad
metrics:
  - metric_name: zammad_open_tickets
    type: gauge
    help: Number of open tickets by group.
    key_labels: [group]
    values: [value]
    query: |
      SELECT COALESCE(g.name, 'none') AS "group", COUNT(*) AS value
      FROM tickets t
      LEFT JOIN groups g ON g.id = t.group_id
      JOIN ticket_states s ON s.id = t.state_id
      JOIN ticket_state_types st ON st.id = s.state_type_id
      WHERE lower(st.name) NOT IN ('closed', 'merged', 'removed')
      GROUP BY COALESCE(g.name, 'none')
  - metric_name: zammad_open_tickets_by_state
    type: gauge
    help: Number of open tickets by state.
    key_labels: [state]
    values: [value]
    query: |
      SELECT s.name AS state, COUNT(*) AS value
      FROM tickets t
      JOIN ticket_states s ON s.id = t.state_id
      JOIN ticket_state_types st ON st.id = s.state_type_id
      WHERE lower(st.name) NOT IN ('closed', 'merged', 'removed')
      GROUP BY s.name
  - metric_name: zammad_open_tickets_by_priority
    type: gauge
    help: Number of open tickets by priority.
    key_labels: [priority]
    values: [value]
    query: |
      SELECT p.name AS priority, COUNT(*) AS value
      FROM tickets t
      JOIN ticket_priorities p ON p.id = t.priority_id
      JOIN ticket_states s ON s.id = t.state_id
      JOIN ticket_state_types st ON st.id = s.state_type_id
      WHERE lower(st.name) NOT IN ('closed', 'merged', 'removed')
      GROUP BY p.name
  - metric_name: zammad_open_tickets_by_age
    type: gauge
    help: Number of open tickets by age bucket.
    key_labels: [age]
    values: [value]
    query: |
      SELECT CASE
        WHEN t.created_at >= now() - interval '1 day' THEN 'lt_1d'
        WHEN t.created_at >= now() - interval '7 days' THEN '1d_7d'
        WHEN t.created_at >= now() - interval '30 days' THEN '7d_30d'
        WHEN t.created_at >= now() - interval '90 days' THEN '30d_90d'
        ELSE 'gt_90d'
      END AS age, COUNT(*) AS value
      FROM tickets t
      JOIN ticket_states s ON s.id = t.state_id
      JOIN ticket_state_types st ON st.id = s.state_type_id
      WHERE lower(st.name) NOT IN ('closed', 'merged', 'removed')
      GROUP BY age
  - metric_name: zammad_tickets_created_24h
    type: gauge
    help: Number of tickets created in the last 24 hours.
    values: [value]
    query: |
      SELECT COUNT(*) AS value
      FROM tickets
      WHERE created_at >= now() - interval '24 hours'
  - metric_name: zammad_tickets_closed_24h
    type: gauge
    help: Number of tickets closed in the last 24 hours.
    values: [value]
    query: |
      SELECT COUNT(*) AS value
      FROM tickets
      WHERE close_at >= now() - interval '24 hours'
