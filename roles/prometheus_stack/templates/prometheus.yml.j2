## Managed by Ansible (prometheus_stack role) — do not edit by hand.
global:
  scrape_interval: {{ prometheus_stack_scrape_interval }}
  evaluation_interval: {{ prometheus_stack_scrape_interval }}

rule_files: ["/etc/prometheus/rules/*.yml"]

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ prometheus_stack_port }}"]

  ## blackbox active probes — multi-target: Prometheus passes the target via
  ## __param_target; the exporter runs the module. One job per module.
{% for job in prometheus_stack_blackbox_jobs %}
  - job_name: "blackbox_{{ job.module }}"
    metrics_path: /probe
    params:
      module: ["{{ job.module }}"]
    scrape_interval: {{ job.interval | default(prometheus_stack_scrape_interval) }}
    static_configs:
      - targets:
{% for t in job.targets %}
          - "{{ t }}"
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: "{{ prometheus_stack_blackbox_address }}"
{% endfor %}
{% set _media_constants = hostvars['localhost'].get('tofu_data', {}).get('constants', {}) %}
{% set _media_service_ports = _media_constants.get('service_ports', {}) %}
{% set _media_ports = _media_constants.get('media_ports', {}) %}
{% set _media_download_guests = groups['download_vpn_group'] | default([]) %}
{% set _media_guest_configs = guest_node_exporter_static_configs | default([]) %}
{% set _media_guest_targets = _media_guest_configs
  | selectattr('labels.guest', 'equalto', _media_download_guests | first | default(''))
  | map(attribute='targets') | first | default([]) %}
{% set _media_exporter_host = _media_guest_targets | first | default('') | regex_replace(':[0-9]+$', '') %}
{% if _media_download_guests | length > 0 and _media_exporter_host | length == 0 %}{{ _media_exporter_host_missing | mandatory('media_json needs a guest node_exporter target for the download guest') }}{% endif %}
{% set _media_exporter_address = _media_exporter_host ~ ':' ~ (_media_service_ports.get('media_json_exporter', 7979) | string) %}
{% set _media_json_targets = namespace(items=[]) %}
{% if _media_download_guests | length > 0 %}
{% set _ = _media_json_targets.items.append({'name': 'qbit_transfer', 'module': 'qbit_transfer', 'url': 'http://127.0.0.1:' ~ (_media_ports.get('qbittorrent_web', 8080) | string) ~ '/api/v2/transfer/info'}) %}
{% set _ = _media_json_targets.items.append({'name': 'qbit_torrents', 'module': 'qbit_torrents', 'url': 'http://127.0.0.1:' ~ (_media_ports.get('qbittorrent_web', 8080) | string) ~ '/api/v2/torrents/info'}) %}
{% set _ = _media_json_targets.items.append({'name': 'prowlarr_health', 'module': 'prowlarr_health', 'url': 'http://127.0.0.1:' ~ (_media_ports.get('prowlarr_web', 9696) | string) ~ '/api/v1/health'}) %}
{% endif %}
{% if groups['sonarr_group'] | default([]) | length > 0 %}
{% for name, path in [('sonarr_health', '/api/v3/health'), ('sonarr_queue', '/api/v3/queue?pageSize=1'), ('sonarr_library', '/api/v3/series')] %}
{% set _ = _media_json_targets.items.append({'name': name, 'module': name, 'url': 'http://media-sonarr:' ~ (_media_ports.get('sonarr_web', 8989) | string) ~ path}) %}
{% endfor %}
{% endif %}
{% if groups['radarr_group'] | default([]) | length > 0 %}
{% for name, path in [('radarr_health', '/api/v3/health'), ('radarr_queue', '/api/v3/queue?pageSize=1'), ('radarr_library', '/api/v3/movie')] %}
{% set _ = _media_json_targets.items.append({'name': name, 'module': name, 'url': 'http://media-radarr:' ~ (_media_ports.get('radarr_web', 7878) | string) ~ path}) %}
{% endfor %}
{% endif %}
{% if groups['plex_group'] | default([]) | length > 0 %}
{% for name, path in [('plex_sessions', '/status/sessions'), ('plex_recently_added', '/library/recentlyAdded?X-Plex-Container-Size=8')] %}
{% set _ = _media_json_targets.items.append({'name': name, 'module': name, 'url': 'http://media-plex:' ~ (_media_ports.get('plex_web', 32400) | string) ~ path}) %}
{% endfor %}
{% endif %}
{% if _media_json_targets.items | length > 0 and _media_exporter_host | length > 0 %}

  - job_name: media_json
    metrics_path: /probe
    scrape_interval: 60s
    scrape_timeout: 30s
    static_configs:
{% for target in _media_json_targets.items %}
      - targets: [{{ target.url | to_json }}]
        labels:
          module: {{ target.module | to_json }}
          media_target: {{ target.name | to_json }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [media_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ _media_exporter_address | to_json }}
      - action: labeldrop
        regex: "^(module|media_target)$"
{% endif %}
{% set _quota_exporters = namespace(items=[]) %}
{% for executor in prometheus_stack_json_exporter_executors %}
{% if prometheus_stack_json_exporter_credentials.get(executor.credential_name, '') | trim | length > 0 %}
{% set _ = _quota_exporters.items.append(executor) %}
{% endif %}
{% endfor %}
{% if _quota_exporters.items | length > 0 %}

  ## ZCode quota through the co-located json_exporter.
  - job_name: agent_quota
    metrics_path: /probe
    scrape_interval: 60s
    scrape_timeout: 30s
    static_configs:
{% for executor in _quota_exporters.items %}
      - targets: [{{ executor.url | to_json }}]
        labels:
          module: {{ executor.module | to_json }}
          executor: {{ executor.name | to_json }}
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [module]
        target_label: __param_module
      - source_labels: [executor]
        target_label: instance
      - target_label: __address__
        replacement: {{ prometheus_stack_json_exporter_address | trim | to_json }}
      - action: labeldrop
        regex: "^module$"
{% endif %}
{% if prometheus_stack_traefik_targets | length > 0 %}

  ## Traefik ingress — per-router/service/entryPoint RED metrics for every
  ## fronted service, scraped on Traefik's dedicated metrics entryPoint.
  - job_name: traefik
    static_configs:
      - targets:
{% for t in prometheus_stack_traefik_targets %}
          - "{{ t }}"
{% endfor %}
{% endif %}
{% if prometheus_stack_llm_router_targets | length > 0 and prometheus_stack_llm_router_bearer | trim | length > 0 %}

  ## LLM router — fallback-event counters and per-deployment request metrics.
  ## Authenticated: the router's /metrics is behind its own key auth, and the
  ## job renders only when the key is seeded (see the role defaults).
  - job_name: llm_router
    ## Trailing slash on purpose: the router answers /metrics with a 307 whose
    ## Location is /metrics/ rebuilt on the scheme it sees (http behind a TLS
    ## terminator). Scraping /metrics/ directly takes no redirect at all.
    metrics_path: /metrics/
    authorization:
      type: Bearer
      credentials: "{{ prometheus_stack_llm_router_bearer }}"
    static_configs:
      - targets:
{% for t in prometheus_stack_llm_router_targets %}
          - "{{ t }}"
{% endfor %}
{% endif %}
{% if prometheus_stack_clickhouse_targets | length > 0 %}

  ## ClickHouse built-in Prometheus metrics.
  - job_name: clickhouse
    metrics_path: /metrics
    static_configs:
      - targets:
{% for t in prometheus_stack_clickhouse_targets %}
          - "{{ t }}"
{% endfor %}
        labels:
          guest: clickhouse
{% endif %}
{% if prometheus_stack_hindsight_targets | length > 0 %}

  ## Hindsight agent-memory replicas — /metrics is unauthenticated (same port
  ## as the REST API; no separate metrics listener upstream), one target per
  ## replica so a stuck/lagging worker shows up on its own instance label.
  - job_name: hindsight
    static_configs:
      - targets:
{% for t in prometheus_stack_hindsight_targets %}
          - "{{ t }}"
{% endfor %}
{% endif %}
{% if prometheus_stack_agentgateway_targets | length > 0 %}

  ## agentgateway stats server — unauthenticated, internal-only Prometheus
  ## /metrics on its dedicated metrics port.
  - job_name: agentgateway
    static_configs:
      - targets:
{% for t in prometheus_stack_agentgateway_targets %}
          - "{{ t }}"
{% endfor %}
{% endif %}
{% if prometheus_stack_phoenix_targets | length > 0 %}

  ## Phoenix application metrics.
  - job_name: phoenix
    static_configs:
      - targets:
{% for t in prometheus_stack_phoenix_targets %}
          - "{{ t }}"
{% endfor %}
{% endif %}
{% if prometheus_stack_phoenix_postgres_exporter_targets | length > 0 %}

  ## Phoenix PostgreSQL exporter metrics.
  - job_name: phoenix_postgres
    static_configs:
      - targets:
{% for t in prometheus_stack_phoenix_postgres_exporter_targets %}
          - "{{ t }}"
{% endfor %}
{% endif %}
{% if prometheus_stack_extra_scrape_configs | trim | length > 0 %}
  ## appended jobs (smokeping_prober / irtt / snmp_exporter)
{{ prometheus_stack_extra_scrape_configs | indent(2, true) }}
{% endif %}
{% if prometheus_stack_remote_write_url | default('') | trim | length > 0 %}
{% if not prometheus_stack_direct_histogram_write_enabled | bool %}
## Every scrape job ships unfiltered — VictoriaMetrics is the superset
## store. Cribl's splunk_hec leg (prometheus_to_netmon pipeline) applies
## its own job allow-list to bound Splunk license volume; the
## victoriametrics_rw leg has no such filter.
{% else %}
## Selected LLM histogram and summary suffixes go directly to VictoriaMetrics.
## Cribl receives the remaining series for its existing destinations.
{% endif %}
remote_write:
  - url: "{{ prometheus_stack_remote_write_url }}"
    queue_config:
      capacity: 2500
      max_shards: 2
      max_samples_per_send: 1000
    # Native GPU metrics already fan out from Cribl Edge to Splunk and
    # VictoriaMetrics; exclude their Prometheus echo from this return path.
    write_relabel_configs:
      - source_labels: [__name__]
        regex: "node_gpu_.*"
        action: drop
{% if prometheus_stack_direct_histogram_write_enabled | bool %}
{% set histogram_selector = '(llm_gpu_engine|llm_router);.+_(bucket|count|sum)' %}
      # These LLM families have exactly one writer: the native endpoint below.
      - source_labels: [job, __name__]
        regex: "{{ histogram_selector }}"
        action: drop
  - url: "{{ prometheus_stack_direct_histogram_write_url }}"
    queue_config:
      capacity: 2500
      max_shards: 2
      max_samples_per_send: 1000
    write_relabel_configs:
      - source_labels: [job, __name__]
        regex: "{{ histogram_selector }}"
        action: keep
{% endif %}
{% endif %}
