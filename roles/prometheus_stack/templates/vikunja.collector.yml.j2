---
collector_name: vikunja
metrics:
  - metric_name: vikunja_open_tasks
    type: gauge
    help: Number of open tasks by project.
    key_labels: [project]
    values: [value]
    query: |
      SELECT COALESCE(p.title, 'none') AS project, COUNT(*) AS value
      FROM tasks t
      LEFT JOIN projects p ON p.id = t.project_id
      WHERE NOT t.done
      GROUP BY COALESCE(p.title, 'none')
  - metric_name: vikunja_open_tasks_by_label
    type: gauge
    help: Number of open tasks by label.
    key_labels: [label]
    values: [value]
    query: |
      SELECT COALESCE(l.title, 'none') AS label, COUNT(DISTINCT t.id) AS value
      FROM tasks t
      LEFT JOIN label_tasks lt ON lt.task_id = t.id
      LEFT JOIN labels l ON l.id = lt.label_id
      WHERE NOT t.done
      GROUP BY COALESCE(l.title, 'none')
  - metric_name: vikunja_open_tasks_by_epic
    type: gauge
    help: >-
      Number of open tasks by parent task (epic), from parenttask relations.
      Tasks without a parent count under epic "none".
    key_labels: [epic_id, epic]
    values: [value]
    query: |
      SELECT COALESCE(p.id::text, 'none') AS epic_id,
             COALESCE(p.title, 'none') AS epic,
             COUNT(DISTINCT t.id) AS value
      FROM tasks t
      LEFT JOIN task_relations r
        ON r.task_id = t.id AND r.relation_kind = 'parenttask'
      LEFT JOIN tasks p ON p.id = r.other_task_id
      WHERE NOT t.done
      GROUP BY COALESCE(p.id::text, 'none'), COALESCE(p.title, 'none')
  - metric_name: vikunja_open_tasks_by_priority
    type: gauge
    help: Number of open tasks by priority.
    key_labels: [priority]
    values: [value]
    query: |
      SELECT t.priority::text AS priority, COUNT(*) AS value
      FROM tasks t
      WHERE NOT t.done
      GROUP BY t.priority
  - metric_name: vikunja_open_tasks_by_age
    type: gauge
    help: Number of open tasks by age bucket.
    key_labels: [age]
    values: [value]
    query: |
      SELECT CASE
        WHEN t.created >= now() - interval '1 day' THEN 'lt_1d'
        WHEN t.created >= now() - interval '7 days' THEN '1d_7d'
        WHEN t.created >= now() - interval '30 days' THEN '7d_30d'
        WHEN t.created >= now() - interval '90 days' THEN '30d_90d'
        ELSE 'gt_90d'
      END AS age, COUNT(*) AS value
      FROM tasks t
      WHERE NOT t.done
      GROUP BY age
  - metric_name: vikunja_tasks_created_24h
    type: gauge
    help: Number of tasks created in the last 24 hours.
    values: [value]
    query: |
      SELECT COUNT(*) AS value
      FROM tasks
      WHERE created >= now() - interval '24 hours'
  - metric_name: vikunja_tasks_done_24h
    type: gauge
    help: Number of tasks completed in the last 24 hours.
    values: [value]
    query: |
      SELECT COUNT(*) AS value
      FROM tasks
      WHERE done AND done_at >= now() - interval '24 hours'
