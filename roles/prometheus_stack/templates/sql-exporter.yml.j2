---
collector_files:
  - "{{ prometheus_stack_sql_exporter_collectors_container_path }}/*.collector.yml"

jobs:
  - job_name: vikunja
    collectors: [vikunja]
    static_configs:
      - targets:
          vikunja: >-
            postgres://tracker_metrics_vikunja:{{ prometheus_stack_sql_exporter_vikunja_password | urlencode | replace('/', '%2F') }}@{{ prometheus_stack_sql_exporter_db_host | trim }}:{{ prometheus_stack_sql_exporter_db_port | trim }}/{{ prometheus_stack_sql_exporter_vikunja_db_name | urlencode }}
  - job_name: zammad
    collectors: [zammad]
    static_configs:
      - targets:
          zammad: >-
            postgres://tracker_metrics_zammad:{{ prometheus_stack_sql_exporter_zammad_password | urlencode | replace('/', '%2F') }}@{{ prometheus_stack_sql_exporter_db_host | trim }}:{{ prometheus_stack_sql_exporter_db_port | trim }}/{{ prometheus_stack_sql_exporter_zammad_db_name | urlencode }}
