            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Uncertain retry": {
      "main": [
        [
          {
            "node": "Find prior Slack delivery",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Post Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "none",
    "saveDataSuccessExecution": "none",
    "executionTimeout": 100
  },
  "pinData": {}
}
