{{ ansible_managed | comment }}
# Read by the package's own shipped systemd unit
# (/usr/lib/systemd/system/github-exporter.service,
# EnvironmentFile=-/etc/default/github-exporter). The GitHub token is NOT
# here — it lives in {{ github_exporter_token_env_file }}, rendered by the
# OpenBao Agent (openbao-agent.hcl.j2), which the same unit also reads as a
# second EnvironmentFile.
GITHUB_EXPORTER_WEB_ADDRESS={{ github_exporter_web_address }}
GITHUB_EXPORTER_ORG={{ github_exporter_org }}
GITHUB_EXPORTER_DATABASE_DSN={{ github_exporter_database_dsn }}
GITHUB_EXPORTER_COLLECTOR_WORKFLOW_RUNS={{ github_exporter_collector_workflow_runs | lower }}
GITHUB_EXPORTER_COLLECTOR_WORKFLOW_JOBS={{ github_exporter_collector_workflow_jobs | lower }}
GITHUB_EXPORTER_COLLECTOR_RUNNERS={{ github_exporter_collector_runners | lower }}
GITHUB_EXPORTER_COLLECTOR_ORGS={{ github_exporter_collector_orgs | lower }}
GITHUB_EXPORTER_COLLECTOR_REPOS={{ github_exporter_collector_repos | lower }}
