{{ ansible_managed | comment }}
# OpenBao Agent for github-exporter. One instance, one AppRole session,
# mirroring roles/github_runner's openbao-agent.hcl.j2: a login spends a
# secret_id use while minting from an authenticated session spends none, so
# the agent logs in once, renews its own token, and mints as often as the
# template needs.
exit_after_auth = false

vault {
  address = "{{ github_exporter_bao_addr }}"
}

auto_auth {
  method "approle" {
    config = {
      role_id_file_path   = "{{ github_exporter_approle_dir }}/role_id"
      secret_id_file_path = "{{ github_exporter_approle_dir }}/secret_id"
      # The secret_id is re-delivered by Ansible on every converge, so the
      # agent must not consume the file it will need again after a restart.
      remove_secret_id_file_after_reading = false
    }
  }
}

# A GET here mints a token: the plugin registers ReadOperation against the
# same callback as CreateOperation. The github-exporter policy grants `read`
# for exactly this reason — the template engine issues a GET, and without
# that capability this renders a 403 rather than a token.
#
# error_on_missing_key keeps a malformed response loud rather than silently
# writing an empty token. `command` restarts the exporter on every render
# (initial start and every hourly re-mint alike) — an installation token
# outlives its usefulness in about an hour, and only a restart makes the
# process pick up the new value; this is the agent's own native
# post-template hook, not a separate script.
{% raw %}
template {
  contents             = "GITHUB_EXPORTER_TOKEN={{ with secret \"{% endraw %}{{ github_exporter_token_path }}{% raw %}\" }}{{ .Data.token }}{{ end }}\n"
{% endraw %}
  destination          = "{{ github_exporter_token_env_file }}"
  perms                = "0600"
  error_on_missing_key = true
  command              = "systemctl restart github-exporter"
}
