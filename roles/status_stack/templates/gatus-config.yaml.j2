{{ ansible_managed | comment }}
# Gatus — estate catalog uptime probes + OIDC client registration probes.
# Interval is {{ status_stack_interval }} for every endpoint.
#
# Catalog URLs follow redirects. Authelia OAuth error pages (invalid_client)
# fail the body conditions even when HTTP status is 200/302. Gateway timeouts
# (504) fail the status condition.

metrics: true
storage:
  type: memory

ui:
  dashboard-heading: "{{ status_stack_ui_dashboard_heading }}"
  default-sort-by: group

# ntfy alerting — critical-infra groups (keystone/node/service) route to the
# urgent topic; everything else (catalog/oidc/guest) uses the lower-priority
# topic. Gatus fires the same alert for a status failure and a slow-response
# failure (there is no separate "degraded" alert channel), so the down-vs-
# degraded split from the package brief is implemented as a criticality split
# by endpoint group instead.
alerting:
  ntfy:
    url: "{{ status_stack_ntfy_url }}"
    topic: "{{ status_stack_ntfy_topic_degraded }}"
    priority: {{ status_stack_ntfy_priority_degraded }}
    default-alert:
      failure-threshold: {{ status_stack_failure_threshold }}
      send-on-resolved: true
    overrides:
{% for grp in ['keystone', 'node', 'service', 'deadman'] %}
      - group: "{{ grp }}"
        topic: "{{ status_stack_ntfy_topic_urgent }}"
        priority: {{ status_stack_ntfy_priority_urgent }}
{% endfor %}

# The full catalog, not the board-tiled subset: a route marked dashboard:false
# (a compat path already tiled under a sibling name) still gets monitored — a
# broken compat redirect is still a real outage even though it earns no tile
# of its own.
endpoints:
{% for svc in dashboard_catalog_services_monitor | default([]) %}
{#- An SSO-gated public URL is answered by the Authelia login page, so probing
    it only proves Authelia is up. Those rows probe the guest directly
    (the catalog's probe_url); public rows keep the public URL and its
    certificate check. -#}
{% set _direct = (svc.sso | default(true)) and (svc.probe_url | default('') | length > 0) %}
  - name: {{ svc.name }}
    group: "{{ dashboard_catalog_group_titles[svc.group | default('other')] | default(svc.group | default('other'), true) }} · {{ 'UI' if (svc.ui | default(true)) else 'API' }}"
    url: "{{ svc.probe_url if _direct else svc.url }}"
    interval: {{ status_stack_interval }}
    client:
      timeout: 15s
      ignore-redirect: false
    conditions:
{% if svc.name in status_stack_catalog_status_overrides %}
      - "[STATUS] == any({{ status_stack_catalog_status_overrides[svc.name] | join(', ') }})"
{% else %}
      - "[STATUS] < 500"
      - "[STATUS] != 504"
{% for pat in status_stack_authelia_error_patterns %}
      - "[BODY] != pat(*{{ pat }}*)"
{% endfor %}
{% endif %}
      - "[RESPONSE_TIME] < 3000"
{% if not _direct %}
      - "[CERTIFICATE_EXPIRATION] > 240h"
{% endif %}
    alerts:
      - type: ntfy
{% endfor %}
{% for ep in status_stack_authenticated_endpoints | default([]) %}
  - name: {{ ep.name }}-authed
    group: "Catalog · Authenticated"
    url: "{{ ep.url }}"
    interval: {{ status_stack_interval }}
    headers:
{% for hk, hv in (ep.headers | default({})).items() %}
      {{ hk }}: "{{ hv }}"
{% endfor %}
    client:
      timeout: 15s
      ignore-redirect: false
    conditions:
      - "[STATUS] < 400"
    alerts:
      - type: ntfy
{% endfor %}
{% for ks in status_stack_kuma_keystones | default([]) %}
  - name: keystone-{{ ks.name | regex_replace('[^A-Za-z0-9._-]', '-') }}
    group: keystone
    url: "{{ ks.url }}"
    interval: {{ status_stack_interval }}
    client:
      timeout: 15s
      ignore-redirect: false
    conditions:
      - "[STATUS] < 500"
      - "[STATUS] != 504"
{% for pat in status_stack_authelia_error_patterns %}
      - "[BODY] != pat(*{{ pat }}*)"
{% endfor %}
    alerts:
      - type: ntfy
{% endfor %}
{% for oidc in status_stack_oidc_clients | default([]) %}
  - name: oidc-{{ oidc.name }}
    group: oidc-clients
    url: >-
      {{ status_stack_authelia_public_url }}/api/oidc/authorization?response_type=code&scope=openid&client_id={{ oidc.client_id | urlencode }}&redirect_uri={{ oidc.redirect_uri | urlencode }}
    interval: {{ status_stack_interval }}
    client:
      timeout: 15s
      ignore-redirect: false
    conditions:
      - "[STATUS] < 500"
{% for pat in status_stack_authelia_error_patterns %}
      - "[BODY] != pat(*{{ pat }}*)"
{% endfor %}
    alerts:
      - type: ntfy
{% endfor %}

# --- monitor_targets — ICMP/TCP/HTTP endpoints derived from tofu inventory
# (inventory/load_tofu/monitor_targets.yml). Same fact the AutoKuma sidecar
# renders its static monitors from.
{% for t in status_stack_monitor_targets.icmp %}
  - name: icmp-{{ t.name }}
    group: {{ t.group }}
    url: "icmp://{{ t.fqdn }}"
    interval: {{ status_stack_interval }}
    conditions:
      - "[CONNECTED] == true"
    alerts:
      - type: ntfy
{% endfor %}
{% for t in status_stack_monitor_targets.tcp %}
  - name: tcp-{{ t.name }}
    group: {{ t.group }}
    url: "tcp://{{ t.fqdn }}:{{ t.port }}"
    interval: {{ status_stack_interval }}
    conditions:
      - "[CONNECTED] == true"
    alerts:
      - type: ntfy
{% endfor %}
{% for t in status_stack_monitor_targets.http %}
  - name: http-{{ t.name }}
    group: {{ t.group }}
    url: "http://{{ t.fqdn }}:{{ t.port }}{{ t.path }}"
    interval: {{ status_stack_interval }}
    client:
      timeout: 15s
      ignore-redirect: false
    conditions:
      - "[STATUS] == any({{ t.expect_status | join(', ') }})"
    alerts:
      - type: ntfy
{% endfor %}

# Deadman receivers: pushers report success/failure every cycle; silence past
# the heartbeat interval is a failure. One missed heartbeat alerts (the
# heartbeat already is the tolerance), on the urgent topic via the group
# override above.
external-endpoints:
{% for ep in status_stack_deadman_endpoints %}
  - name: {{ ep.name }}
    group: deadman
    token: "{{ status_stack_deadman_token }}"
    heartbeat:
      interval: {{ ep.heartbeat }}
    alerts:
      - type: ntfy
        failure-threshold: 1
        success-threshold: 1
{% endfor %}
