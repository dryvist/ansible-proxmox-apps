## Managed by Ansible (status_stack role) — do not edit by hand.
## Gatus (catalog + OIDC synthetics) + Uptime Kuma (operator status UI).
## Host networking so Traefik reaches both ports and Gatus can probe across VLANs.
services:
  gatus:
    image: {{ status_stack_gatus_image }}
    container_name: {{ status_stack_gatus_container_name }}
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ status_stack_data_dir }}/gatus/config.yaml:/config/config.yaml:ro
    environment:
      GATUS_CONFIG_PATH: /config/config.yaml

  uptime-kuma:
    image: {{ status_stack_kuma_image }}
    container_name: {{ status_stack_kuma_container_name }}
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ status_stack_data_dir }}/uptime-kuma:/app/data
    environment:
      UPTIME_KUMA_PORT: "{{ status_stack_kuma_port | trim }}"

  # Syncs Uptime Kuma monitors from status_stack_monitor_targets via
  # AutoKuma's own socket.io client — Ansible never talks to the Kuma API.
  autokuma:
    image: {{ status_stack_autokuma_image }}
    container_name: {{ status_stack_autokuma_container_name }}
    restart: unless-stopped
    network_mode: host
    depends_on:
      - uptime-kuma
    volumes:
      - {{ status_stack_autokuma_static_monitors_dir }}:/data/static-monitors:ro
    environment:
      AUTOKUMA__KUMA__URL: "{{ status_stack_autokuma_kuma_url }}"
      AUTOKUMA__KUMA__USERNAME: "{{ status_stack_kuma_admin_username }}"
      AUTOKUMA__KUMA__PASSWORD: "{{ status_stack_effective_kuma_password }}"
      AUTOKUMA__STATIC_MONITORS: /data/static-monitors
      AUTOKUMA__DOCKER__ENABLED: "false"
