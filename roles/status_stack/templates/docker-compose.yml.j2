## Managed by Ansible (status_stack role) — do not edit by hand.
## Gatus (catalog + OIDC synthetics) + Uptime Kuma (keystone status page).
## Host networking so Traefik reaches both ports and Gatus can probe across VLANs.
services:
  gatus:
    image: {{ status_stack_gatus_image }}
    container_name: {{ status_stack_gatus_container_name }}
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ status_stack_data_dir }}/gatus/config.yaml:/config/config.yaml:ro
    environment:
      GATUS_CONFIG_PATH: /config/config.yaml

  uptime-kuma:
    image: {{ status_stack_kuma_image }}
    container_name: {{ status_stack_kuma_container_name }}
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ status_stack_data_dir }}/uptime-kuma:/app/data
    environment:
      UPTIME_KUMA_PORT: "{{ status_stack_kuma_port | trim }}"
