{{ ansible_managed | comment }}
[Unit]
Description=OpenBao Agent for Git mirror token minting
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User={{ git_mirror_user }}
Group={{ git_mirror_group }}
RuntimeDirectory=git-mirror
RuntimeDirectoryMode=0750
ExecStart={{ git_mirror_bao_bin }} agent -config={{ git_mirror_config_dir }}/openbao-agent.hcl
Restart=always
RestartSec=10s

[Install]
WantedBy=multi-user.target
