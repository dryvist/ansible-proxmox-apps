{{ ansible_managed | comment }}
exit_after_auth = false

vault {
  address = "{{ git_mirror_bao_addr }}"
}

auto_auth {
  method "approle" {
    config = {
      role_id_file_path   = "{{ git_mirror_approle_dir }}/role_id"
      secret_id_file_path = "{{ git_mirror_approle_dir }}/secret_id"
      remove_secret_id_file_after_reading = false
    }
  }
  sink "file" {
    config = {
      path = "{{ git_mirror_bao_token_file }}"
      mode = "0600"
    }
  }
}
