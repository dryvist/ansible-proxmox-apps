{{ ansible_managed | comment }}
[Unit]
Description=Refresh read-only Git mirrors
After=network-online.target openbao-git-mirror-agent.service
Wants=network-online.target
Requires=openbao-git-mirror-agent.service

[Service]
Type=oneshot
User={{ git_mirror_user }}
Group={{ git_mirror_group }}
UMask=0027
Environment=BAO_ADDR={{ git_mirror_bao_addr }}
Environment=BAO_TOKEN_FILE={{ git_mirror_bao_token_file }}
Environment=GIT_MIRROR_ROOT={{ git_mirror_root }}
Environment=GIT_MIRROR_METRICS_FILE={{ git_mirror_metrics_file }}
Environment=GIT_MIRROR_LAST_SUCCESS_FILE={{ git_mirror_last_success_file }}
ExecStart=/usr/local/libexec/git-mirror-sync
TimeoutStartSec=1h
