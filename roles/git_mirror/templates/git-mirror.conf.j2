{{ ansible_managed | comment }}
ServerName localhost

<VirtualHost {{ git_mirror_httpd_bind_address }}:{{ git_mirror_public_port }}>
    SetEnv GIT_PROJECT_ROOT {{ git_mirror_root }}/public
    SetEnv GIT_HTTP_EXPORT_ALL
    ScriptAlias {{ git_mirror_public_path }}/ /usr/lib/git-core/git-http-backend/

    <Directory /usr/lib/git-core>
        Options +ExecCGI
        Require all granted
    </Directory>

    <Directory {{ git_mirror_root }}/public>
        Options -Indexes +FollowSymLinks
        Require all granted
    </Directory>
</VirtualHost>

<VirtualHost {{ git_mirror_httpd_bind_address }}:{{ git_mirror_all_port }}>
    SetEnv GIT_PROJECT_ROOT {{ git_mirror_root }}/all
    SetEnv GIT_HTTP_EXPORT_ALL
    ScriptAlias {{ git_mirror_all_path }}/ /usr/lib/git-core/git-http-backend/

    <Directory /usr/lib/git-core>
        Options +ExecCGI
        Require all granted
    </Directory>

    <LocationMatch "^{{ git_mirror_all_path }}(/|$)">
        AuthType Basic
        AuthName "Git mirror"
        AuthBasicProvider file
        AuthUserFile {{ git_mirror_config_dir }}/all.htpasswd
        Require valid-user
    </LocationMatch>

    <Directory {{ git_mirror_root }}/all>
        Options -Indexes +FollowSymLinks
        Require all granted
    </Directory>
</VirtualHost>
