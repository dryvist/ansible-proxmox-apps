{{ ansible_managed | comment }}
[Unit]
Description=Homepage (gethomepage) service dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ homepage_user }}
Group={{ homepage_user }}
WorkingDirectory={{ homepage_install_dir }}
Environment=NODE_ENV=production
Environment=HOMEPAGE_CONFIG_DIR={{ homepage_config_dir }}
Environment=PORT={{ homepage_port }}
Environment=HOSTNAME={{ homepage_host }}
# Homepage refuses requests whose Host header it does not recognise; the board
# is only ever reached through the Traefik vhost.
Environment=HOMEPAGE_ALLOWED_HOSTS=homepage.{{ dashboard_catalog_base_domain }}
# The pinned Node comes first on PATH — the distro package is no longer
# installed, and the build output was produced against this runtime.
Environment=PATH={{ homepage_node_prefix }}/bin:{{ homepage_bun_install_root }}/bin:/usr/bin:/bin
# pnpm, not npm: upstream's `only-allow pnpm` preinstall governs the build, and
# the runtime script should resolve through the same package manager rather
# than a second one that is no longer installed.
ExecStart={{ homepage_bun_install_root }}/bin/pnpm run start
Restart=always
RestartSec=5s

[Install]
WantedBy=multi-user.target
