{{ ansible_managed | comment }}
# Rendered from the shared catalog (roles/dashboard_catalog_services), built in
# turn from the tofu-owned ingress table. Do not hand-edit: a service belongs
# here by having a Traefik route, and an edit is lost on the next converge.
#
# Every href is the clean portless HTTPS URL, so each click passes through
# Traefik and its Authelia gate.
#
# UI groups render first, API/machine groups after (settings.yaml.j2 mirrors
# this exact group list and order, since display order there is layout key
# order, not alphabetical). A VLAN group with services on both sides renders
# twice — once per side — so the API half is suffixed "(API)" rather than
# reusing the bare group name twice.
{% macro audience_groups(services, suffix) %}
{% set _ordered = dashboard_catalog_group_order
     + (services | map(attribute='group') | unique | reject('in', dashboard_catalog_group_order) | sort | list) %}
{% for group in _ordered if services | selectattr('group', 'equalto', group) | list | length > 0 %}
- "{{ group }}{{ suffix }}":
{% for svc in services if svc.group == group %}
    - {{ svc.title }}:
        href: {{ svc.url }}
{% if homepage_site_monitor_enabled | bool and svc.probe_url | length > 0 %}
        # The GUEST address, never the public URL: this check is an
        # unauthenticated HEAD, which the SSO gate answers with a login page —
        # every service would read as down while the converge stayed green.
        siteMonitor: {{ svc.probe_url }}
        interval: {{ homepage_site_monitor_interval | default(60) }}
{% endif %}
{% endfor %}
{% endfor %}
{% endmacro %}
{% set _ui = dashboard_catalog_services | selectattr('ui') | list %}
{% set _api = dashboard_catalog_services | rejectattr('ui') | list %}
{{ audience_groups(_ui, '') }}
{{ audience_groups(_api, ' (API)') }}
