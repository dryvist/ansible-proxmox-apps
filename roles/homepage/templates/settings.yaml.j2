{{ ansible_managed | comment }}
title: {{ homepage_title }}
theme: dark
color: slate
# Open in a new tab: this board is a launcher, and replacing it with the target
# means using browser history to get back to it.
target: _blank
headerStyle: clean
layout:
{% set _ordered = dashboard_catalog_group_order
     + (dashboard_catalog_services | map(attribute='group') | unique | reject('in', dashboard_catalog_group_order) | sort | list) %}
{% for group in _ordered if dashboard_catalog_services | selectattr('group', 'equalto', group) | list | length > 0 %}
  {{ group }}:
    style: row
    columns: 4
{% endfor %}
