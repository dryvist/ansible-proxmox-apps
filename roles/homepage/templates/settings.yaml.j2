{{ ansible_managed | comment }}
title: {{ homepage_title }}
theme: dark
color: slate
# Open in a new tab: this board is a launcher, and replacing it with the target
# means using browser history to get back to it.
target: _blank
headerStyle: clean
layout:
{# Display order is layout KEY order, not alphabetical — every UI group
   first, then every API group, mirroring services.yaml.j2's own two-pass
   macro exactly (same group list, same "(API)" suffix) so the two files can
   never drift out of sync with each other. #}
{% macro audience_layout(services, suffix) %}
{% set _ordered = dashboard_catalog_group_order
     + (services | map(attribute='group') | unique | reject('in', dashboard_catalog_group_order) | sort | list) %}
{% for group in _ordered if services | selectattr('group', 'equalto', group) | list | length > 0 %}
  "{{ group }}{{ suffix }}":
    style: row
    columns: 4
{% endfor %}
{% endmacro %}
{% set _ui = dashboard_catalog_services | selectattr('ui') | list %}
{% set _api = dashboard_catalog_services | rejectattr('ui') | list %}
{{ audience_layout(_ui, '') }}
{{ audience_layout(_api, ' (API)') }}
