diff --git a/.github/workflows/post-merge.yml b/.github/workflows/post-merge.yml
new file mode 100644
index 00000000..8bca7191
--- /dev/null
+++ b/.github/workflows/post-merge.yml
@@ -0,0 +1,27 @@
+---
+# Post-merge settlement for the merge queue. The gate (ci-gate.yml) and this
+# workflow are one merge-flow pair: pushes to develop run the shared
+# _post-merge workflow, which fast-forwards the green ref across commits
+# whose heavy checks the gate's fast lanes deferred, and reverts deferred
+# pull requests that went red after merge.
+
+name: Post Merge
+
+on:
+  push:
+    branches: [develop]
+
+jobs:
+  post-merge:
+    permissions:
+      contents: write    # green ref moves, post-merge-red dispatches
+      pull-requests: write
+      checks: read       # AI Merge Gate verdicts on the head commits
+      actions: read      # the gate's run report reads this run's jobs
+    uses: JacobPEvans/.github/.github/workflows/_post-merge.yml@v1
+    with:
+      # This repository's gate stack, forwarded verbatim.
+      profile: ansible
+    secrets:
+      GH_APP_PRIVATE_KEY: ${{ secrets.GH_APP_PRIVATE_KEY }}
+      slack_webhook_url: ${{ secrets.SLACK_WEBHOOK_URL }}
