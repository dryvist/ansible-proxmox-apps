new file mode 100644
index 00000000..e24bebce
--- /dev/null
+++ b/.github/workflows/post-merge.yml
@@ -0,0 +1,23 @@
+---
+# Settles deferred checks and moves the green pointer after each merge to develop.
+name: Post Merge
+
+on:
+  push:
+    branches: [develop]
+
+permissions: {}
+
+jobs:
+  post-merge:
+    permissions:
+      contents: write
+      pull-requests: write
+      checks: read
+      actions: read
+    uses: JacobPEvans/.github/.github/workflows/_post-merge.yml@v1
+    with:
+      profile: ansible
+    secrets:
+      GH_APP_PRIVATE_KEY: ${{ secrets.GH_APP_PRIVATE_KEY }}
+      slack_webhook_url: ${{ secrets.SLACK_WEBHOOK_URL }}
