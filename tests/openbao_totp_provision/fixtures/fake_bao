#!/usr/bin/env bash
# Minimal stub of the `bao` CLI for verify_provision_uicheck_totp.yml.
# State lives in $TOTP_STATE_FILE as shell-sourceable KEY=VALUE lines, shared
# with fixtures/fake_authelia so both sides of one test case agree on what
# has and has not been seeded yet.
set -euo pipefail

state_file="${TOTP_STATE_FILE:?TOTP_STATE_FILE must be set}"
# shellcheck disable=SC1090
[ -f "$state_file" ] && source "$state_file"
engine_enabled="${engine_enabled:-false}"
key_exists="${key_exists:-false}"

case "$1 $2" in
  "secrets list")
    if [ "$engine_enabled" = "true" ]; then
      echo '{"totp/": {"type": "totp"}}'
    else
      echo '{}'
    fi
    ;;
  "secrets enable")
    echo "engine_enabled=true" >> "$state_file"
    ;;
  "read -format=json")
    if [ "$key_exists" = "true" ]; then
      echo '{"data": {"algorithm": "SHA1"}}'
    else
      echo "No value found at totp/keys/svc-uicheck" >&2
      exit 2
    fi
    ;;
  "write totp/keys/svc-uicheck")
    echo "key_exists=true" >> "$state_file"
    ;;
  *)
    echo "fake_bao: unhandled invocation: $*" >&2
    exit 1
    ;;
esac
